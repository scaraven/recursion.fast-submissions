-- ===== merged from `LvmQAsmArith2Claim` (GOLF module merge: `LvmQAsmArith2Claim.lean` is now a stub importing `LvmQAsmArith2`) =====
section
-- New for lvm (HAR-RC): the claims of phases 4 and 6 as cells (`CClaim`): the Keccak tables' word
-- and ring claims, `CH`'s output-lane openings and its boundary claims `in_0 = Pad43(s)`,
-- `Y(bits(n − 1)) = h` (BLUEPRINT §4.1, A1), and `KS`'s output-lane openings. Searched for reuse:
-- `LvmChainTable` (`pad43St`: a bit-level `Pad43`, not the lane form `F` claims), `LvmLayoutArith`
-- (`eOfNat_bit`, on the protocol's `E`; restated here on `Lvm.FE`), QL/QSig (`Out1`, `w64`, the
-- `BITS` output form), core `Nat.testBit_*`, `List.zipIdx_map`. The borrow chain and the lane
-- disjointness facts are new.

/-!
# Q_arith: the claims of phases 4 and 6

* `selC z o sel len`: the cells of `selectorPoint sel len` (`z`, `o` `E` cells holding `0`, `1`;
  `selC_vs`).
* `kClaimsC blk ko rg`: `keccakClaims blk ko ring` (word claim, ring claim) as cells
  (`kClaimsC_val`).
* **`chFixedG`** (`CH`'s fixed claims, `chFixedClaims`): the four `Y` openings at `r`; the 25
  boundary claims `in_0 = Pad43(s')` at row 0 (lanes 0–4 from the byte shifts `s'_l << 8`,
  `s'_l >> 56` of the child's `s'` lanes, `K` rows `x + y` / `x + k`, disjoint bits; the constant
  lanes `0`, `0x80 << 56`); the four claims `Y(bits(n' − 1)) = h'`, the point from the `BITS` bits
  of `n'` by a borrow chain (`borrow`: `d_j = b_j + c_j`, `c_{j+1} = c_j·b_j + c_j`, `c_0 = 1`;
  `borrow_vs`: `selectorPoint (n' − 1)`, `n' ≥ 1`). **`chClaims_val`**: with the stream bound
  (`Streamed`) and the `BITS` cells (`SBits`, `NBits`), the cells are
  `(keccakClaims m.chBlock ko ring ++ chFixedClaims p m.chBlock m.chYSlot r v pub).map (.main, ·)`
  for `pub = pubOf vk c Σ` and `m = M3.ofParts p …` (any bus/table parts).
* `ksOutC`: `m.ksOutputClaims rk vks` as cells (`ksOutC_val`); `KS`'s `keccakClaims` is
  `kClaimsC_val` (no rows).
-/

set_option autoImplicit false

namespace Lvm.Har

open Lvm Lvm.Loop Lvm.Loop.Build Lvm.Loop.QRing Lvm.Q1 Lvm.QSig Lvm.Bits

variable {c : Ctx} {M : Mem}

/-! ## Constant points -/

/-- The cells of `selectorPoint sel len` (`z`, `o`: `E` cells holding `0`, `1`). -/
def selC (z o sel len : Nat) : List Cell :=
  (List.range len).map fun b => if (sel >>> b) % 2 = 1 then ec o else ec z

theorem eOfNat_zero_fe : eOfNat 0 = 0 := rfl
theorem eOfNat_one_fe : eOfNat 1 = 1 := rfl

theorem selC_vs {z o : Nat} (hz : M.e z = 0) (ho : M.e o = 1) (sel len : Nat) :
    vs M (selC z o sel len) = selectorPoint sel len := by
  simp only [selC, vs, selectorPoint, List.map_map]
  refine List.map_congr_left fun b _ => ?_
  rcases Nat.mod_two_eq_zero_or_one (sel >>> b) with h | h
  · simp only [Function.comp_apply, h, if_neg (by decide : ¬ (0 = 1)), Cell.val_E, hz]
    try exact eOfNat_zero_fe.symm
  · simp only [Function.comp_apply, h, if_true, Cell.val_E, ho]
    try exact eOfNat_one_fe.symm

/-! ## The Keccak tables' claims -/

/-- `keccakClaims blk ko ring` as cells: the committed-output word claim and the ring claim. -/
def kClaimsC (blk : Placement) (ko : GkrOut) (rg : RingOut) : List CClaim :=
  [⟨.main, .point blk ko.wordPoint, ko.word⟩, ⟨.main, .ring blk ko.slicePoint rg.cs, rg.target⟩]

/-! ## `BITS` outputs -/

theorem bit_word (w : UInt64) {z : Nat} (hz : z < 64) :
    (BOut.bit z).word w = if w.toNat.testBit z then 1 else 0 := by
  simp only [BOut.word]
  apply UInt64.toNat_inj.mp
  rw [UInt64.toNat_and, UInt64.toNat_shiftRight]
  have hz' : z.toUInt64.toNat % 64 = z := by
    rw [Nat.toUInt64_eq, UInt64.toNat_ofNat']; omega
  rw [hz', show (1 : UInt64).toNat = 1 from rfl, Nat.and_one_is_mod]
  split_ifs with h <;> simp [Nat.testBit, Nat.shiftRight_eq_div_pow] at h ⊢ <;> omega

/-! ## The child's header lanes in the stream -/

/-- The stream lane of header byte `j` (`headerAt`). -/
def hdrLane (j : Nat) : Nat := headerAt j / 8

/-- The child's `s'` lane `l`, `n'`, `h'` lane `l` (stream lanes `20 + l`, `24`, `25 + l`). -/
def sLane (l : Nat) : Nat := hdrLane (80 + 8 * l)
def nLane : Nat := hdrLane 112
def hLane (l : Nat) : Nat := hdrLane (120 + 8 * l)

theorem sLane_eq (l : Nat) : sLane l = 20 + l := by simp only [sLane, hdrLane, headerAt]; omega
theorem nLane_eq : nLane = 24 := rfl
theorem hLane_eq (l : Nat) : hLane l = 25 + l := by simp only [hLane, hdrLane, headerAt]; omega

/-- **The bits of the child's `n'`** at `nb + j`, `j < n` (Q_sig's `bn + 2 + j`, `SigBits.n_bit`). -/
def NBits (v : Nat → FK) (nb n : Nat) : Prop := ∀ j < n, Out1 v nLane (.bit j) (nb + j)

theorem pub_s {sig : ByteArray} {T : Nat} (hS : Streamed M sig T) (hT : 29 ≤ T) (vk c' : Vector UInt8 32) :
    (pubOf vk c' sig).s = (List.range 4).map fun l => M.k (sLane l) := by
  simp only [pubOf]
  refine List.map_congr_left fun l hl => ?_
  have hl' := List.mem_range.mp hl
  rw [hS _ (by rw [sLane_eq]; (clear * - hT hl'; omega))]
  exact congrArg (kAt sig) (by simp only [sLane, hdrLane, headerAt]; (clear * - hl'; omega))

theorem pub_h {sig : ByteArray} {T : Nat} (hS : Streamed M sig T) (hT : 29 ≤ T) (vk c' : Vector UInt8 32) :
    (pubOf vk c' sig).h = (List.range 4).map fun l => M.k (hLane l) := by
  simp only [pubOf]
  refine List.map_congr_left fun l hl => ?_
  have hl' := List.mem_range.mp hl
  rw [hS _ (by rw [hLane_eq]; (clear * - hT hl'; omega))]
  exact congrArg (kAt sig) (by simp only [hLane, hdrLane, headerAt]; (clear * - hl'; omega))

theorem pub_n {sig : ByteArray} {T : Nat} (hS : Streamed M sig T) (hT : 29 ≤ T) (vk c' : Vector UInt8 32) :
    (pubOf vk c' sig).n = (M.k nLane).val.toNat := by
  rw [hS _ (by rw [nLane_eq]; (clear * - hT; omega))]
  rfl

/-! ## The tape's claims (lvm2 S2; T-V's `tapeClaims`) -/

/-- **The tape's claims as cells** (T-V's `tapeClaims` order): `D̃_l(r) = a_l` (`l < 4`) on `dBlock`, the
ring-switched slices of `D` on `C_main` at `σ ‖ τ ‖ sel(dSel)`, the boundary claims `D̃_l(bits(m)) = h_l`
(`m`'s bits the borrow chain's cells, `h_l` the child's header lanes). -/
def tapeClaimsC (p : Params) (z o : Nat) (oP : P47Out) : List CClaim :=
  ((List.range dLanes).map fun l => ⟨.main, .point (dBlock p) (oP.r ++ selC z o l 2), oP.v.getD l default⟩) ++
  [⟨.main, .ring ⟨p.nuMain, 0⟩ (oP.wire.sigma ++ oP.wire.tau ++ selC z o (dSel p) (dSelBits p)) oP.wire.ring.cs,
    oP.wire.ring.target⟩] ++
  (List.range 4).map fun l => ⟨.main, .point (dBlock p) (oP.mb ++ selC z o l 2), kc (hLane l)⟩

/-! ## `KS`'s output-lane claims -/

/-- `ksYPart` with the point as cells. -/
def ksYPartC (p : Params) (l : Nat) (ptc : List Cell) (z o : Nat) : Placement × List Cell :=
  if l < 14 then (⟨p.ksLog + slotLog, (layout0 p).ks⟩, ptc ++ selC z o (50 + l) slotLog)
  else (⟨p.ksLog, (layout0 p).ksY2 + (l - 14) * 2 ^ p.ksLog⟩, ptc)

/-- **`KS`'s output-lane openings** (`ksOutputClaims0`) as cells: `rk` the instance point, `vk` the
25 lanes. -/
def ksOutC (p : Params) (rk vk : List Cell) (z o : Nat) : List CClaim :=
  (List.range 25).map fun l =>
    ⟨.main, .point (ksYPartC p l rk z o).1 (ksYPartC p l rk z o).2, vk.getD l default⟩

end Lvm.Har
end
-- ===== end of `LvmQAsmArith2Claim` =====

-- ===== merged from `LvmQAsmArith2ClaimLink` (GOLF module merge: `LvmQAsmArith2ClaimLink.lean` is now a stub importing `LvmQAsmArith2`) =====
section
-- New for lvm (HAR-RC): the claims of the link phases (5: `CH` link, `chLink0`'s two ring claims and
-- 17 constant-lane claims; 7: `KS` link, `ksLink0`'s four `sumClaim`s) as cells, every challenge and
-- scalar loaded from its stream lanes. Reused: QA1's reading (`chLinkView`, `ksLinkView`, lane
-- functions `chQ1 … chQC`, `take_range_map`, `drop_range_map`, `scSpec_fst_getD`), HAR's
-- `chLinkPh_run`/`ksLinkPh_run`, QA2's `eqTab_eq` (the `KS` link's `eq(λ, ·)`), this family's `ringG`.

/-!
# Q_arith: the claims of the link phases

* **`chLinkG n Q z o blk ySlot`** (phase 5 from the reader at `P`, `P + 40 = 8 Q`): loads `ρ'` (the
  shift sumcheck's `n` challenges), `λ` (3), `μ` (the two-round sumcheck's 2 challenges), the two
  ring switches (`ringG` on the `in`/`Y` slices and their challenges), one constant cell; returns
  `chLinkC`: the two ring claims at `(ρ', λ, 0, 0, 0)` and `(ρ', μ, slot bits)`, the 17 constant
  lanes at `(ρ', slot l)`. **`chLinkG_val`**: the cells are `(chLink0 p blk ySlot (chLinkView …)).2`;
  `chLinkPh_claims`: `F`'s phase-5 claims (`chLinkPh`) for `m = M3.ofParts p …` (any bus/table parts).
* **`ksLinkG p Q z o`** (phase 7): loads `λ` (5), `ρ'` (`ksLog`), the four scalars; `eq(λ, ·)` by
  QA2's `eqTab`; returns `ksLinkC`: the four `sumClaim`s. **`ksLinkG_val`**, `ksLinkPh_claims`.
-/

set_option autoImplicit false

namespace Lvm.Har

open Lvm Lvm.Loop Lvm.Loop.Build Lvm.Loop.QRing Lvm.Q1 Lvm.QSig DM

variable {c : Ctx} {M : Mem}

/-! ## `F`'s side -/

/-! ## The `KS` link -/

/-- `λ`'s lanes (samples `ksLog … ksLog + 4`), `ρ'`'s (the shift sumcheck's answers), the four
scalars'. -/
def ksLamL (p : Params) (Q : Nat) : List Nat := (List.range laneBits).map fun j => Q + 9 * (p.ksLog + j)
def ksRhoL (p : Params) (Q : Nat) : List Nat :=
  (List.range p.ksLog).map fun i => Q + 9 * (p.ksLog + laneBits) + 6 + 15 * i
def ksValL (p : Params) (Q : Nat) : List Nat :=
  (List.range 4).map fun k => Q + 9 * (p.ksLog + laneBits) + 15 * p.ksLog + 3 * k

/-- The `KS` link's claims as cells (`om`: `eq(λ, ·)`, `rho'`, `vals`: the four scalars). -/
def ksLinkC (p : Params) (z o : Nat) (om rho' vals : List Cell) : List CClaim :=
  let L := layout0 p
  let lo := rho'.take p.recRowsLog
  [⟨.main, .sum p.nuMain ((List.range 25).map fun l =>
      (om.getD l default, (ksYPartC p l rho' z o).1, (ksYPartC p l rho' z o).2)), vals.getD 0 default⟩,
    ⟨.main, .sum p.nuMain ((List.range 25).map fun l =>
      (om.getD l default, ⟨p.ksLog + slotLog, L.ks⟩, rho' ++ selC z o l slotLog)), vals.getD 1 default⟩,
    ⟨.main, .sum p.nuMain ((List.range 17).map fun l =>
      (om.getD l default, ⟨p.recRowsLog, L.s + l * 2 ^ p.recRowsLog⟩, lo)), vals.getD 2 default⟩,
    ⟨.main, .sum p.nuMain ((List.range 17).map fun l =>
      (om.getD l default, ⟨p.recRowsLog, L.x + l * 2 ^ p.recRowsLog⟩, lo)), vals.getD 3 default⟩]

/-- **The `KS` link's claims in v1's layout** (phase 7; `P + 40 = 8 Q`). -/
def ksLinkGV1 (p : Params) (Q z o : Nat) : BM (List CClaim) := do
  let pl ← getPtr
  let _ ← loadAt (ksLamL p Q)
  let rho' ← loadAt (ksRhoL p Q)
  let vals ← loadAt (ksValL p Q)
  let eb ← eqTab (fun i => ec (pl.e + i)) (ec z) (ec o) false laneBits
  pure (ksLinkC p z o ((List.range 32).map fun l => ec (eb + l)) rho' vals)

/-! ### KS14 (lvm2 CR-K)

`M`'s claim has 17 more parts on the rows from the split, with coefficients `eq(λ, l)·sel(ρ')`: entries
`l + 32·(2^w − 1)` of a second `eq` table over `λ ‖ ρ'_{xl…}` (`w = ksLog − xl` coordinates of `ρ'`, all one). -/

/-- The second table's width: `λ`'s 5 coordinates and `ρ'`'s `ksLog − xl`. -/
def ksSelW (p : Params) : Nat := laneBits + (p.ksLog - ksXLog p)

/-- The index of `eq(λ, l)·sel` in the second table. -/
def ksTop (p : Params) : Nat := 32 * (2 ^ (p.ksLog - ksXLog p) - 1)

/-- The second table's coordinate cells: `λ`'s (`pl.e + i`), then `ρ'`'s from `xl`. -/
def ksSelAl (p : Params) (pe : Nat) (rho' : List Cell) (i : Nat) : Cell :=
  if i < laneBits then ec (pe + i) else ec ((rho'.getD (ksXLog p + (i - laneBits)) (ec 0)).n)

/-- The `KS` link's claims as cells under KS14 (`om`: `eq(λ, ·)`; `oms`: `eq(λ ‖ ρ'_{xl…}, ·)`). -/
def ksLinkC14 (p : Params) (z o : Nat) (om oms rho' vals : List Cell) : List CClaim :=
  let L := layout0 p
  let xl := ksXLog p
  let R := 2 ^ p.recRowsLog
  let xlo := rho'.take xl
  [⟨.main, .sum p.nuMain ((List.range 25).map fun l =>
      (om.getD l default, (ksYPartC p l rho' z o).1, (ksYPartC p l rho' z o).2)), vals.getD 0 default⟩,
    ⟨.main, .sum p.nuMain ((List.range 25).map fun l =>
      (om.getD l default, ⟨p.ksLog + slotLog, L.ks⟩, rho' ++ selC z o l slotLog)), vals.getD 1 default⟩,
    ⟨.main, .sum p.nuMain ((List.range 17).map (fun l =>
      (om.getD l default, ⟨p.ksLog, L.s + l * R⟩, rho')) ++ (List.range 17).map fun l =>
      (oms.getD (ksTop p + l) default, ⟨xl, L.s + l * R + ksSplit p⟩, xlo)), vals.getD 2 default⟩,
    ⟨.main, .sum p.nuMain ((List.range 17).map fun l =>
      (om.getD l default, ⟨xl, L.x + l * R⟩, xlo)), vals.getD 3 default⟩]

/-- **The `KS` link's claims under KS14** (phase 7; `P + 40 = 8 Q`). -/
def ksLinkG14 (p : Params) (Q z o : Nat) : BM (List CClaim) := do
  let pl ← getPtr
  let _ ← loadAt (ksLamL p Q)
  let rho' ← loadAt (ksRhoL p Q)
  let vals ← loadAt (ksValL p Q)
  let eb ← eqTab (fun i => ec (pl.e + i)) (ec z) (ec o) false laneBits
  let es ← eqTab (ksSelAl p pl.e rho') (ec z) (ec o) false (ksSelW p)
  pure (ksLinkC14 p z o ((List.range 32).map fun l => ec (eb + l))
    ((List.range (2 ^ ksSelW p)).map fun l => ec (es + l)) rho' vals)

/-- **The `KS` link's claims** (phase 7): KS14's or v1's. -/
def ksLinkG (p : Params) (Q z o : Nat) : BM (List CClaim) :=
  if p.ksLog ≤ p.recRowsLog then ksLinkG14 p Q z o else ksLinkGV1 p Q z o

/-! ## Instances: `P20`, `P8` (reader positions from `phaseFirst`, WP-16a's `aLane`) -/

end Lvm.Har
end
-- ===== end of `LvmQAsmArith2ClaimLink` =====

-- ===== merged from `LvmQAsmHarClaims` (GOLF module merge: `LvmQAsmHarClaims.lean` is now a stub importing `LvmQAsmArith2`) =====
section
-- New for lvm (HAR): phase 8–9's claim list as cells, in `decideProg`'s order (`claimsOf`): the table
-- claims, the Keccak and fixed claims of `CH`, the Keccak claims of `KS`, the `CH` link's, `KS`'s outputs,
-- the `KS` link's.

set_option autoImplicit false

namespace Lvm.Har

open Lvm Lvm.Loop

/-- **The claims as cells** in `claimsOf`'s order (lvm2 S2; `bus.claims = []` for the lvm instance). -/
def claimsC (tabCs tapeCs ksCs ksOut clK : List CClaim) : List CClaim :=
  tabCs ++ (tapeCs ++ ksCs) ++ ksOut ++ clK

end Lvm.Har
end
-- ===== end of `LvmQAsmHarClaims` =====

/-!
# Q_arith after phases 4–7 (`qarithRest`)

`LvmQAsmProg.qarith C = phases47 C >>= qarithRest C` (BLUEPRINT A19, A23). Phase families (owners
in `docs/lvm/stages/HAR.md`): bus/tables (`LvmQAsmArith2Bus*`, `LvmQAsmArith2Tab*`), rings and claims
(`LvmQAsmArith2Ring*`, `LvmQAsmArith2Claim*`), stacked WHIR (`LvmQAsmArith2Whir*`). `Q_acc` (phase
3b, A23) is AC-Q's.
-/

set_option autoImplicit false

namespace Lvm.Har

open Lvm Lvm.Loop Lvm.Loop.Build Lvm.QAsm Lvm.M3 Lvm.QAcc Lvm.QLink

/-- The placement record of a configuration (`P20`: `data20`, else `data8`). -/
def dataOf (C : QCfg) : QData := if C.rl = 14 then data20 else data8

/-- A placeholder cache: the circuit reads only the tables' shapes (`tabs_shape`). -/
def G0 : PG := cacheG (toProgram 0 0 (pure ()))

/-- `arrs` with empty public values (`PUB`, `QLT`): the same shapes (`arrsS_shape`), built without
`qltData` (4.5 s at `P20`). -/
def arrsS (C : QCfg) (D : QData) : List InArr :=
  (List.range 17).map (fun l => ⟨.K, C.rl, l, 17, [(false, Lvm.sCol C.p l)], fin D l, none⟩) ++
  [⟨.K, 10, sgB C, 1, [(false, Lvm.sCol C.p 17)], fin D 17, none⟩] ++
  (List.range 17).map (fun l => ⟨.K, 9, xsB C + l, 17, [(false, Lvm.QAsm.xCol C l)], fin D (18 + l), none⟩) ++
  (List.range 4).map (fun l => ⟨.K, 9, ysB C + l, 4, [(false, ksY C l + ksSplit C.p)], fin D (35 + l), none⟩) ++
  (List.range 4).map (fun l =>
    ⟨.K, 0, mdB C + l, 4, [(false, ksY C l + (spongeBlocks C.p - 1))], fin D (39 + l), none⟩) ++
  [pubArr 10 (pbB C) 1 (false, 0) (fin D 43) [],
   pubArr C.aQT (qtB C) 1 (false, 0) (fin D 44) [],
   ⟨.K, C.bo, obB C, 1, [(false, D.aval)], fin D 45, none⟩]

/-- The tables with empty public values and the placeholder cache (`tabs`' shapes). -/
def tabsS (C : QCfg) (D : QData) : List Tab := lvmTabsC G0 (plOf D) D.groups (arrsS C D) (aux C D)

/-- **The sumcheck tables' shapes** of the record `D` (the table phase is built from them;
`shapesOf_eq`: those of `tabs C G D pub`, any `G`, `pub`). -/
def shapesOf (C : QCfg) (D : QData) : List TShape :=
  (sumcheckTabs (tabsS C D)).map Tab.shape

/-- `fixCols`' (table, column) indices, on shapes (`fixColsR_idx`). -/
def fixIdx (S : List TShape) (pubTab : Nat) : List (Nat × Nat) :=
  S.zipIdx.flatMap fun x => x.1.cols.zipIdx.filterMap fun ci => match ci.1 with
    | some _ => none
    | none => if x.2 == pubTab && ci.2 == 0 then none else some (x.2, ci.2)

/-- `Q_acc`'s inputs from the table gadget's output (BLUEPRINT §12.5; AC-Q's `AccIn`), on the sumcheck
tables' shapes `S` (`shapesOf C D`). -/
def accInOf (C : QCfg) (S : List TShape) (tab : List (List Cell × List Cell)) (z : Cell) : AccIn where
  L := tabEnd S C.p.tableRounds (tabPos C.p) / 8
  dk := C.p.accLog
  la := C.p.accLog / 2
  τp := 10
  pb := pbB C
  rc := tablePointC tab
  ppt := (tab.getD C.p.pubTab default).1
  pv := (tab.getD C.p.pubTab default).2.getD 0 z
  fx := (fixIdx S C.p.pubTab).map fun ji => (tab.getD ji.1 default).2.getD ji.2 z

/-! ## Padding the record-dependent rows

The record `D` (groups, placements) is computed from the program, and the table phase is built from
`D`: per row shape the groups are the binary decomposition of the shape's total rows, so a few rows more
or less of a shape change the groups and the iteration `D ↦ mkData (QT C D)` need not settle. `withPad`
pads the rows `m` emits, per shape, to a rounded total (`roundUp6`, at most ≈ 3 % more) with dummy rows
of the shape that read only zero cells. -/

/-- Add `k` rows of shape `σ` to per-shape counts (shapes in order of first use). -/
def addCnt (σ : Shape) (k : Nat) : List (Shape × Nat) → List (Shape × Nat)
  | [] => [(σ, k)]
  | (σ', n) :: l => if σ' = σ then (σ', n + k) :: l else (σ', n) :: addCnt σ k l

/-- **Rows per shape** of segments: a straight-line row is one row, a loop block's template row
`2^lsize` rows. -/
def rowsByShape (δ : List Seg) : List (Shape × Nat) :=
  δ.foldl (fun acc s => match s with
    | .row r => addCnt r.shape 1 acc
    | .blk B => B.tpl.foldl (fun acc r => addCnt r.shape (2 ^ B.lsize) acc) acc) []

/-- `n` rounded up to a multiple of `2^e`, `e = log₂ n − 5` (`0` below 64). -/
def roundUp6 (n : Nat) : Nat :=
  let g := 2 ^ (n.log2 - 5)
  (n + g - 1) / g * g

/-- A dummy row of shape `σ` reading the zero cells `zK`, `zE` (none for `fixmul`, `readd`). -/
def padRow (zK zE : Cell) (σ : Shape) : Option Row :=
  let args := σ.args.map fun t => match t with
    | .K => zK.addr
    | .E => zE.addr
  match σ.kind with
  | .muladd => some ⟨.muladd, σ.ty, args⟩
  | .lin => some ⟨.lin 0 0, σ.ty, args⟩
  | .assert0 => some ⟨.assert0, .K, args⟩
  | .loadE => some ⟨.loadE, σ.ty, args⟩
  | _ => none

/-- The padding rows of per-shape counts `cs`. -/
def padSegs (zK zE : Cell) (cs : List (Shape × Nat)) : List Seg :=
  cs.flatMap fun x => match padRow zK zE x.1 with
    | some r => List.replicate (roundUp6 x.2 - x.2) (.row r)
    | none => []

/-- **`m`, then its rows padded per shape** (`roundUp6`) with dummy rows on the zero cells. -/
def withPad {α : Type} (zK zE : Cell) (m : BM α) : BM α := fun p =>
  let r := m p
  (r.1, r.2 ++ padSegs zK zE (rowsByShape r.2))

/-- The position cells of opening `k` (`C_rec` 0, `C_main`'s levels 1…): Q_link's `pt.k + posIdx p k j`. -/
def posBase (C : QCfg) (k : Nat) : Nat := nK C + posIdx C.p k 0

/-- Opening `k`'s PoW field (`powSpec`'s output). -/
def pwBase (C : QCfg) (k : Nat) : Nat := pwB C + k

/-- **The rest of Q_arith built from a placement record `D`** (the assembler iterates
`D ↦ mkData (QT C D)` to a fixed point): phase 2, phase 3, `Q_acc`, the ring switches and claims,
phases 8–9, padded per row shape (`withPad`: the assembler's iteration settles). The table shapes `S`
are built once. -/
def qarithT (C : QCfg) (D : QData) (o : P47Out) : BM Unit := do
  let g := kc (pbB C)
  let p := C.p
  let S := shapesOf C D
  let z ← const .E 0 (kc 0)
  let one ← const .E 1 (kc 0)
  let zK ← const .K 0 (kc 0)
  let ksB : Placement := ⟨p.ksLog + slotLog, (layout0 p).ks⟩
  withPad zK z do
    -- phases 2–3 (HAR-BT), 3b (AC-Q)
    let bus ← busG p z one g (busPos p)
    let tab ← tabG S p.tableRounds (tabPos p) z one g bus
    qacc (accInOf C S tab z)
    -- ring switch and claims of phases 4–7 (HAR-RC; lvm2 S2: the tape's claims, `KS`'s)
    let rgK ← ringGkr (p.ksLog - 4) (aLane p 6) z.n
    let clK ← ksLinkG p (aLane p 7) z.n one.n
    let cs := claimsC (tabClaims S tab z) (tapeClaimsC p z.n one.n o) (kClaimsC ksB o.kko rgK)
      (ksOutC p o.rk o.vk z.n one.n) clK
    openG (cfgMain p (posBase C) (pwBase C)) (p.logN == 20 && p.nuMain == CMain.nu20)
      cs o.mb z one g

/-- **The rest of Q_arith** on the configuration's own record. -/
def qarithRest (C : QCfg) (o : P47Out) : BM Unit := qarithT C (dataOf C) o

end Lvm.Har
