-- ===== merged from `LvmSubmissionST` (GOLF module merge: `LvmSubmissionST.lean` is now a stub importing `LvmCertTInst`) =====
section
-- New for lvm2 (roll 8 = B1, B1-IX): the submission of the typed backend. `V_S` is `VST P20 NT20` (`LvmVerifierS`,
-- `TypedV.decideFT` on the B program's typed instance, `LvmQTypedInst`) behind the typed static guard
-- `staticOkB20` (A24, as roll 7's `subG staticOkB`; wave L adds `oneOkB`); the extractor is WP-13a's, as before.

/-!
# The typed submission

* **`VSB20`**: `V_S` at `P20` on the typed instance `NT20` (the frozen regions, `Φ_Q`'s cache, the mini-bus's
  tables); `P8`'s in `LvmSubmissionST8`.
* **`submissionB20 := subG staticOkB20 VSB20`**: the guarded submission (`staticOkB20 = staticOkT20 && oneOkB
  layT20 && nodeChkB … && harChkB …`). With the guard off the `S` branch accepts nothing (`LvmFinGuard.certificateR_reject`); with it on,
  the typed certificate is wave L's (`LvmCertT20.certificateT20`: the refinement of `decideFT` to `typedProg`, L-C;
  `typedSpecR`, L-B; `NodeSound` on `GoodT`, L-D, reading the guard's facts `LvmCertTInst.SF20`).
-/

set_option autoImplicit false

namespace Lvm.T

open RecursionFast

/-- **The layout's word `1` lies in a `1` region** of its word space (the specification's `TInst.Ok`, second half;
`mkLayD` places it so, the guard checks it natively: lvm2 roll 8, wave L). -/
def oneOkB (lay : Lvm.Typed.Lay) : Bool :=
  (lay.yregs.find? fun r => decide (r.base ≤ lay.one ∧ lay.one < r.base + 2 ^ r.log)).map (·.src) == some .one

end Lvm.T
end
-- ===== end of `LvmSubmissionST` =====

/-!
# The typed instance at `P20`

* **`Ti20`**: the specification's typed instance (`TNat.inst`: the regions' maps are `NT20`'s, the program `QB20`,
  the layout `layT20`, the mini-bus's tables `mbT20`).
* **`SF20`**: the typed guard's facts at `P20` (`sf20 : staticOkB20 = true → SF20`: `StaticFactsT` and wave L's extra
  native checks).
-/

set_option autoImplicit false

namespace Lvm.CT

open Lvm.Typed Lvm.QTyped

/-- **The specification's typed instance at `P20`.** -/
noncomputable def Ti20 : TInst := NT20.inst QB20 layT20

/-- **The typed guard's facts at `P20`** (`staticOkB20`): `StaticFactsT`'s (`staticOkT20`), then wave L's native
checks, one field each (the word `1`'s region; L-D's/L-H's checks join here). Field access `S.wf`, `S.regs`, … is
`StaticFactsT`'s. -/
structure SF20 : Prop extends StaticFactsT Lvm.QAsm.cfg20 tdata20 frz20 QB20 layT20 cacheT20 NT20 where
  /-- The layout's word `1` lies in a `1` region (`Lvm.T.oneOkB`). -/
  one : Lvm.T.oneOkB layT20 = true
  /-- `σ′`'s regions lie in the stream block `S` (M′, `Lvm.TypedV.sigInSB`). -/
  sig : Lvm.TypedV.SigInS NT20
  /-- The layout checks the typed `NodeSound` reads (`nodeChkB`, L-D's `LvmQTypedChk`). -/
  chk : nodeChkB Lvm.QAsm.cfg20 frz20 QB20 layT20 NT20 = true
  /-- The typed HAR's checks (`harChkB`, L-H's `LvmQTypedHarChk`). -/
  har : harChkB Lvm.QAsm.cfg20 tdata20 NT20 = true

end Lvm.CT
