set_option maxRecDepth 100000 in
/-- **The schedule at `P20T` is `schedT20`** (by `rfl` from `phases_P20T_lit`, ≈ 1.0 M heartbeats; the consumers that read
only the schedule save the `flatMap` of the phases, ≈ 0.9 M heartbeats each). -/
theorem schedule_P20T_lit : schedule P20T = schedT20 := by
  rw [schedule, phases_P20T_lit]; rfl

/-- **S2GT-STMT 2** (owner L): S2GT's header is 5,664 bytes (`acc_in`: 46 scalars of 16 B; pins the `LvmParams`
edit). -/
theorem headerBytesP_P20T : headerBytesP P20T = 5664 ∧ seedLenP P20T = 5688 := by
  decide

set_option maxRecDepth 100000 in
/-- **S2GT-STMT 3** (owner L): **S2GT's sizes** (`s2gt.py` at occupancy 47 [model]; one kernel evaluation of the
tally): `|π| = 338,000`, `qS = 3,926`, `L = 612,640`, `T = 76,580`, 4,505 sponge blocks, 3,623 items (K = 32), the length rule,
the 95 % caps. -/
theorem sizes_P20T : (piSize P20T = 338000 ∧ qS P20T = 3926 ∧ hashedLen P20T = 612640 ∧
    streamLanes P20T = 76580 ∧ spongeBlocks P20T = 4505 ∧ (schedule P20T).length = 3623) ∧
    lengthRule P20T = true ∧
    (100 * streamLanes P20T ≤ 95 * streamCap P20T ∧ 100 * qS P20T ≤ 95 * 16384 ∧
      100 * spongeBlocks P20T ≤ 95 * 2 ^ P20T.recRowsLog) := by
  rw [piSize, qS, spongeBlocks, streamLanes, lengthRule, hashedLen, tally, schedule_P20T_lit]
  decide +kernel

/-- Proof help (GOLF2-K1): a read width is `eBytes` or a `readW` item's width, so `readWidthsP`'s check is one walk
of the items (not of the 7,068 widths). -/
private theorem readWidthsP_all_of (p : Params) (g : Nat → Bool) (he : g eBytes = true)
    (h : (schedule p).all (fun it => match it with | .readW _ w => g w | _ => true) = true) :
    (readWidthsP p).all g = true := by
  rw [List.all_eq_true] at h ⊢
  intro w hw
  rw [readWidthsP] at hw
  obtain ⟨it, hit, hw⟩ := List.mem_flatMap.mp hw
  have hi := h it hit
  cases it with
  | read m => rw [List.eq_of_mem_replicate hw]; exact he
  | readW m w' => rw [List.eq_of_mem_replicate hw]; exact hi
  | cap => simp at hw
  | sample => simp at hw
  | positions => simp at hw
  | opening => simp at hw

set_option maxRecDepth 100000 in
/-- Every read width of the S2GT schedule is positive (one kernel walk of the literal items). -/
theorem readWidthsP_pos_P20T : (readWidthsP P20T).all (fun w ↦ decide (0 < w)) = true :=
  readWidthsP_all_of P20T _ (by decide) (by rw [schedule_P20T_lit]; decide +kernel)

/-- **S2GT-STMT 4** (owner L): every read width of the S2GT schedule is positive. -/
theorem rwG20_pos : ∀ n, 0 < rwG20 n := fun n ↦ by
  unfold rwG20
  rw [List.getD_eq_getElem?_getD]
  cases h : (readWidthsP P20T)[n]? with
  | none => exact Nat.zero_lt_succ _
  | some w =>
    exact of_decide_eq_true (List.all_eq_true.mp readWidthsP_pos_P20T w (List.mem_of_getElem? h))

set_option maxRecDepth 100000 in
/-- **S2GT-STMT 5** (owner L): S2GT's query bound (one kernel evaluation of the schedule's query count). -/
theorem qcItems_P20T : 2 + qcItems P20T (schedule P20T) 0 ≤ 16384 := by
  rw [schedule_P20T_lit]
  decide +kernel

end Lvm

namespace Lvm.CT

open Lvm Lvm.ASM

/-- **S2GT's format**: `rwG20`, `|π| = piSize P20T`, header `headerBytesP P20T`, M′'s occupied words (`occOfS`:
47 at the root, see the design note). -/
def fmtG20 : SFmt := ⟨rwG20, rwG20_pos, piSize P20T, headerBytesP P20T, occOfS⟩

end Lvm.CT
