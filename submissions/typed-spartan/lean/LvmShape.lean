-- New for lvm2 (CR-S0, roll 7 SH2-Z; CR-DES §1.4): the two shapes of `C_main`. A statement with
-- `n ≤ 2^18` ("small") commits its `C_main` in the ν = 23 code (lvm2 roll 8, B1; roll 7: ν = 24) with every
-- odd word zero; its even words are a ν = 22 logical table (`D` at `2^18` rows per lane, `T`, `KS`, `KSY2`,
-- `X`, the tables shifted down by `3·2^20`). The certificate sees a small column through `bigOf`: the
-- big-layout column it stands for. Lvm2 roll 8 (wave L, L-W): the bus path's middle phases moved to `LvmShapeBus`.
import LvmCertSMid3
import LvmShapeVN
import LvmShapeVE
import LvmShapeVT

/-!
# The two shapes of `C_main`

* **Layouts** (B1's `layout0` at physical ν = 23, KS13, `LvmLayout`): big `D` 0 (`2^22`, `D_l` at
  `l·2^20`), the typed region `T` `4·2^20` (`2^20`), `KS` `5·2^20` (`2^19`), `KSY2` `5·2^20 + 2^19` (`2^17`),
  `X` `5·2^20 + 2^19 + 2^17` (`2^14`), tables from `5,914,624`; small logical `D` 0 (`D_l` at `l·2^18`), `T`
  `2^20`, `KS` `2·2^20`, `KSY2` `2·2^20 + 2^19`, `X` `2·2^20 + 2^19 + 2^17`, tables from `2,768,896` to `2^22`.
  Every block at or above `T` moves down by the same `3·2^20` (`shift_uniform`), so the map is one shift
  above `D`.
* **`small x`** (`(pubX x).n ≤ 2^18`), **`bigOf q`**: big word `a` is the small physical word
  `2·σ(a)` (`smallIdx`), `D_l[i]` for `2^18 ≤ i < 2^20` is `z*_l = Keccak-f(0)`'s lane `l` (`zStar`: what
  `TapeOut` forces on dead rows), every other word (above the small tables' room) is `0`;
  **`view x q`** (`bigOf q` when small); **`Good₂`**, **`nodeSound₂`**.
* **`onStackZ c`**: a big-stack claim on the small physical stack. Its weight is
  `(1 − x₀) · Σ_{regions (k, ob, os)} eqAbove⟨k, os⟩(x.tail) · c.w(x.tail.take k ‖ sel(ob))`: the seven
  aligned regions (`D_l`'s live rows, three `2^20` blocks above; roll 7: eleven) evaluate the big weight at the
  relocated point; its value loses the `D` tail's mass times `z*` (`tailValue`, a cube sum: V_S computes it in
  closed form per claim kind, CR-V proves the two agree). It is defined on **any** stack claim (the
  weight stays a closure): **`holds_onStackZ`** is unconditional, **`isMultiaffine_onStackZ`** needs
  only the big claim's multiaffinity (`side_midS`).
* **`imgC x`** (the viewed candidate pairs), **`specKgS₂`** (`kgSpecS` at the view accessors),
  **`openPostR_congr`**: the shape-generic pieces of O6 that the typed backend's `midSpecR_T₂` uses
  (`LvmTypedSpec`). **`midS₂`** (`midSA` with `C_main`'s claims through `onStackZ` when small, `assembleS₂`)
  stays here; its O6 and shape (`midSpecR₂`, `midShape_midS₂`) are in `LvmShapeBus` (lvm2 roll 8, wave L: outside
  the typed certificate's import closure).
-/

set_option autoImplicit false

namespace Lvm.Shape

open LeanVM.Parameters LeanVM.Protocol LeanVM.Protocol.Compile LeanVM.Protocol.Verifier
open LeanVM.Protocol.Compile.VerifierProgram LeanVM.Protocol.Whir.Sound LeanVM.Protocol.EndToEnd
open LeanVM.Protocol.EndToEnd.Front
open LeanVM.Protocol.EndToEnd.Sound (RetOK)
open Lvm.ASM Lvm.VEq Lvm.KG Lvm.Acc
open Lvm.M3 (Tab lay26)
open Lvm.NS (colM ksCol ksY2 msgM msgX)
open scoped ENNReal NNReal

/-! ## The layouts (KS14; `LvmLayout`'s stage S2GJ2C, generated by `refreeze2.py`) -/

/-- Big `D` (`2^22` words, `D_l` at `l·2^20`). -/
abbrev bDOff : ℕ := CMain.dOff20
/-- Big `KS` (`2^19` words). -/
abbrev bKSOff : ℕ := CMain.ksOff20
/-- Big `KSY2` (`2^17` words). -/
abbrev bKSY2Off : ℕ := CMain.ksY2Off20
/-- Big `X` (`2^14` words). -/
abbrev bXOff : ℕ := CMain.xOff20
/-- Big tables from here. -/
abbrev bFree : ℕ := CMain.freeLo20
/-- Small logical `D` (`2^20` words, `D_l` at `l·2^18`, rows `< 2^18`). -/
abbrev sDOff : ℕ := CMain.dOff20s
/-- Small logical `KS`. -/
abbrev sKSOff : ℕ := CMain.ksOff20s
/-- Small logical `KSY2`. -/
abbrev sKSY2Off : ℕ := CMain.ksY2Off20s
/-- Small logical `X`. -/
abbrev sXOff : ℕ := CMain.xOff20s
/-- Small logical tables from here, up to `2^22`. -/
abbrev sFree : ℕ := CMain.freeLo20s
/-- The shift of every block from `T` up. -/
abbrev hiShift : ℕ := 3 * 2 ^ 20

/-- Every block from `KS` up moves by `hiShift`; the small tables have `1,425,408` words (roll 7: `5,996,544`). -/
theorem shift_uniform : bKSOff - sKSOff = hiShift ∧ bKSY2Off - sKSY2Off = hiShift ∧
    bXOff - sXOff = hiShift ∧ bFree - sFree = hiShift ∧ sFree + 1425408 = 2 ^ sLog := by
  decide +kernel

/-! ## The shape and the view -/

/-- **The shape**: the statement's chain fits `2^18` rows. A function of the header (`n` is bound by the
seed query). -/
def small (x : List UInt8) : Bool := decide ((pubX x).n ≤ 2 ^ 18)

/-- **`z*_l`**: lane `l` of `Keccak-f(0)`, the digest `TapeOut` forces on a dead row (`chainIn` is `0`
from row `n` on). -/
def zStar (l : ℕ) : K := LeanVM.Protocol.KeccakGkr.laneWord (LeanVM.Semantics.keccakF1600 Lvm.KSponge.zeroSt) l

/-- The small logical word that big word `a` stands for: `D_l`'s rows `< 2^18`, then everything from
`KS` up to the small table's end shifted by `hiShift`; `none` on `D`'s tail and above. -/
def smallIdx (a : ℕ) : Option ℕ :=
  if a < 2 ^ 22 then (if a % 2 ^ 20 < 2 ^ 18 then some (a / 2 ^ 20 * 2 ^ 18 + a % 2 ^ 20) else none)
  else if a < 2 ^ sLog + hiShift then some (a - hiShift) else none

/-- Big word `a` of the column a small column `q` stands for: small physical word `2·σ(a)`, `z*_l` on
`D_l`'s tail, `0` above the small tables' room. -/
def bigWord (q : Column CMain.nu20) (a : ℕ) : K :=
  match smallIdx a with
  | some j => Lvm.NS.wd q (2 * j)
  | none => if a < 2 ^ 22 then zStar (a / 2 ^ 20) else 0

/-- **The big-layout column a small-shape column stands for.** -/
def bigOf (q : Column CMain.nu20) : Column CMain.nu20 :=
  ⟨CompPoly.CMlPolynomialEval.mk CMain.nu20 (Vector.ofFn fun i ↦ bigWord q i)⟩

/-- **The view**: the big-layout column of a statement's `C_main` candidate. -/
def view (x : List UInt8) (q : Column CMain.nu20) : Column CMain.nu20 := if small x then bigOf q else q

/-- The view on a candidate pair. -/
abbrev vp (x : List UInt8) (p : Pair) : Pair := (view x p.1, p.2)

/-- **The good pair of both shapes**: `Good` on the view. -/
def Good₂ (Good : GoodRel) : GoodRel := fun x qm qr ↦ Good x (view x qm) qr

/-- **`NodeSound` for `Good₂`** from `NodeSound` for the big layout (`NodeSound` quantifies over every
`C_main` candidate). -/
theorem nodeSound₂ {VS : Lvm.T.SProg} {vk : RecursionFast.Digest} {Good : GoodRel}
    {child : Column 19 → RecursionFast.Signed} (h : NodeSound VS vk Good child) :
    NodeSound VS vk (Good₂ Good) child :=
  fun c x qm qr hok hG ↦ h c x (view x qm) qr hok hG

/-! ## Claims on the small stack -/

/-- The mass of a big-stack weight on `D`'s tail (rows `2^18 … 2^20 − 1` of each lane) times `z*`. -/
def tailValue (w : List E → E) : E :=
  ∑ a ∈ (Finset.range (2 ^ 22)).filter (fun a ↦ 2 ^ 18 ≤ a % 2 ^ 20),
    w (boolPoint CMain.nu20 a) * ofK (zStar (a / 2 ^ 20))

/-- The big point region `r` relocates `x` to: `x`'s logical coordinates (padded to `sLog`, so the point
always has `ν = 23` coordinates) below the region's window, the region's big selector bits above it. -/
def relocE (x : List E) (r : ℕ × ℕ × ℕ) : List E :=
  (x.tail ++ List.replicate sLog 0).take r.1 ++ selE (r.2.1 >>> r.1) (CMain.nu20 - r.1)

/-- **A big-stack claim on the small physical stack**: weight `(1 − x₀) · W₂₃(x.tail)`, `W₂₃` the big
weight evaluated region by region at the relocated point; value less `D`'s tail times `z*`. -/
def onStackZ (c : VStackClaim) : VStackClaim :=
  (fun x ↦ (1 - x.headD 0) * (regions.map fun r ↦
      (⟨r.1, r.2.2⟩ : VPlacement).eqAbove x.tail *
        c.1 (relocE x r)).sum,
    c.2 - tailValue c.1)

section HoldsAux

open Finset

theorem getD_bigOf (q : Column CMain.nu20) {a : ℕ} (ha : a < 2 ^ CMain.nu20) :
    (bigOf q).values.getD a 0 = bigWord q a := by
  unfold bigOf CompPoly.CMlPolynomialEval.mk
  exact vector_getD_ofFn (fun i : Fin (2 ^ CMain.nu20) ↦ bigWord q i) 0 ha

theorem bigWord_D (q : Column CMain.nu20) {l u : ℕ} (hl : l < 4) (hu : u < 2 ^ 18) :
    bigWord q (l * 2 ^ 20 + u) = Lvm.NS.wd q (2 * (l * 2 ^ 18 + u)) := by
  have e1 : (l * 2 ^ 20 + u) % 2 ^ 20 = u := by omega
  have e2 : (l * 2 ^ 20 + u) / 2 ^ 20 = l := by omega
  have h1 : l * 2 ^ 20 + u < 2 ^ 22 := by omega
  have hs : smallIdx (l * 2 ^ 20 + u) = some (l * 2 ^ 18 + u) := by
    rw [smallIdx, ite_eq_left h1, e1, ite_eq_left hu, e2]
  rw [bigWord, hs]

theorem bigWord_tail (q : Column CMain.nu20) {l u : ℕ} (hl : l < 4) (hu : u < 3 * 2 ^ 18) :
    bigWord q (l * 2 ^ 20 + (2 ^ 18 + u)) = zStar l := by
  have e1 : (l * 2 ^ 20 + (2 ^ 18 + u)) % 2 ^ 20 = 2 ^ 18 + u := by omega
  have e2 : (l * 2 ^ 20 + (2 ^ 18 + u)) / 2 ^ 20 = l := by omega
  have h1 : l * 2 ^ 20 + (2 ^ 18 + u) < 2 ^ 22 := by omega
  have h2 : ¬ 2 ^ 18 + u < 2 ^ 18 := by omega
  have hs : smallIdx (l * 2 ^ 20 + (2 ^ 18 + u)) = none := by
    rw [smallIdx, ite_eq_left h1, e1, ite_eq_right h2]
  rw [bigWord, hs, ite_eq_left h1, e2]

theorem bigWord_hi (q : Column CMain.nu20) {j u : ℕ} (hj : j < 3) (hu : u < 2 ^ 20) :
    bigWord q (4 * 2 ^ 20 + (j * 2 ^ 20 + u)) = Lvm.NS.wd q (2 * ((1 + j) * 2 ^ 20 + u)) := by
  have h1 : ¬ 4 * 2 ^ 20 + (j * 2 ^ 20 + u) < 2 ^ 22 := by omega
  have h2 : 4 * 2 ^ 20 + (j * 2 ^ 20 + u) < 2 ^ sLog + hiShift := by simp only [sLog, CMain.nu20s, hiShift]; omega
  have e : 4 * 2 ^ 20 + (j * 2 ^ 20 + u) - hiShift = (1 + j) * 2 ^ 20 + u := by simp only [hiShift]; omega
  have hs : smallIdx (4 * 2 ^ 20 + (j * 2 ^ 20 + u)) = some ((1 + j) * 2 ^ 20 + u) := by
    rw [smallIdx, ite_eq_right h1, ite_eq_left h2, e]
  rw [bigWord, hs]

theorem bigWord_top (q : Column CMain.nu20) (a : ℕ) :
    bigWord q (4 * 2 ^ 20 + (3 * 2 ^ 20 + a)) = 0 := by
  have h1 : ¬ 4 * 2 ^ 20 + (3 * 2 ^ 20 + a) < 2 ^ 22 := by omega
  have h2 : ¬ 4 * 2 ^ 20 + (3 * 2 ^ 20 + a) < 2 ^ sLog + hiShift := by simp only [sLog, CMain.nu20s, hiShift]; omega
  have hs : smallIdx (4 * 2 ^ 20 + (3 * 2 ^ 20 + a)) = none := by
    rw [smallIdx, ite_eq_right h1, ite_eq_right h2]
  rw [bigWord, hs, ite_eq_right h1]

theorem relocE_boolPoint (j : ℕ) {r : ℕ × ℕ × ℕ} (hk : r.1 ≤ 22) (hal : r.2.1 % 2 ^ r.1 = 0) :
    relocE (0 :: boolPoint 22 j) r = boolPoint CMain.nu20 (r.2.1 + j % 2 ^ r.1) := by
  unfold relocE
  rw [List.tail_cons, List.take_append_of_le_length (by rw [Whir.Complete.length_boolPoint]; exact hk),
    take_boolPoint 22 _ j hk, ← boolPoint_mod r.1 j, selE, selectorPoint_eq_boolPoint,
    Nat.shiftRight_eq_div_pow]
  have h := boolPoint_add_two_pow_mul r.1 (CMain.nu20 - r.1) (j % 2 ^ r.1) (r.2.1 / 2 ^ r.1)
    (Nat.mod_lt _ (Nat.two_pow_pos _))
  rw [Nat.add_sub_cancel' (by simp only [CMain.nu20]; omega)] at h
  rw [← h]
  congr 1
  have := Nat.div_add_mod r.2.1 (2 ^ r.1)
  omega

theorem onStackZ_odd (c : VStackClaim) (j : ℕ) :
    (onStackZ c).1 (boolPoint CMain.nu20 (2 * j + 1)) = 0 := by
  rw [show CMain.nu20 = 22 + 1 from rfl, Whir.Complete.boolPoint_two_mul_add_one]
  simp only [onStackZ, List.headD_cons, sub_self, zero_mul]

theorem onStackZ_even (c : VStackClaim) {j : ℕ} (hj : j < 2 ^ 22) :
    (onStackZ c).1 (boolPoint CMain.nu20 (2 * j)) = (regions.map fun r ↦
      (if j / 2 ^ r.1 = r.2.2 / 2 ^ r.1 then 1 else 0) * c.1 (boolPoint CMain.nu20 (r.2.1 + j % 2 ^ r.1))).sum := by
  have e : boolPoint CMain.nu20 (2 * j) = 0 :: boolPoint 22 j := Whir.Complete.boolPoint_two_mul 22 j
  rw [e]
  simp only [onStackZ, List.headD_cons, List.tail_cons, sub_zero, one_mul]
  refine congrArg List.sum (List.map_congr_left fun r hr ↦ ?_)
  obtain ⟨hk, hal, -⟩ := regions_facts r hr
  obtain ⟨-, hfit⟩ := regions_small r hr
  rw [Lvm.ASM.eqAbove_boolPoint hfit hj, relocE_boolPoint j (by omega) hal]

theorem small_sum (c : VStackClaim) (q : Column CMain.nu20) :
    ∑ x : Fin (2 ^ CMain.nu20), (onStackZ c).1 (boolPoint CMain.nu20 x) * ofK (q.values.getD x 0) =
      (regions.map fun r ↦ ∑ u ∈ range (2 ^ r.1),
        c.1 (boolPoint CMain.nu20 (r.2.1 + u)) * ofK (q.values.getD (2 * (r.2.2 + u)) 0)).sum := by
  rw [Fin.sum_univ_eq_sum_range (fun x ↦ (onStackZ c).1 (boolPoint CMain.nu20 x) * ofK (q.values.getD x 0)),
    show range (2 ^ CMain.nu20) = range (2 * 2 ^ 22) by norm_num, sum_range_two_mul]
  calc _ = ∑ j ∈ range (2 ^ 22), (regions.map fun r ↦ (if j / 2 ^ r.1 = r.2.2 / 2 ^ r.1 then
          c.1 (boolPoint CMain.nu20 (r.2.1 + j % 2 ^ r.1)) * ofK (q.values.getD (2 * j) 0) else 0)).sum := by
        refine sum_congr rfl fun j hj ↦ ?_
        rw [onStackZ_odd, zero_mul, add_zero, onStackZ_even c (mem_range.mp hj), ← List.sum_map_mul_right]
        refine congrArg List.sum (List.map_congr_left fun r _ ↦ ?_)
        split_ifs <;> simp
    _ = _ := by
        rw [sum_list_sum_comm]
        refine congrArg List.sum (List.map_congr_left fun r hr ↦ ?_)
        obtain ⟨hal, hfit⟩ := regions_small r hr
        rw [sum_window (fun j ↦ c.1 (boolPoint CMain.nu20 (r.2.1 + j % 2 ^ r.1)) *
          ofK (q.values.getD (2 * j) 0)) hal hfit]
        refine sum_congr rfl fun u hu ↦ ?_
        rw [Nat.add_mod, hal, zero_add, Nat.mod_mod, Nat.mod_eq_of_lt (mem_range.mp hu)]

theorem tailValue_split (w : List E → E) :
    tailValue w = ∑ l ∈ range 4, ∑ u ∈ range (3 * 2 ^ 18),
      w (boolPoint CMain.nu20 (l * 2 ^ 20 + (2 ^ 18 + u))) * ofK (zStar l) := by
  rw [tailValue, sum_filter, show range (2 ^ 22) = range (4 * 2 ^ 20) by norm_num, sum_range_mul']
  refine sum_congr rfl fun l hl ↦ ?_
  have hl := mem_range.mp hl
  rw [show range (2 ^ 20) = range (2 ^ 18 + 3 * 2 ^ 18) by norm_num, sum_range_add,
    sum_eq_zero fun u hu ↦ ite_eq_right (by have := mem_range.mp hu; omega), zero_add]
  refine sum_congr rfl fun u hu ↦ ?_
  have hu := mem_range.mp hu
  rw [ite_eq_left (by omega), show (l * 2 ^ 20 + (2 ^ 18 + u)) / 2 ^ 20 = l by omega]

theorem big_sum (c : VStackClaim) (q : Column CMain.nu20) :
    ∑ x : Fin (2 ^ CMain.nu20), c.1 (boolPoint CMain.nu20 x) * ofK ((bigOf q).values.getD x 0) =
      (regions.map fun r ↦ ∑ u ∈ range (2 ^ r.1),
        c.1 (boolPoint CMain.nu20 (r.2.1 + u)) * ofK (q.values.getD (2 * (r.2.2 + u)) 0)).sum +
        tailValue c.1 := by
  have hg : ∀ x : Fin (2 ^ CMain.nu20), c.1 (boolPoint CMain.nu20 x) * ofK ((bigOf q).values.getD x 0) =
      c.1 (boolPoint CMain.nu20 x) * ofK (bigWord q x) := fun x ↦ by rw [getD_bigOf q x.isLt]
  rw [Finset.sum_congr rfl fun x _ ↦ hg x,
    Fin.sum_univ_eq_sum_range (fun x ↦ c.1 (boolPoint CMain.nu20 x) * ofK (bigWord q x))]
  rw [show range (2 ^ CMain.nu20) = range (4 * 2 ^ 20 + (3 * 2 ^ 20 + 2 ^ 20)) by norm_num, sum_range_add,
    sum_range_add, sum_eq_zero (s := range (2 ^ 20)) fun a _ ↦ by rw [bigWord_top]; simp, add_zero,
    sum_range_mul' _ 4, sum_range_mul' _ 3, sum_regions, tailValue_split, add_right_comm,
    ← sum_add_distrib]
  refine congrArg₂ (· + ·) ?_ ?_
  · refine sum_congr rfl fun l hl ↦ ?_
    have hl := mem_range.mp hl
    rw [show range (2 ^ 20) = range (2 ^ 18 + 3 * 2 ^ 18) by norm_num, sum_range_add]
    refine congrArg₂ (· + ·) ?_ ?_
    · refine sum_congr rfl fun u hu ↦ ?_
      rw [bigWord_D q hl (mem_range.mp hu), Lvm.NS.wd]
    · refine sum_congr rfl fun u hu ↦ ?_
      rw [bigWord_tail q hl (mem_range.mp hu)]
  · refine sum_congr rfl fun j hj ↦ sum_congr rfl fun u hu ↦ ?_
    rw [bigWord_hi q (mem_range.mp hj) (mem_range.mp hu), show 4 * 2 ^ 20 + (j * 2 ^ 20 + u) =
      (4 + j) * 2 ^ 20 + u by ring, Lvm.NS.wd]

end HoldsAux

/-- **The small claim holds of `q` iff the big claim holds of `bigOf q`** (no hypothesis: `bigOf q` is
`0` outside the regions and `D`'s tail). -/
theorem holds_onStackZ (c : VStackClaim) (q : Column CMain.nu20) :
    StackClaim.Holds CMain.nu20 (onStackZ c) q ↔ StackClaim.Holds CMain.nu20 c (bigOf q) := by
  unfold StackClaim.Holds
  rw [small_sum, big_sum]
  exact eq_sub_iff_add_eq

/-- **`onStackZ` keeps multiaffinity.** -/
theorem isMultiaffine_onStackZ {c : VStackClaim} (h : IsMultiaffine CMain.nu20 c.1) :
    IsMultiaffine CMain.nu20 (onStackZ c).1 := by
  -- the region sum as a function of the 22 logical coordinates
  have hH : IsMultiaffine 22 fun m : List E ↦ (regions.map fun r ↦
      (⟨r.1, r.2.2⟩ : VPlacement).eqAbove m *
        c.1 ((m ++ List.replicate sLog 0).take r.1 ++ selE (r.2.1 >>> r.1) (CMain.nu20 - r.1))).sum := by
    apply isMultiaffine_list_sum
    intro r hr
    have hk : r.1 ≤ 22 := by rcases (regions_facts r hr).1 with h | h <;> omega
    have hA : IsMultiaffine 22 fun m : List E ↦ (⟨r.1, r.2.2⟩ : VPlacement).eqAbove m :=
      isMultiaffine_congr (Lvm.ASM.isMultiaffine_drop (v := r.1)
        (Lvm.ASM.isMultiaffine_eqEvalN (selE (r.2.2 >>> r.1) (22 - r.1)) _))
        fun l hl ↦ by simp [LeanVM.Protocol.Verifier.Placement.eqAbove, hl]
    have hB : IsMultiaffine 22 fun m : List E ↦
        c.1 ((m ++ List.replicate sLog 0).take r.1 ++ selE (r.2.1 >>> r.1) (CMain.nu20 - r.1)) :=
      isMultiaffine_congr (Lvm.ASM.isMultiaffine_take
        (isMultiaffine_append_right h (selE (r.2.1 >>> r.1) (CMain.nu20 - r.1))
          (by simp [selE, LeanVM.Protocol.Verifier.selectorPoint, CMain.nu20]; omega)) hk)
        fun l hl ↦ by rw [List.take_append_of_le_length (by omega)]
    exact Lvm.ASM.isMultiaffine_mul hA hB fun l hl k' hk' ↦ by
      by_cases hkk : k' < r.1
      · left; intro X
        simp only [LeanVM.Protocol.Verifier.Placement.eqAbove, List.length_set, List.drop_set_of_lt hkk]
      · right; intro X
        simp only [List.take_append_of_le_length (by simp [hl]; omega : r.1 ≤ (l.set k' X).length),
          List.take_append_of_le_length (by omega : r.1 ≤ l.length),
          List.take_set_of_le (by omega : r.1 ≤ k')]
  have hm := Lvm.ASM.isMultiaffine_mul (isMultiaffine_headFactor 22)
    (Lvm.ASM.isMultiaffine_drop (v := 1) (n := 23) hH) fun l hl k hk ↦ by
      by_cases hk0 : k = 0
      · right; intro X; subst hk0; cases l <;> simp
      · left; intro X; cases l with
        | nil => simp
        | cons a l => obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hk0; simp
  exact isMultiaffine_congr hm fun l _ ↦ by simp only [onStackZ, relocE, List.drop_one]

/-- `C_main`'s claims of a statement on its shape's stack. -/
def onStackZs (x : List UInt8) (cl : List VStackClaim) : List VStackClaim :=
  if small x then cl.map onStackZ else cl

/-- **The claims of phases 2–7 in both shapes**: `assembleS`'s, `C_main`'s through `onStackZ` when small. -/
def assembleS₂ (x : List UInt8) (T : List Tab) (pub : Pub) (cl : List ColumnClaim) (kg : KgOut) :
    OpenClaims :=
  ((assembleS T pub cl kg).1, onStackZs x (assembleS T pub cl kg).2)

/-- **The middle phases in both shapes** (`midSA` with `assembleS₂`; the same events). -/
def midS₂ (tabs : Pub → List Tab) (x : List UInt8) : VerifierProgram OpenClaims :=
  lbusTableAccProg Lvm.P20 tabs (pubX x) Lvm.P20.busDepth >>= fun a ↦
    kgProgS (hdX x).s (pubX x).n >>= fun k ↦
      VerifierProgram.ret (assembleS₂ x (TS tabs x) (pubX x) a k)

/-! ## The viewed candidate pairs and phases 4–7 -/

/-- The viewed candidate pairs. -/
def imgC (x : List UInt8) (h : List Ev) : Set Pair := vp x '' candPairs h

theorem imgC_append (x : List UInt8) (h₀ l : List Ev) (h2 : 2 ≤ (commits h₀).length) :
    imgC x (h₀ ++ l) = imgC x h₀ := by
  rw [imgC, imgC, Lvm.M3.candPairs_append h₀ l h2]

theorem imgC_ncard_le (x : List UInt8) (h : List Ev) : (imgC x h).ncard ≤ 37696 :=
  (Set.ncard_image_le (Set.toFinite _)).trans (candPairs_ncard_le h)

theorem doomed_imgC {x : List UInt8} {A : Pair → Prop} {h : List Ev} :
    Doomed (imgC x) A h ↔ Doomed candPairs (fun p ↦ A (vp x p)) h :=
  ⟨fun hd p hp ↦ hd _ ⟨p, hp, rfl⟩, fun hd _ ⟨p, hp, e⟩ ↦ e ▸ hd p hp⟩

/-- **Phases 4–7 on the viewed pairs** (`specKgS` with `kgSpecS` at the view accessors; KS13: `Pk = xl = 9`,
lvm2 roll 8, B1; roll 7: `10 10`). -/
noncomputable def specKgS₂ (x : List UInt8) (R : Pair → Prop) (T : ℝ≥0∞) (hT : T ≤ εS) :
    Spec (kgProgS (hdX x).s (pubX x).n) (Doomed candPairs (fun p ↦ GkS x (vp x p) ∧ R p))
      (fun k h ↦ Doomed candPairs (fun p ↦ KcS k (vp x p) ∧ R p) h) εS LkSJ T :=
  have e := kg_errsJ2
  have s := kg_struct
  (kgSpecS (C := candPairs) (L₀ := 37696) (εmax := εS) (T := T) candPairs_stable candPairs_ncard_le
    (hdX x).s (pubX x).n 9 9 ksY2 (by norm_num) (Lvm.contRows Lvm.P20) s.2.2.1 s.2.2.2
    (fun q ↦ colM (vp x q).1) (fun q ↦ colM (vp x q).1) (fun q ↦ ksCol (vp x q).1) (fun q ↦ msgM q.2)
    (fun q ↦ msgX (vp x q).1) R e.1 e.2.1 e.2.2.1 e.2.2.2.1 hT).mono
    (fun _ hd ↦ Doomed.mono hd fun q ⟨ht, hk, hb⟩ ↦
      ⟨⟨by rw [pubX_n x] at ht; exact ht, hk⟩, hb⟩)
    (fun _ _ hp ↦ Doomed.mono hp.2 fun _ hq ↦ ⟨hq.1.1, hq.1.2, hq.2⟩) le_rfl le_rfl le_rfl

/-- `OpenPostR` reads `Good` at the statement only. -/
theorem openPostR_congr {G G' : GoodRel} {x : List UInt8} {cl : OpenClaims} {h : List Ev}
    (hG : ∀ qm qr, G x qm qr ↔ G' x qm qr) : OpenPostR G x cl h ↔ OpenPostR G' x cl h :=
  ⟨fun ⟨h1, h2⟩ ↦ ⟨fun p hp hng ↦ h1 p hp fun hg ↦ hng ((hG _ _).mp hg), h2⟩,
    fun ⟨h1, h2⟩ ↦ ⟨fun p hp hng ↦ h1 p hp fun hg ↦ hng ((hG _ _).mpr hg), h2⟩⟩

/-! ## The native form (V_S's `decideProg`, the circuit's `decideF`; CR-S0 follow-up, G0 interface)

* **`relocF`**, **`onStackZF c t`**: `onStackZ` over `FE` on a native stack claim, with the tail value `t`
  given (the E side's `relocE` and `onStackZ` transcribed; the point is padded to `ν = 23` coordinates on any
  list, so a region that a block misses contributes exactly `0`);
* **`onStackZB c t`**: V_S's per-`BlockClaim` form, skipping the regions the block does not meet (`meets`;
  `onStackZB_eq`: the same function for an aligned block inside the stack, `InStack`);
* **`tailValueF`** (the cube sum over `FE`) and its **closed forms per claim kind**, which V_S computes
  and the circuit targets (values only): a `D` point claim at `r ‖ sel(l)` (`tailDF`), `D`'s boundary
  claims (`0`), the tape's ring claim (`ringTailF`, per Frobenius term `tailPtF (pt^(2^k))`), a claim on
  a block from word `2^22` (`0`), a `sumClaim` of such parts (`0`);
* **the transfer**: `tailValue_rel` (`tailValue` of the related `E` claim is the native one's image),
  `onStackZF_rel`, `onStackZB_rel`, and the list form `onStackZsF_rel` that `ref_dMid` takes (native claims
  carrying their tail values, `CRel` to `assembleS`'s, then `onStackZs`). -/

/-- The cube point of index `a` over `FE` (`boolPoint`'s twin). -/
def boolPointF (μ a : ℕ) : List FE := (List.range μ).map fun i ↦ if a.testBit i then 1 else 0

set_option maxRecDepth 100000 in
/-- `tailValue` over `FE`: the mass of a big-stack weight on `D`'s tail times `z*`. -/
def tailValueF (w : List FE → FE) : FE :=
  ∑ a ∈ (Finset.range (2 ^ 22)).filter (fun a ↦ 2 ^ 18 ≤ a % 2 ^ 20),
    w (boolPointF CMain.nu20 a) * zStarF (a / 2 ^ 20)

/-! ### Tail values in closed form -/

/-- `tailValueF` is `LvmShapeVT`'s `tailSum` (`boolPointF` is `cubePt`). -/
theorem tailValueF_eq (w : List FE → FE) : tailValueF w = tailSum w := rfl

/-- **`zStarF` is `z*_l`** (`zStarsF`: lane `l` of `Keccak-f(0)`). -/
theorem zStarF_eq (l : ℕ) : zStarF l = FE.ofK (Lvm.FK.ofBF64 (zStar l)) := by
  unfold zStarF zStarsF zStar LeanVM.Protocol.KeccakGkr.laneWord LeanVM.Semantics.Keccak.lane
    Lvm.KSponge.zeroSt
  generalize (LeanVM.Semantics.keccakF1600 (Vector.replicate 25 0)).toArray = s
  rw [Array.getD_eq_getD_getElem?, Array.getD_eq_getD_getElem?, Array.getElem?_map]
  cases s[l]? <;> rfl

/-- `D`'s block at `P20`. -/
theorem dBlock_P20 : Lvm.dBlock Lvm.P20 = ⟨22, 0⟩ := by decide +kernel

/-- **A `D` point claim** (`tapeClaims`' `D̃_l(r) = a_l`). -/
theorem tailValueF_pointD (r : List FE) (hr : r.length = 20) (l : ℕ) (hl : l < 4) (v : FE) :
    tailValueF (Lvm.BlockClaim.point (Lvm.dBlock Lvm.P20) (r ++ Lvm.selectorPoint l 2) v).onStack.1 =
      tailDF r l := by
  rw [tailValueF_eq, dBlock_P20, tailSum_point 22 0 _ (by simp [hr, Lvm.selectorPoint]) (by norm_num),
    Nat.zero_shiftRight]
  exact tailPtF_D r hr l hl

/-- **`D`'s boundary claims** (`D̃_l(bits(n − 1)) = h_l`, `n ≤ 2^18`): no tail. -/
theorem tailValueF_bnd (m : ℕ) (hm : m < 2 ^ 18) (l : ℕ) (hl : l < 4) (v : FE) :
    tailValueF (Lvm.BlockClaim.point (Lvm.dBlock Lvm.P20)
      (Lvm.selectorPoint m 20 ++ Lvm.selectorPoint l 2) v).onStack.1 = 0 := by
  rw [tailValueF_eq, dBlock_P20, tailSum_point 22 0 _ (by simp [Lvm.selectorPoint]) (by norm_num),
    Nat.zero_shiftRight]
  exact tailPtF_bnd m hm l

/-- **The tape's ring claim** on `⟨ν, 0⟩` (`ringSwitch`'s weight at `pt`, coefficients `cs`). -/
theorem tailValueF_ring (pt cs : List FE) (hpt : pt.length = CMain.nu20) (v : FE) :
    tailValueF (⟨⟨CMain.nu20, 0⟩, fun y ↦ Lvm.ringWeight pt y cs, v⟩ : Lvm.BlockClaim).onStack.1 =
      ringTailF pt cs := by
  rw [tailValueF_eq]
  exact tailSum_ring pt cs hpt v

/-- **V_S's ring tail is `ringTailF`** (`ringTailN` squares the six coordinates `tailPtF` reads). -/
theorem ringTailN_eq (pt cs : List FE) : ringTailN pt cs = ringTailF pt cs :=
  ringTailN_eq' pt cs

/-- **A claim on a block from word `2^22`** (tables, `KS`, `KSY2`, `X`, `KS`'s Keccak claims): no tail. -/
theorem tailValueF_off (c : Lvm.BlockClaim) (hb : 2 ^ 22 ≤ c.block.index)
    (hv : c.block.variableCount ≤ 22) (hlt : c.block.index < 2 ^ CMain.nu20) :
    tailValueF c.onStack.1 = 0 := by
  rw [tailValueF_eq]
  exact tailSum_off c hb hv hlt

/-- **A sum of such parts on `⟨ν, 0⟩`** (the `KS` link's `yC`, `inC`, `xC`): no tail. -/
theorem tailValueF_sum (parts : List (FE × Lvm.Placement × List FE)) (v : FE)
    (hp : ∀ p ∈ parts, 2 ^ 22 ≤ p.2.1.index ∧ p.2.1.variableCount ≤ 22 ∧ p.2.1.index < 2 ^ CMain.nu20) :
    tailValueF (Lvm.sumClaim CMain.nu20 parts v).onStack.1 = 0 := by
  rw [tailValueF_eq]
  exact tailSum_sum parts v hp

/-! ### Transfer to the `E` side -/

theorem map_boolPointF (μ a : ℕ) : (boolPointF μ a).map FE.toExt3 = boolPoint μ a := by
  simp [boolPointF, boolPoint, List.map_map, Function.comp_def, apply_ite FE.toExt3]

theorem ofK_zStar (l : ℕ) : ofK (zStar l) = FE.toExt3 (zStarF l) := by
  rw [zStarF_eq, Lvm.M3.tE_ofK, Lvm.M3.kE_eq]; rfl

theorem relocE_map (xs : List FE) (r : ℕ × ℕ × ℕ) :
    relocE (xs.map FE.toExt3) r = (relocF xs r).map FE.toExt3 := by
  simp only [relocE, relocF, List.map_append, List.map_take, List.map_replicate, List.map_tail,
    FE.toExt3_zero, map_selectorPoint]

/-- **The tail of related claims**: `tailValue` reads the weight on the cube only. -/
theorem tailValue_rel {c : Lvm.StackClaim} {c' : VStackClaim} (h : SCRel c c') :
    tailValue c'.1 = FE.toExt3 (tailValueF c.1) := by
  rw [tailValueF, ← FE.ringEquivExt3_apply, map_sum]
  refine Finset.sum_congr rfl fun a _ ↦ ?_
  rw [FE.ringEquivExt3_apply, FE.toExt3_mul, ← h.2, map_boolPointF, ofK_zStar]

/-- **`onStackZF` relates to `onStackZ`** when `t` is the native claim's tail. -/
theorem onStackZF_rel {c : Lvm.StackClaim} {c' : VStackClaim} (h : SCRel c c') {t : FE}
    (ht : t = tailValueF c.1) : SCRel (onStackZF c t) (onStackZ c') := by
  refine ⟨?_, fun xs ↦ ?_⟩
  · simp only [onStackZ, onStackZF, h.1, tailValue_rel h, ht, FE.toExt3_sub]
  · simp only [onStackZ, onStackZF, FE.toExt3_mul, FE.toExt3_sub, FE.toExt3_one, headD_map_toExt3]
    congr 1
    rw [← FE.ringEquivExt3_apply, map_list_sum, List.map_map]
    refine congrArg List.sum (List.map_congr_left fun r _ ↦ ?_)
    simp only [Function.comp_apply, FE.ringEquivExt3_apply, FE.toExt3_mul, relocE_map, h.2,
      ← List.map_tail]
    rw [toExt3_eqAbove]; rfl

/-- **Skipping is exact**: a region an aligned block misses differs from it in a selector bit at or above
both windows, so its term is `0` on every list. -/
theorem onStackZB_eq (c : Lvm.BlockClaim) (t : FE) (hb : InStack c.block) :
    onStackZB c t = onStackZF c.onStack t := by
  unfold onStackZB onStackZF
  refine Prod.ext (funext fun x ↦ ?_) rfl
  dsimp only
  rw [sum_filter_eq]
  intro r hr hm
  simp only [Lvm.BlockClaim.onStack, eqAbove_relocF_eq_zero c.block hb x hr hm, zero_mul, mul_zero]

/-- **V_S's small claim relates to `onStackZ`** (`onStackZB_eq`, `onStackZF_rel`). -/
theorem onStackZB_rel {c : Lvm.BlockClaim} {c' : VStackClaim} (h : SCRel c.onStack c')
    (hb : InStack c.block) {t : FE} (ht : t = tailValueF c.onStack.1) :
    SCRel (onStackZB c t) (onStackZ c') := by
  rw [onStackZB_eq c t hb]; exact onStackZF_rel h ht

/-- **The list form for `ref_dMid`**: native claims carrying tail values, `CRel`-related (without the
tails) to `assembleS`'s list; `C_main`'s stack claims relate to `onStackZs` of `assembleS`'s. -/
theorem onStackZsF_rel {l : List (Com × Lvm.BlockClaim × FE)} {l' : List (Com × BClaim)}
    (h : List.Forall₂ CRel (l.map fun e ↦ (e.1, e.2.1)) l') (x : List UInt8) {s : Bool}
    (hs : s = small x)
    (ht : s = true → ∀ e ∈ l, e.1 = .main → InStack e.2.1.block ∧ e.2.2 = tailValueF e.2.1.onStack.1) :
    List.Forall₂ SCRel (onStackZsF s ((l.filter (·.1 == .main)).map (·.2)))
      (onStackZs x ((l'.filter (·.1 == .main)).map (·.2.onStack))) := by
  unfold onStackZsF onStackZs
  rw [← hs]
  cases s
  · simp only [Bool.false_eq_true, ↓reduceIte]
    simpa [List.map_map, Function.comp_def] using
      forall₂_main_map h (fun e ↦ e.1.onStack) BClaim.onStack fun _ _ _ _ hb ↦ onStack_rel hb
  · simp only [↓reduceIte]
    simpa [List.map_map, Function.comp_def] using
      forall₂_main_map h (fun e ↦ onStackZB e.1 e.2) (fun b ↦ onStackZ b.onStack)
        fun e he hm _ hb ↦ onStackZB_rel (onStack_rel hb) (ht rfl e he hm).1 (ht rfl e he hm).2

end Lvm.Shape
