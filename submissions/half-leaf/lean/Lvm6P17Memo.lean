/-- **The operations of `P17`'s schedule are `opsP17`.** -/
theorem opsOf_P17 : opsOf P17.levs (sched6 P17) = opsP17 := by
  rw [sched6_P17_eq]
  exact Memo.eq_of_beq (by decide +kernel)

end Lvm6

namespace Lvm6.Q

/-- **CA's walk and WP-S's counts agree at `P17`**, and every query fits `queryCap`. -/
theorem planOf_P17 :
    walkOK (lvOf Lvm6.P17) (itsOf Lvm6.P17) = true ∧ refsOK (planOf Lvm6.P17) = true ∧
      (planOf Lvm6.P17).length = qSOf P17 ∧
      bodyBytes (walk (lvOf Lvm6.P17) w06 (itsOf Lvm6.P17)).1 = bodyLen P17 ∧
      (planOf Lvm6.P17).all (fun e => decide (e.len ≤ RecursionFast.queryCap)) = true := by
  have hw : (walk (lvOf Lvm6.P17) w06 (itsOf Lvm6.P17)).1 = planP17.drop 2 := by
    rw [← planOf_P17_eq]
    rfl
  have hb : bodyLen P17 = 229600 := by
    have h1 : Lvm6.hdrLen P17 + bodyLen P17 = 230424 := piLen_P17
    have h2 : Lvm6.hdrLen P17 = 824 := seedLen_P17.2
    omega
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · show walkOK (lvOf Lvm6.P17) (itsOf Lvm6.P17) = true
    unfold itsOf
    rw [sched6_P17_eq]
    decide +kernel
  · show refsOK (planOf Lvm6.P17) = true
    rw [planOf_P17_eq]
    decide +kernel
  · show (planOf Lvm6.P17).length = qSOf P17
    rw [planOf_P17_eq, qS_P17]
    decide +kernel
  · show bodyBytes (walk (lvOf Lvm6.P17) w06 (itsOf Lvm6.P17)).1 = bodyLen P17
    rw [hw, hb]
    decide +kernel
  · show (planOf Lvm6.P17).all (fun e => decide (e.len ≤ RecursionFast.queryCap)) = true
    rw [planOf_P17_eq]
    decide +kernel

end Lvm6.Q
