/-
  Lvm6Params: the frozen parameters of the lvm6 entry (WP-PARAM) and kernel checks of their ledger.

  Generated by `docs/lvm6/wp/PARAM/param6.py`; do not edit. Every number below is a constant: the
  prover and `V` read them, nothing is derived at run time (P1 §5).

  `jl`, `bigM`, `sixSum`, `admissibleFast`, `roundN`, `roundD`, `roundA`, `qE` and `foldRoundOK`
  have the bodies of leanVM's `formal/lean_vm/LeanVM/Protocol/ToArkLib/Whir/{JohnsonCount,
  AffineCombinerParams, AffineCombinerDeployed}.lean` (leanVM fdb317982, MIT OR Apache-2.0), so the
  checks here are definitionally those of `foldRoundOK_sound` (WP-M1's `Lvm6AffDeployed`). The witnesses
  `(m, D, B)` come from an exact-arithmetic search: at leanVM's own target they can differ from leanVM's
  `foldTable` in `B` where leanVM's f64 steering sees a tie; each one passes `foldRoundOK` here.

  Ledger form (season 1): a group with error `c/|E|` after a `g`-bit grind is admitted iff
  `8 c ≤ 7 2^g` (`c 2^-g / 2^128 ≤ 7 2^-131 = εI`); `εFS ≤ 0 + (εI + 2^-132) + 2^-139 ≤ 2^-128`.
-/
import Mathlib.Basic.NNReal.Basic
import Mathlib.Tactic.NormNum

namespace Lvm6.Params17

/-! ## leanVM's fold-round check (bodies as in leanVM's formal tree) -/

/-- Johnson list bound (leanVM `jl`). -/
def jl (n a r : ℕ) : ℕ := n * (a - r) / (a * a - n * r)

/-- `M = min(D, ⌊(mA − D − 1)/d⌋)` (leanVM `bigM`). -/
def bigM (d A m D : ℕ) : ℕ := min D ((m * A - D - 1) / d)

/-- `|E| = 2^128`. -/
abbrev qE : ℕ := 2 ^ 128

def roundN (κ R : ℕ) : ℕ := 2 ^ (κ + R)
def roundD (κ k : ℕ) : ℕ := 2 ^ κ - 1 + k
def roundA (k Aend j : ℕ) : ℕ := Aend - (k - j)

/-- Six times `Σ_{j ≤ N} (c − d j)(e − j)`, in closed form. -/
def sixSum (c d e N : ℕ) : ℤ :=
  6 * c * e * (N + 1) + d * N * (N + 1) * (2 * N + 1) - 3 * (c + d * e) * N * (N + 1)

/-- leanVM's `admissibleFast`. -/
def admissibleFast (n d A m D B : ℕ) : Bool :=
  let M := bigM d A m D
  decide (1 ≤ d) && decide (A ≤ n) && decide (1 ≤ m) && decide (1 ≤ M) &&
    decide ((n : ℤ) * sixSum m 1 (D + 1) (min (m - 1) M) < sixSum (m * A - D) d (D + 1) M) &&
    decide (d + 1 < B) && decide (B < A) && decide (n * (d + 1) < B * B)

/-- leanVM's `foldRoundOK`: round `j` of a level `(κ, R, k, Aend)` with witness `(m, D, B)` has escape
count `q·ε_aff + 2 jl(A−1)` at most `budget` (out of `q`). -/
def foldRoundOK (κ R k Aend j m D B budget : ℕ) : Bool :=
  let n := roundN κ R
  let d := roundD κ k
  let A := roundA k Aend j
  admissibleFast n d A m D B && decide (n * d < (A - 1) * (A - 1)) &&
    decide (n * (n - 1) / 2 ≤ qE) &&
    decide (jl n B (d + 1) + 2 * jl n (A - 1) d ≤ budget) &&
    decide (D ^ 2 * (A - B) ^ 2 + 4 * d ^ 2 * bigM d A m D ^ 2 * D ^ 3 * n ^ 2 ≤
      (budget - jl n B (d + 1) - 2 * jl n (A - 1) d) * qE * (A - B) ^ 2)

/-! ## The admission rule -/

/-- A group of error `c/|E|` after a `g`-bit grind fits `εI = 7·2^-131`: `8 c ≤ 7·2^g`. -/
def admits (c g : ℕ) : Bool := decide (8 * c ≤ 7 * 2 ^ g)

/-- The fold budget at grind `g ≥ 3`: `7·2^(g−3)` escapes out of `q`. -/
def foldBudget (g : ℕ) : ℕ := 7 * 2 ^ (g - 3)


/-! ## The constants -/

/-- `M`: the stack `q : cube(24) → K`. -/
