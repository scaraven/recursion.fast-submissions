/-- Level 0's inverse-rate exponent (rate 1/4). -/
def rate0 : ℕ := 2

/-- Variables left after the last level (the final polynomial has `2^2 + 4` coefficients). -/
def residualLog : ℕ := 2

/-- Occupied lanes of a level-0 leaf. -/
def leaf0Lanes : ℕ := 46

/-- Bound on the stacked claims `λ₀` batches (`J₀`): `V_S` must reject a proof that would batch more. -/
def stackedClaims : ℕ := 1024

/-- Two ring switches (tree, sponge), each leanVM's `RING_SWITCH_ERROR_NUMERATOR = 2`. -/
def ringSwitchNumerator : ℕ := 4

/-- Level 0's list cap (leanVM `MAX_LIST_0`). -/
def maxList0 : ℕ := 166

