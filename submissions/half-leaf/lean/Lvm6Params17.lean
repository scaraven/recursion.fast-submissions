/-! ## The checks -/

/-- Round `j`'s check at its level's fold budget. -/
def levelRoundsOK (lv : ℕ × ℕ × ℕ × ℕ × List (ℕ × ℕ × ℕ)) (g : ℕ) : Bool :=
  decide (3 ≤ g) && lv.2.2.2.2.length == lv.2.2.1 &&
    lv.2.2.2.2.zipIdx.all fun wi ↦
      foldRoundOK lv.1 lv.2.1 lv.2.2.1 lv.2.2.2.1 (wi.2 + 1) wi.1.1 wi.1.2.1 wi.1.2.2 (foldBudget g)

/-- The list terms of a level (leanVM `check_list_terms`): the start agreement `Aend − k` is above the
Johnson radius, the OOD row `C(ℓ, 2)·μ` fits its grind, and at level 0 the list is at most `maxList0`
and the batching row `(J₀ + 4 − 1)·ℓ` (two ring-switch maps) fits the batch grind. `μ = κ + k`. -/
def listOK (first : Bool) (lv : ℕ × ℕ × ℕ × ℕ × List (ℕ × ℕ × ℕ)) (gOod : ℕ) : Bool :=
  let κ := lv.1; let R := lv.2.1; let k := lv.2.2.1; let A0 := lv.2.2.2.1 - k
  let n := roundN κ R; let d := roundD κ k; let ℓ := jl n A0 d
  decide (n * d < A0 * A0) && admits (ℓ * (ℓ - 1) / 2 * (κ + k)) gOod &&
    (!first || (decide (ℓ ≤ maxList0) && admits ((stackedClaims + ringSwitchNumerator - 1) * ℓ) batchGrind))

/-- The list `ℓ(Aend − k, d)` of a level. -/
def listOf (lv : ℕ × ℕ × ℕ × ℕ × List (ℕ × ℕ × ℕ)) : ℕ :=
  jl (roundN lv.1 lv.2.1) (lv.2.2.2.1 - lv.2.2.1) (roundD lv.1 lv.2.2.1)

/-- The query message with `w` queries (leanVM `query_message_holds`, admission form):
`8·(A−1)^w·2^128 + 8·(w+1)·ℓ'·n^w ≤ 7·2^g·n^w`. -/
def queryMsgOK (κ R Aend w ℓ' g : ℕ) : Bool :=
  let n := roundN κ R
  decide (8 * (Aend - 1) ^ w * qE + 8 * (w + 1) * ℓ' * n ^ w ≤ 7 * 2 ^ g * n ^ w)

/-- Level `i`'s queries clear the message, and one fewer would not (the count is leanVM's least). -/
def queryOK (lv : ℕ × ℕ × ℕ × ℕ × List (ℕ × ℕ × ℕ)) (w ℓ' g : ℕ) : Bool :=
  queryMsgOK lv.1 lv.2.1 lv.2.2.2.1 w ℓ' g && decide (w ≤ roundN lv.1 lv.2.1) &&
    (w == 1 || !queryMsgOK lv.1 lv.2.1 lv.2.2.2.1 (w - 1) ℓ' g)

/-- The ladder (leanVM `derive_ladder_shape`): level 0 folds 6 of `M`, later levels 4; the rate exponent
rises by `k − 3` after level 0 and `k − 1` after; at most 5 variables remain. -/
def shapeOK : Bool :=
  match levels with
  | [] => false
  | l0 :: _ =>
    decide (l0.1 + l0.2.2.1 = stackLog) && decide (l0.2.1 = rate0) && decide (l0.2.2.1 = 6) &&
    (List.zip levels levels.tail).zipIdx.all (fun p ↦
      let a := p.1.1; let b := p.1.2
      decide (b.2.2.1 = 4) && decide (a.1 = b.1 + b.2.2.1) &&
        decide (b.2.1 = a.2.1 + a.2.2.1 - (if p.2 = 0 then 3 else 1))) &&
    decide ((levels.getLast?.map (·.1)) = some residualLog) && decide (residualLog ≤ 5) &&
    decide (5 < (levels.dropLast.getLast?.map (·.1)).getD 0)

/-- Every WHIR check of the frozen row. -/
def whirOK : Bool :=
  shapeOK && levels.length == queries.length && levels.length == foldGrind.length &&
    levels.length == oodGrind.length && levels.length == queryGrind.length &&
    (List.range levels.length).all fun i ↦
      let lv := levels.getD i (0, 0, 0, 0, [])
      let ℓ' := if i + 1 < levels.length then listOf (levels.getD (i + 1) (0, 0, 0, 0, [])) else 0
      levelRoundsOK lv (foldGrind.getD i 0) && listOK (i == 0) lv (oodGrind.getD i 0) &&
        queryOK lv (queries.getD i 0) ℓ' (queryGrind.getD i 0)

/-- Every non-WHIR group fits `εI` after its grind. -/
def groupsOK : Bool := groups.all fun cg ↦ admits cg.1 cg.2

/-- **The WHIR row is admissible**: every fold round, list term and query message of every level. -/
theorem whir_ok : whirOK = true := by decide +kernel

/-- **Every other round group fits `εI`** after its grind. -/
theorem groups_ok : groupsOK = true := by decide +kernel

/-- `qV` is within the contract's cap `2^16`, and above `FORMAT6.md`'s exact `qS` with margin (F1 restates
it over the schedule's count, `Lvm6.qV_ok_P18`). -/
theorem qV_ok : qV ≤ 2 ^ 16 ∧ qS * 3 / 2 ≤ qV := by decide

/-! ## The ledger in `ℝ≥0` -/

open scoped NNReal

/-- An admitted group's error is at most `εI = 7·2^-131`. -/
theorem group_le_εI {c g : ℕ} (h : admits c g = true) :
    (c : ℝ≥0) * (2 : ℝ≥0)⁻¹ ^ (128 + g) ≤ 7 * (2 : ℝ≥0)⁻¹ ^ 131 := by
  have h' : 8 * c ≤ 7 * 2 ^ g := of_decide_eq_true h
  have h2 : ((8 * c : ℕ) : ℝ≥0) ≤ ((7 * 2 ^ g : ℕ) : ℝ≥0) := by exact_mod_cast h'
  push_cast at h2
  have hp : (0 : ℝ≥0) < (2 : ℝ≥0) ^ (131 + g) := pow_pos (by norm_num) _
  rw [← mul_le_mul_iff_of_pos_right hp]
  have hx : ∀ e : ℕ, (2 : ℝ≥0)⁻¹ ^ e * 2 ^ e = 1 := fun e ↦ by
    rw [← mul_pow, inv_mul_cancel₀ (by norm_num), one_pow]
  have h8 : (2 : ℝ≥0) ^ (131 + g) = 8 * 2 ^ (128 + g) := by
    rw [show 131 + g = 3 + (128 + g) by omega, pow_add]; norm_num
  have e1 : (c : ℝ≥0) * (2 : ℝ≥0)⁻¹ ^ (128 + g) * 2 ^ (131 + g) = 8 * c := by
    rw [h8]
    calc (c : ℝ≥0) * (2 : ℝ≥0)⁻¹ ^ (128 + g) * (8 * 2 ^ (128 + g))
        = 8 * c * ((2 : ℝ≥0)⁻¹ ^ (128 + g) * 2 ^ (128 + g)) := by ring
      _ = 8 * c := by rw [hx, mul_one]
  have e2 : 7 * (2 : ℝ≥0)⁻¹ ^ 131 * 2 ^ (131 + g) = 7 * 2 ^ g := by
    rw [pow_add]
    calc 7 * (2 : ℝ≥0)⁻¹ ^ 131 * (2 ^ 131 * 2 ^ g)
        = 7 * 2 ^ g * ((2 : ℝ≥0)⁻¹ ^ 131 * 2 ^ 131) := by ring
      _ = 7 * 2 ^ g := by rw [hx, mul_one]
  rw [e1, e2]
  exact h2

/-- **The total**: `0 + (7·2^-131 + 2^-132) + 2^-139 ≤ 2^-128` (season 1's `εFS_le_of` premise). -/
theorem ledger_total :
    (0 : ℝ≥0) + (7 * (2 : ℝ≥0)⁻¹ ^ 131 + (2 : ℝ≥0)⁻¹ ^ 132) + (2 : ℝ≥0)⁻¹ ^ 139 ≤ (2 : ℝ≥0)⁻¹ ^ 128 := by
  rw [← NNReal.coe_le_coe]; push_cast; norm_num

end Lvm6.Params17
