section G6_FRNodeRows4AskC

-- New for `flock-recursive` (track SIB): the siblings' generator (`sibTG`) and the closure generator
-- (`TG.close`), below `FRNodeRows4`.

/-!
# The siblings' rows and the closure generator

* **`sibTG`**: IMPC2's sibling rows (`bitTGR`'s sibling half) with the checks their `ATImp` needs made at
  process start: the node item's place (`sibAt`: phase, level, position, depth, item), and, at every kind
  whose depth is active, that the position bit is the cell the decomposition rows give bit
  `(p mod per)·logN + h` of the position's answer, the answer of the P2 phase just before the queries
  phase (`sibPosOk`). A failed check is a failing row.
* **`TG.close`**: `A` closed: it also covers every op that can be an import or a foreign flag, except
  the asks, the `bitOf`s and the replay ops (`isRep`), and gives a failing row at such an op the compile
  made an import that `A` does not cover, or a foreign flag that no class discharges (`zPinT`,
  `stFlagT`); at the first ask it checks that every `bitOf` is followed by a `selectHalf` on it
  (`bitNxAll`). On the honest compile it gives no row. Its residual (the run facts left) is then the replay ops' imports and the
  `felems` auxiliary cells, by definition (`FRNodeRun4C`).
-/

namespace FR
namespace Rev4
open RecursionFast Circ TEval Tpl

/-! ## Siblings -/

/-- The proof's sibling parts (`pSegs`' `fSibs` parts, one per queries phase). -/
def sibSegs : List PSeg := pSegs.filter fun s => s.f == fSibs

/-- **A sibling read's place**: `(phase, level, position, depth, node item)` of the `fSibs` byte `o` (a
32-byte boundary of a queries phase's sibling part, at `seq4`'s ladder). -/
def sibAt (o : ℕ) : Option (ℕ × ℕ × ℕ × ℕ × ℕ) :=
  match sibSegs.find? (fun s => decide (s.st ≤ o ∧ o < s.st + s.len)) with
  | some s =>
    match (phasesA.getD s.n ("", .seed)).2 with
    | .queries i =>
      let sib := (seq4.lv i).sib
      let d := o - s.st
      if d % 32 = 0 ∧ 0 < sib then
        some (s.n, i, d / 32 / sib, d / 32 % sib, phIxA.getD s.n 0 + (1 + sib) * (d / 32 / sib) + 1 + d / 32 % sib)
      else none
    | _ => none
  | none => none

/-- **The position bit under kind `ι`** (queries phase `n`, level `i`, position `p`, depth `h`): where the
depth is active, phase `n − 1` squeezes the level's position answers, and the position cell is the cell
of bit `(p mod per)·logN + h` of answer `p / per` (`ansCell`). -/
def sibPosOk (T : BTab) (n i p h : ℕ) (ι : Kind) : Bool :=
  let K := T.lvl ι i
  if h < K.sib then
    match (phasesA.getD (n - 1) ("", .seed)).2 with
    | .squeezes sq (.pos i') =>
      decide (1 ≤ n ∧ i' = i ∧ p / K.per < sq) &&
        T.ansCell ι (phIxA.getD (n - 1) 0 + p / K.per) ((p % K.per) * K.logN + h) == some (posCell i p h)
    | _ => false
  else true

/-- **A sibling's rows**: per half `c`, `b·(A₁(l_c) − A₁(r_c)) = sib_c − A₁(r_c)` (`b` the position bit,
`l`, `r` the node query's halves on arena₁), and `g·sib_c = 0` at the kinds whose depth `h` is inactive;
a failing row unless the item is the node query, the operand a digest, the item not in the segment's
last block and every kind's position bit placed (`sibPosOk`). -/
def sibRowsS (T : BTab) (P : Params) (π : ℕ) (sl : List Slot) (n i p h k : ℕ) : List Row :=
  match itemsT[k]?, sl with
  | some (.node i' h'), [some (.d, [s₀, s₁])] =>
    if i' = i ∧ h' = h ∧ 1 + offT.getD k 0 + (Item.node i h).slen + 64 ≤ N4c.segB ∧
        kinds.all (sibPosOk T n i p h) then
      let q := qElT k (.node i h)
      let b := Lin.cell (bitC π (posCell i p h))
      let ina : KC Bool := fun ι => decide ((T.lvl ι i).sib ≤ h)
      let pr := fun (s : Lin) (c : ℕ) =>
        (⟨b, subN (Lin.cell (arC π (q + c))) (Lin.cell (arC π (q + 2 + c))),
          subN s (Lin.cell (arC π (q + 2 + c)))⟩ : Row)
      [pr s₀ 0, pr s₁ 1] ++
        (if kinds.any ina then [⟨gateS P ina, s₀, []⟩, ⟨gateS P ina, s₁, []⟩] else [])
    else [failRT P]
  | _, _ => [failRT P]

/-- **The sibling reads** (`piDigest`s `sibAt` places). -/
def sibCov : Op → Bool
  | .piDigest f o => (sibAt (absOff f o)).isSome
  | _ => false

/-- **The siblings' generator** of prototype `π` (extension `X`, the template-free context). -/
def sibTG (X : Ext) (π : ℕ) (T : BTab) : TG :=
  ⟨sibCov, fun P cs _ op _ =>
    match op with
    | .piDigest f o =>
      match sibAt (absOff f o) with
      | some (n, i, p, h, k) => sibRowsS T P π (stepOut X P cs op).slots n i p h k
      | none => []
    | _ => []⟩

/-! ## The closure -/

/-- **The replay ops** (C1/R3/C1b's templates; REPF covers prototype 0's, SEG-R decides prototype 1's):
left to the residual. -/
def isRep : Op → Bool
  | .shiftTarget .. | .linkWAll .. | .rsWeight .. | .targetS .. | .evalL .. | .evalM .. => true
  | _ => false

/-- Whether an op is a `bitOf`. -/
def isBitOf : Op → Bool
  | .bitOf .. => true
  | _ => false

/-- **The ops `opOut` makes imports** (`opImp_eq`). -/
def opImp : Op → Bool
  | .input _ | .piElem .. | .piElemK .. | .piDigest .. | .piDigestAt .. | .askSeed _ | .askAbsorb ..
  | .askSqueeze _ | .askNode .. | .askCol .. | .chF .. | .chK _ | .bitOf .. | .walkAB .. | .phiRS ..
  | .shiftTarget .. | .slotW .. | .kindFoldWeight .. | .eqZ .. | .rsWeight .. | .lagrangeS .. | .targetS ..
  | .tensorW .. | .dotKF .. | .evalM .. | .evalL .. | .hashStmt _ | .eqPt .. | .shiftEq .. | .linkWAll ..
  | .shiftMask .. | .rowW .. | .kindSel => true
  | _ => false

/-- **The ops `opOut` may make foreign** (`forCap_of`). -/
def forCap : Op → Bool
  | .assertEq .. | .assertZero .. | .assertOneHot .. | .assertBit .. | .eqTableK _ | .kindInd _
  | .maskRows .. => true
  | _ => false

/-- `FRNodeRun4BR.bitNx`, below `FRNodeRows4`: a `bitOf` followed by a `selectHalf` on its result. -/
def bitNxT : Op → List Op → ℕ → Bool
  | .bitOf _ _, .selectHalf b _ _ :: _, n => decide (b = n)
  | _, _, _ => false

/-- **Every `bitOf` of `ops` is followed by a `selectHalf` on it** (`n` the register count; tail-recursive). -/
def bitNxAll : ℕ → List Op → Bool
  | _, [] => true
  | n, op :: ops => (!isBitOf op || bitNxT op ops n) && bitNxAll (n + op.nOut) ops

/-- `FRNodeRows4AskIR.zPin`, below `FRNodeRows4`. -/
def zPinT (pv : List (ℕ × ℕ × ℕ × ℕ)) (p : Op × ℕ) : Bool :=
  match p.1 with
  | .assertZero a _ =>
    match provOf pv a with
    | some (f, o, len) => decide (a < p.2) && winsOk f o len
    | none => false
  | _ => false

/-- `FRNodeRun4BR.stFlag`, below `FRNodeRows4`. -/
def stFlagT (T : BTab) (p : Op × ℕ) : Bool :=
  match T.st, p.1 with
  | some s, .assertEq a b _ =>
    match T.rt.getD a .none, T.rt.getD b .none with
    | .pf o 1, .cb bs => decide (o = s.so ∧ bs.data = #[s.t] ∧ s.t ≠ 0 ∧ a < p.2 ∧ b < p.2)
    | _, _ => false
  | some s, .assertZero a _ =>
    match T.rt.getD a .none with
    | .pf o len => decide (o = s.so + s.z ∧ o + len = s.so + s.L ∧ a < p.2)
    | _ => false
  | _, _ => false

/-- **The ops the closure covers**: the possible imports and foreign flags, less the asks, the `bitOf`s
and the replay ops. -/
def closeCov (op : Op) : Bool :=
  !op.item?.isSome && !isRep op && !isBitOf op && (opImp op || forCap op)

/-- **`opOut`'s foreign flag**, without its rows (`opForeign_eq`). -/
def opForeign (cs : CS) : Op → Bool
  | .assertEq a b act =>
    if offK act then false else
    match (cs.slot a).ty?, (cs.slot b).ty? with
    | some _, some _ => false
    | _, _ => true
  | .assertZero a act => if offK act then false else (cs.slot a).ty?.isNone
  | .assertOneHot a b c => !((cs.slot a).isSome && (cs.slot b).isSome && (cs.slot c).isSome)
  | .assertBit .. | .eqTableK _ | .kindInd _ | .maskRows .. => true
  | _ => false

/-- **The ops a template may take** (`tplExt4`'s: `extCan_none`). -/
def extCan : Op → Bool
  | .eqPt .. | .shiftEq .. | .phiRS .. | .kindFoldWeight .. | .shiftMask .. | .walkAB .. | .slotW ..
  | .maskRows .. | .eqZ .. | .lagrangeS .. | .eqTableK _ | .dotKF .. | .rowW .. | .tensorW .. | .keep ..
  | .packFK _ | .getK .. => true
  | _ => false

/-- **The closure's import rows** (at a possible import `A` does not cover): a failing row if the compile
made it an import (no template took it; the extension is asked only at the ops it may take, `extCan`). -/
def impRows (X : Ext) (P : Params) (cs : CS) (op : Op) : List Row :=
  if !extCan op || (X P cs op).isNone then [failRT P] else []

/-- **The closure's flag rows** (at a possible foreign flag): a failing row if it is one (no template,
`opOut`'s flag) that neither the zero pins nor the statement's flags discharge. -/
def forRows (X : Ext) (pv : List (ℕ × ℕ × ℕ × ℕ)) (T : BTab) (P : Params) (cs : CS) (op : Op) : List Row :=
  if opForeign cs op && (!extCan op || (X P cs op).isNone) && !zPinT pv (op, cs.slots.size) &&
      !stFlagT T (op, cs.slots.size) then [failRT P]
  else []

/-- **`A` closed** (`X` the template-free context, `pv` the `piField` registers, `T` the bit tables, `nx`
the program's `bitNxAll`, computed once by the caller): it covers `A`'s ops and the possible imports and
foreign flags (`closeCov`). At a possible import, `A`'s rows if `A` covers it, else `impRows`; at a
possible foreign flag, `A`'s rows (if it covers it) and `forRows`; elsewhere `A`'s rows, and at the first
ask (`k = 0`) a failing row unless `nx` (every `bitOf` is followed by a `selectHalf` on it). `closeCov` is tested first, so that `A`'s cover is evaluated once per
op (`impcTG`'s window test at the proof reads is the costly one). -/
def TG.close (A : TG) (X : Ext) (pv : List (ℕ × ℕ × ℕ × ℕ)) (T : BTab) (nx : Bool) : TG :=
  ⟨fun op => closeCov op || A.cov op, fun P cs pre op k =>
    if closeCov op then
      if opImp op then (if A.cov op then A.rows P cs pre op k else impRows X P cs op)
      else (if A.cov op then A.rows P cs pre op k else []) ++ forRows X pv T P cs op
    else A.rows P cs pre op k ++
      (if k = 0 && op.item?.isSome && !nx then [failRT P] else [])⟩

/-- **`A` failing at the replay ops `rc` does not cover** (SEG-R2; `rc` the replay templates' cover): at a
replay op (`isRep`) neither `A` nor `rc` covers, the failing row; elsewhere `A`'s rows. So the replay ops'
imports left to the run facts (`impQX`) are none (`FRNodeRun4CB.impQX_repF`), and the circuit rejects a
replay op no template replays instead of trusting it. -/
def TG.repF (A : TG) (rc : Op → Bool) : TG :=
  ⟨fun op => A.cov op || (isRep op && !rc op), fun P cs pre op k =>
    if !A.cov op && isRep op && !rc op then [failRT P] else A.rows P cs pre op k⟩

/-- **`B` beside `A`, `A` not asked at `B`'s ops** (`TG.addD` without asking `A` there): for a `B` whose
ops `A` does not cover (the siblings), so that `A`'s cover is not evaluated again at them. -/
def TG.addE (A B : TG) : TG :=
  ⟨fun op => A.cov op || B.cov op, fun P cs pre op k =>
    if B.cov op then B.rows P cs pre op k ++ (if op.item?.isSome then A.rows P cs pre op k else [])
    else A.rows P cs pre op k ++ (if op.item?.isSome then B.rows P cs pre op k else [])⟩

end Rev4
end FR

end G6_FRNodeRows4AskC

section G6_FRVIRTplRepLG

-- New for `flock-recursive` (track CF2): shifted diagonal sums of bit products by a carry automaton.

/-!
# Shifted diagonal sums by a carry automaton

`PF f L x` is a product of per-bit factors over `L` bits (`0` from `2^L`); with
`f l b = if b then t l else 1 − t l` it is `gN L t x`. **`GS fa fb L n A B`** splits
`Σ_{j<n} PF fa L (A + j) · PF fb L (B + j)` at the lowest bit (`j = 2j' + d`): two terms, each the
lowest bit's factors times the same sum one bit up (**`GS_eq`**). At every bit the arguments
`(n, A, B)` reachable from one start are within one of `(⌊n/2^l⌋, ⌊A/2^l⌋, ⌊B/2^l⌋)`, so a
memoized evaluation has at most 8 states per bit and start.

**`autoG`** is that evaluation as gates: per bit (top bit first), the four factor products and two
products per state; **`ok_autoG`**: each start state's form is its `GS` value.
-/

namespace FR
namespace Tpl
open Finset Circ TEval

/-! ## The sums -/

/-- A product of per-bit factors over `L` bits (`0` from `2^L`). -/
def PF (f : ℕ → Bool → F) (L x : ℕ) : F := if x < 2 ^ L then ∏ l ∈ range L, f l (x.testBit l) else 0

/-- The factors one bit up. -/
def shF (f : ℕ → Bool → F) : ℕ → Bool → F := fun l b => f (l + 1) b

theorem PF_zero (f : ℕ → Bool → F) (x : ℕ) : PF f 0 x = if x = 0 then 1 else 0 := by
  unfold PF; simp [Nat.lt_one_iff]

theorem PF_succ (f : ℕ → Bool → F) (L x : ℕ) :
    PF f (L + 1) x = f 0 (decide (x % 2 = 1)) * PF (shF f) L (x / 2) := by
  unfold PF shF
  have h : x < 2 ^ (L + 1) ↔ x / 2 < 2 ^ L := by
    rw [pow_succ, Nat.div_lt_iff_lt_mul (by norm_num)]
  by_cases hx : x / 2 < 2 ^ L
  · rw [if_pos (h.2 hx), if_pos hx, prod_range_succ', mul_comm]
    congr 1
    · rw [Nat.testBit_zero]
    · exact prod_congr rfl fun l _ => by rw [show x / 2 = x / 2 ^ 1 by norm_num, Nat.testBit_div_two_pow]
  · rw [if_neg (mt h.1 hx), if_neg hx, mul_zero]

/-- `gN` is `PF` with `eq` factors. -/
def eqF (t : ℕ → F) : ℕ → Bool → F := fun l b => if b then t l else 1 - t l

theorem gN_PF (L : ℕ) (t : ℕ → F) (x : ℕ) : gN L t x = PF (eqF t) L x := rfl

/-- A sum over `j < n` by parity. -/
theorem sum_parity (g : ℕ → F) : ∀ n : ℕ,
    ∑ j ∈ range n, g j = ∑ j ∈ range ((n + 1) / 2), g (2 * j) + ∑ j ∈ range (n / 2), g (2 * j + 1)
  | 0 => by simp
  | n + 1 => by
    rw [sum_range_succ, sum_parity g n]
    rcases Nat.even_or_odd n with ⟨m, rfl⟩ | ⟨m, rfl⟩
    · rw [show (m + m + 1 + 1) / 2 = m + 1 by omega, show (m + m + 1) / 2 = m by omega,
        show (m + m) / 2 = m by omega, sum_range_succ, show 2 * m = m + m by ring]
      ring
    · rw [show (2 * m + 1 + 1 + 1) / 2 = m + 1 by omega, show (2 * m + 1 + 1) / 2 = m + 1 by omega,
        show (2 * m + 1) / 2 = m by omega, sum_range_succ (fun j => g (2 * j + 1))]
      ring

/-- **The automaton's recursion** (`Σ_{j<n} PF fa L (A+j) · PF fb L (B+j)`, `GS_eq`). -/
def GS (fa fb : ℕ → Bool → F) : ℕ → ℕ → ℕ → ℕ → F
  | 0, n, A, B => if 0 < n ∧ A = 0 ∧ B = 0 then 1 else 0
  | L + 1, n, A, B =>
    fa 0 (decide (A % 2 = 1)) * fb 0 (decide (B % 2 = 1)) * GS (shF fa) (shF fb) L ((n + 1) / 2) (A / 2) (B / 2) +
    fa 0 (decide ((A + 1) % 2 = 1)) * fb 0 (decide ((B + 1) % 2 = 1)) *
      GS (shF fa) (shF fb) L (n / 2) ((A + 1) / 2) ((B + 1) / 2)

theorem GS_zero (fa fb : ℕ → Bool → F) (n A B : ℕ) :
    GS fa fb 0 n A B = ∑ j ∈ range n, PF fa 0 (A + j) * PF fb 0 (B + j) := by
  rw [GS]
  simp only [PF_zero]
  cases n with
  | zero => simp
  | succ n =>
    rw [sum_range_succ']
    have h0 : ∑ j ∈ range n, (if A + (j + 1) = 0 then (1 : F) else 0) * (if B + (j + 1) = 0 then 1 else 0) = 0 :=
      sum_eq_zero fun j _ => by rw [if_neg (by omega), zero_mul]
    rw [h0, zero_add, Nat.add_zero, Nat.add_zero]
    by_cases hA : A = 0 <;> by_cases hB : B = 0 <;> simp [hA, hB]

theorem GS_eq (L : ℕ) : ∀ (fa fb : ℕ → Bool → F) (n A B : ℕ),
    GS fa fb L n A B = ∑ j ∈ range n, PF fa L (A + j) * PF fb L (B + j) := by
  induction L with
  | zero => exact GS_zero
  | succ L ih =>
    intro fa fb n A B
    rw [GS, ih, ih, sum_parity _ n, mul_sum, mul_sum]
    refine congrArg₂ (· + ·) ?_ ?_
    · refine sum_congr rfl fun j _ => ?_
      have e1 : (A + 2 * j) % 2 = A % 2 := by omega
      have e2 : (B + 2 * j) % 2 = B % 2 := by omega
      have e3 : (A + 2 * j) / 2 = A / 2 + j := by omega
      have e4 : (B + 2 * j) / 2 = B / 2 + j := by omega
      rw [PF_succ, PF_succ, e1, e2, e3, e4]
      ring
    · refine sum_congr rfl fun j _ => ?_
      have e1 : (A + (2 * j + 1)) % 2 = (A + 1) % 2 := by omega
      have e2 : (B + (2 * j + 1)) % 2 = (B + 1) % 2 := by omega
      have e3 : (A + (2 * j + 1)) / 2 = (A + 1) / 2 + j := by omega
      have e4 : (B + (2 * j + 1)) / 2 = (B + 1) / 2 + j := by omega
      rw [PF_succ, PF_succ, e1, e2, e3, e4]
      ring

/-! ## The automaton as gates -/

/-- A state `(n, A, B)`. -/
abbrev St := ℕ × ℕ × ℕ

/-- The next bit's states (`d = 0`, `d = 1`). -/
def ch0 (s : St) : St := ((s.1 + 1) / 2, s.2.1 / 2, s.2.2 / 2)
def ch1 (s : St) : St := (s.1 / 2, (s.2.1 + 1) / 2, (s.2.2 + 1) / 2)

/-- The states one bit up (without repeats). -/
def kids (S : List St) : List St := (S.flatMap fun s => [ch0 s, ch1 s]).dedup

theorem ch0_kids {S : List St} {s : St} (h : s ∈ S) : ch0 s ∈ kids S :=
  List.mem_dedup.2 (List.mem_flatMap.2 ⟨s, h, by simp⟩)

theorem ch1_kids {S : List St} {s : St} (h : s ∈ S) : ch1 s ∈ kids S :=
  List.mem_dedup.2 (List.mem_flatMap.2 ⟨s, h, by simp⟩)

/-- A state's form from the states' forms. -/
def look (S : List St) (vs : List LinT) (s : St) : LinT := vs.getD (S.idxOf s) []

theorem look_ev {S : List St} {vs : List LinT} {v : St → F} (h : vs.map (LinT.ev e) = S.map v) {s : St}
    (hs : s ∈ S) : (look S vs s).ev e = v s := by
  have hl : vs.length = S.length := by simpa using congrArg List.length h
  have hi : S.idxOf s < S.length := List.idxOf_lt_length_of_mem hs
  have := congrArg (fun l => l.getD (S.idxOf s) 0) h
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem (hl ▸ hi),
    List.getElem?_eq_getElem hi, Option.map_some, Option.getD_some, List.getElem_idxOf] at this
  rw [look, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (hl ▸ hi), Option.getD_some]
  exact this

/-- The four factor products of the lowest bit, indexed `2 bA + bB`. -/
def prs (qa qb : Bool → LinT) : GM (List LinT) :=
  GM.mapL (fun bb : Bool × Bool => mulF (qa bb.1) (qb bb.2)) [(false, false), (false, true), (true, false), (true, true)]

def prAt (ps : List LinT) (x y : Bool) : LinT := ps.getD (2 * x.toNat + y.toNat) []

/-- **The automaton's gates** (factor forms `qa l b`, `qb l b`; `L` bits; start states `S`): the
states' forms, in `S`'s order. -/
def autoG (qa qb : ℕ → Bool → LinT) : ℕ → List St → GM (List LinT)
  | 0, S => GM.ret (S.map fun s => if 0 < s.1 ∧ s.2.1 = 0 ∧ s.2.2 = 0 then C 1 else [])
  | L + 1, S =>
    (autoG (fun l => qa (l + 1)) (fun l => qb (l + 1)) L (kids S)).bind fun vs =>
    (prs (qa 0) (qb 0)).bind fun ps =>
    GM.mapL (fun s =>
      (mulF (prAt ps (decide (s.2.1 % 2 = 1)) (decide (s.2.2 % 2 = 1))) (look (kids S) vs (ch0 s))).bind fun t0 =>
      (mulF (prAt ps (decide ((s.2.1 + 1) % 2 = 1)) (decide ((s.2.2 + 1) % 2 = 1))) (look (kids S) vs (ch1 s))).map
        fun t1 => t0 ++ t1) S

variable {e : Env}

theorem ok_prs {qa qb : Bool → LinT} {fa fb : Bool → F} (ha : ∀ b, (qa b).ev e = fa b) (hb : ∀ b, (qb b).ev e = fb b) :
    GM.Ok e (prs qa qb) fun ps => ∀ x y, (prAt ps x y).ev e = fa x * fb y := by
  refine GM.ok_mono (GM.ok_mapL (E := LinT.ev e) (v := fun bb : Bool × Bool => fa bb.1 * fb bb.2) _ fun bb _ =>
    GM.ok_mono (ok_mulF _ _) fun o ho => by rw [ho, ha, hb]) fun ps hps x y => ?_
  have h4 : ps.length = 4 := by simpa using congrArg List.length hps
  match ps, h4 with
  | [p0, p1, p2, p3], _ =>
    simp only [List.map_cons, List.map_nil, List.cons.injEq] at hps
    cases x <;> cases y <;> simp [prAt, hps]

/-- **The automaton computes `GS`** at every start state. -/
theorem ok_autoG (h1 : e.one = 1) : ∀ (L : ℕ) (qa qb : ℕ → Bool → LinT) (fa fb : ℕ → Bool → F) (S : List St),
    (∀ l b, (qa l b).ev e = fa l b) → (∀ l b, (qb l b).ev e = fb l b) →
      GM.Ok e (autoG qa qb L S) fun vs => vs.map (LinT.ev e) = S.map fun s => GS fa fb L s.1 s.2.1 s.2.2
  | 0, qa, qb, fa, fb, S, _, _ => GM.ok_ret (by
    simp only [List.map_map]
    refine List.map_congr_left fun s _ => ?_
    simp only [Function.comp_apply, GS]
    split_ifs <;> simp [h1])
  | L + 1, qa, qb, fa, fb, S, ha, hb => by
    refine GM.ok_bind (ok_autoG h1 L _ _ (shF fa) (shF fb) (kids S) (fun l b => ha (l + 1) b)
      (fun l b => hb (l + 1) b)) fun vs hvs => GM.ok_bind (ok_prs (ha 0) (hb 0)) fun ps hps => ?_
    refine GM.ok_mapL _ fun s hs => GM.ok_bind (ok_mulF _ _) fun t0 ht0 =>
      GM.ok_map (ok_mulF _ _) fun t1 ht1 => ?_
    rw [ev_append, ht0, ht1, hps, hps, look_ev hvs (ch0_kids hs), look_ev hvs (ch1_kids hs), GS]
    rfl

end Tpl
end FR

end G6_FRVIRTplRepLG

section G6_FRVIRTplRepLD

-- New for `flock-recursive` (PACK-4.4 §6.2, R1's route (a); track C1b; CF2: the carry automaton).

/-!
# The replay template of a node's `evalL` (`NI4F.evalL4I ν`): definitions

One node kind's sub-template for the previous node's `evalL` (inputs `rL : AF a`, then `r4 : AF b`).
This module holds the definitions only (no import of `FRVerifierImplNode4F`, so the fold into
`nodeIRows4` can import it); `FRVIRTplRepL` proves them.

CF2: every sum is a carry automaton (`autoG`, `FRVIRTplRepLG`; about 20 gates per bit and state)
instead of C1b's `eq` tables and `2 · vslots · nJ` products (319.5 k rows over the three kinds):

* `S_σ = Σ_{j<nJ} eq(rL, σ nJ + j) · eq(r4_lo, 299 + j)` and `E_σ = Σ_{j<nJ} eq(rL, σ nJ + j)`;
* `eq(r4_hi, hb + σ)` and `eq(r4, oneCell)` (`n = 1` automata);
* `Q_σ = eq(r4_hi, hb + σ) · S_σ`, `O = eq(r4, oneCell)`, and one product `(Σ_σ E_σ) · O`.

The outputs are `Σ_σ Q_σ`, `(Σ_σ E_σ) · O − Σ_σ Q_σ` and `0`.
-/

namespace FR
namespace Tpl
open Circ

/-- Declared bits per slot (`NI4F.nJ`, the same numeral). -/
def nJL : ℕ := 266 + 399 + 7552 + 3

/-- The bit factors of an `n`-coordinate block `c` (bit `l`: `c l` or `1 − c l`; past `n`: `0` for a
set bit, `1` otherwise). -/
def qE (c : ℕ → LinT) (n l : ℕ) (bit : Bool) : LinT :=
  if l < n then (if bit then c l else C 1 ++ sc (-1) (c l)) else (if bit then [] else C 1)

/-- The trivial factors. -/
def qO (_ : ℕ) (_ : Bool) : LinT := C 1

section EvL
variable (ν : Rev4.NodeKind) (a b : ℕ)

/-- The high cell block of slot `0`'s bits (`lBase·128 / 2^14`). -/
def evHb : ℕ := ν.lBase * 128 / 2 ^ 14

/-- **The gates and outputs** (inputs `rL : AF a`, then `r4 : AF b`). -/
def evGM : GM (List LinT) :=
  (autoG (qE (cT a) ν.dims.logL) (qE (cR a b) 14) ν.dims.logL
    ((List.range ν.vslots).map fun σ => (nJL, σ * nJL, 299))).bind fun S =>
  (autoG (qE (cT a) ν.dims.logL) qO ν.dims.logL ((List.range ν.vslots).map fun σ => (nJL, σ * nJL, 0))).bind fun E =>
  (autoG (qE (cR a b) 14) qO 14 [(1, ν.oneCell % 2 ^ 14, 0)]).bind fun O1 =>
  (autoG (qE (fun l => cR a b (14 + l)) (ν.m - 7 - 14)) qO (ν.m - 7 - 14)
    (((List.range ν.vslots).map fun σ => (1, evHb ν + σ, 0)) ++ [(1, ν.oneCell / 2 ^ 14, 0)])).bind fun H =>
  (GM.mapL (fun σ => mulF (H.getD σ []) (S.getD σ [])) (List.range ν.vslots)).bind fun Q =>
  (mulF (O1.getD 0 []) (H.getD ν.vslots [])).bind fun O =>
  (mulF E.flatten O).map fun EO => [Q.flatten, EO ++ sc (-1) Q.flatten, []]

end EvL

/-- **The node kind `ν`'s `evalL` template** (inputs `rL : AF a`, then `r4 : AF b`). -/
def tplEvL (ν : Rev4.NodeKind) (a b : ℕ) : Tpl := let g := evGM ν a b 0; ⟨g.1, g.2⟩

theorem tplEvL_outs (ν : Rev4.NodeKind) (a b : ℕ) : (tplEvL ν a b).outs.length = 3 := rfl

end Tpl
end FR

end G6_FRVIRTplRepLD

section G6_FRVIRTplAlias

-- New for `flock-recursive` (stage FEL, design `FEL.md` with review S3): the `dotKF` arm with aliased
-- column cells, as an override of `tplExt4` at `dotKF` only, and its soundness.

/-!
# `tplExt4A`: `tplExt4` with the `dotKF` column cells aliased

`tplExt`'s `dotKF w col` arm gives the template instance fresh auxiliary cells for the column's `n` `F`
elements (`aux := [(cells, col, .felems n)]`), which no row binds. **`tplExt4A F R tc al`** is `tplExt4 F R
tc` at every op but `dotKF`; at `dotKF w col` (with `w`'s slot `.ak n`, the key kept by `F`, `col` an
existing register) it takes the cells `al col n` instead, and **refuses** the op (no template: the compile
makes it an import) where `al col n = none`. The instance's rows, inputs `lw ++ cells` and auxiliary entry
are the arm's, so its soundness is `tplExt_ok`'s `dotKF` case, which uses the cells only through the
auxiliary fact (`dkX_ok`; the `ImplTF` step is void: `dotKF` reads no `OpImpl` field).

* **`tplExt4A_ne`**: at any other op it is `tplExt4`;
* **`tplExt4A_okK`**: sound at the run's kind, as `tplExt4_okK`.
-/

namespace FR
namespace Circ
open Tpl RecursionFast

/-- **The aliased `dotKF` arm**: `w`'s slot `.ak n`, the key `dotKF n` kept, `col` an existing register,
the cells `al col n` (none: refused). -/
def dkA (F : TFilt) (tc : TCtx) (al : ℕ → ℕ → Option (List Lin)) (P : Params) (cs : CS) (w col : ℕ) :
    Option Out :=
  match cs.slot w with
  | some (.ak n, lw) =>
    if F (.dotKF n) = true ∧ col < cs.slots.size then
      (al col n).map fun cells =>
        { tplOut tc P cs (.dotKF n) (lw ++ cells) [.k] with aux := [(cells, col, .felems n)] }
    else none
  | _ => none

/-- **`tplExt4` with the `dotKF` arm aliased** (`al`: a column register and a length to the cells). -/
def tplExt4A (F : TFilt) (R : ShR) (tc : TCtx) (al : ℕ → ℕ → Option (List Lin)) : Ext := fun P cs op =>
  match op with
  | .dotKF w col => dkA F tc al P cs w col
  | _ => tplExt4 F R tc P cs op

/-- The arm alone, as an extension. -/
def dkX (F : TFilt) (tc : TCtx) (al : ℕ → ℕ → Option (List Lin)) : Ext := fun P cs op =>
  match op with
  | .dotKF w col => dkA F tc al P cs w col
  | _ => none

/-- At an op other than `dotKF`, `tplExt4A` is `tplExt4`. -/
theorem tplExt4A_ne {F : TFilt} {R : ShR} {tc : TCtx} {al : ℕ → ℕ → Option (List Lin)} {P : Params}
    {cs : CS} {op : Op} (h : ∀ w col, op ≠ .dotKF w col) : tplExt4A F R tc al P cs op = tplExt4 F R tc P cs op := by
  cases op <;> first | rfl | exact absurd rfl (h _ _)

/-- **What the aliased arm gives**: the cells `al col n`, `col` an existing register, its one auxiliary
entry, no import, not foreign. -/
theorem dkA_some {F : TFilt} {tc : TCtx} {al : ℕ → ℕ → Option (List Lin)} {P : Params} {cs : CS}
    {w col : ℕ} {o : Out} (h : dkA F tc al P cs w col = some o) :
    ∃ n cells, al col n = some cells ∧ col < cs.slots.size ∧ o.aux = [(cells, col, .felems n)] ∧
      o.imp = false ∧ o.foreign = false := by
  unfold dkA at h
  split at h
  · rename_i n lw _
    split_ifs at h with hF
    obtain ⟨cells, hc, rfl⟩ := Option.map_eq_some_iff.1 h
    exact ⟨n, cells, hc, hF.2, rfl, rfl, rfl⟩
  · cases h

/-- **Whether the aliased arm takes an op does not depend on the template bodies.** -/
theorem dkA_isNone (F : TFilt) (tp tp' : TKey → Tpl) (cb : TKey → ℕ → ℕ) (al : ℕ → ℕ → Option (List Lin))
    (P : Params) (cs : CS) (w col : ℕ) :
    (dkA F ⟨tp, cb⟩ al P cs w col).isNone = (dkA F ⟨tp', cb⟩ al P cs w col).isNone := by
  unfold dkA
  split
  · split_ifs <;> simp
  · rfl

/-- **The aliased arm is sound** (`tplExt_ok`'s `dotKF` case, with the cells `al col n`). -/
theorem dkX_ok {impl : OpImpl} (F : TFilt) (L : TLay) (al : ℕ → ℕ → Option (List Lin)) :
    ExtOk impl L.ctx (dkX F L.ctx al) := by
  intro P cs op o hX
  cases op <;> simp only [dkX, reduceCtorEq] at hX
  rename_i w col
  simp only [dkA] at hX
  split at hX
  · rename_i n lw hw
    split_ifs at hX with hF
    obtain ⟨cells, -, rfl⟩ := Option.map_eq_some_iff.1 hX
    refine ⟨rfl, fun κ inp ww regs hP hI => ⟨fun q => by simp [evalOp], fun _ ht hx vs ok he => ?_⟩⟩
    simp only [evalOp, Res.vals.injEq] at he; obtain ⟨rfl, rfl⟩ := he
    refine ⟨fun _ => ?_, fun _ => rfl⟩
    obtain ⟨x, hx', rfl, hxl⟩ := rep_ak (rep_slot hI hw)
    have hc := hx _ (List.mem_singleton_self _)
    simp only [Tpl.AuxK.val] at hc
    rw [hx', dotKFF_eq]
    exact outSlots_one rfl (tplDotKF_ok rfl (inpIs_of (by rw [List.map_append, hxl, hc]; rfl))
      (tin_eqns (tc := L.ctx) (k := .dotKF x.size) (tys := [.k]) hP.1 ht))
  · cases hX

/-- The arm sets no per-kind slot. -/
theorem dkX_kin {F : TFilt} {tc : TCtx} {al : ℕ → ℕ → Option (List Lin)} {P : Params} {cs : CS} {op : Op}
    {o : Out} (h : dkX F tc al P cs op = some o) : o.kin = none := by
  cases op <;> simp only [dkX, reduceCtorEq] at h
  simp only [dkA] at h
  split at h
  · split_ifs at h
    obtain ⟨cells, -, rfl⟩ := Option.map_eq_some_iff.1 h
    rfl
  · cases h

/-- **`tplExt4A` is sound at kind `κ`** (with per-kind slots), under `tplExt4_okK`'s hypotheses. -/
theorem tplExt4A_okK {impl : OpImpl} {F : TFilt} {R : ShR} {κ : Kind} (hT : ImplTF F impl)
    (hR : RouteOk R impl κ) (L : TLay) (al : ℕ → ℕ → Option (List Lin)) :
    ExtOkK impl L.ctx (tplExt4A F R L.ctx al) κ := by
  intro P cs op o h
  by_cases hd : ∃ w col, op = .dotKF w col
  · obtain ⟨w, col, rfl⟩ := hd
    exact ((dkX_ok F L al).at κ).toK (fun _ _ _ _ h => dkX_kin h) P cs _ o h
  · rw [tplExt4A_ne fun w col he => hd ⟨w, col, he⟩] at h
    exact tplExt4_okK hT hR L P cs op o h

/-! ## Controls -/

/-- A context with one empty template per key and cell base `0`. -/
def ctlTC : TCtx := ⟨fun _ => ⟨[], []⟩, fun _ _ => 0⟩

/-- A compile with register `0` of type `ak 2` (forms `[c₀, c₁, c₂, c₃]`) and register `1`. -/
def ctlCSA : CS := { CS.init 10 with slots := #[some (.ak 2, [Lin.cell 0, Lin.cell 1, Lin.cell 2, Lin.cell 3]), none] }

/-- (+) **The alias arm** takes `dotKF 0 1` with the given cells: they are its auxiliary entry and the
instance's inputs follow `w`'s forms; (−) with `al = none` it refuses (no template); (−) a column that is not
yet a register (`5 ≥ 2`) is refused; (−) an op other than `dotKF` is `tplExt4`'s. -/
theorem dkA_ctl :
    ((tplExt4A allK .imp ctlTC (fun _ _ => some [Lin.cell 7, []]) (⟨Lin.cell 0, fun _ => []⟩ : Params) ctlCSA
        (.dotKF 0 1)).map fun o => (o.aux, o.tin)) =
      some ([([Lin.cell 7, []], 1, .felems 2)],
        some (.dotKF 2, [Lin.cell 0, Lin.cell 1, Lin.cell 2, Lin.cell 3, Lin.cell 7, []])) ∧
    (tplExt4A allK .imp ctlTC (fun _ _ => none) (⟨Lin.cell 0, fun _ => []⟩ : Params) ctlCSA (.dotKF 0 1)).isNone ∧
    (tplExt4A allK .imp ctlTC (fun _ _ => some []) (⟨Lin.cell 0, fun _ => []⟩ : Params) ctlCSA (.dotKF 0 5)).isNone ∧
    tplExt4A allK .imp ctlTC (fun _ _ => none) (⟨Lin.cell 0, fun _ => []⟩ : Params) ctlCSA (.eqZ 0 1) =
      tplExt4 allK .imp ctlTC (⟨Lin.cell 0, fun _ => []⟩ : Params) ctlCSA (.eqZ 0 1) := by
  refine ⟨rfl, rfl, rfl, rfl⟩

end Circ
end FR

end G6_FRVIRTplAlias

section G6_FRNodeRows4Defs

-- New for `flock-recursive` (track REPF; C1b-RESULT §5.3): the definitions the node's replay rows
-- need, below `FRNodeRows4`, so that `nodeIRows4` folds them (definitions only, moved verbatim).

/-!
# The prototypes and the replay templates, definitions only

`nodeIRows4` (`FRNodeRows4`) folds the previous node's replay rows (`repIRowsW rtC1c`), whose
definitions lived in modules above `FRNodeRows4` (they import the soundness chain). This module holds
those definitions, moved verbatim with their names and namespaces, so `FRNodeRows4` can name them:

* from `FRNodeRows4`: the moves (`mapC`, `rowMapC`, `mvC`), the slot cells (`selIx`, `oneR`, `selR`,
  `baseR`), the prototypes (`protoP`, `isPrevSlot`, `protoOf`, `protoProg`, `protoLay`, `protoF`,
  `nodeOf`, `maskQ`, `protoR`);
* from `FRNodeRows4Rep*` and `FRNodeRows4RepRsK`, `FRNodeRows4RepLT`: the replay templates (`RT`,
  `repRowsX`, `RT.orElse`, `KOp`, `kRows`, `rtK`, `rtST0`, `kLW`, `rtLinkSegW`, `kRS`, `rtRs`, `kTS`,
  `kEvL`, `rtN0c`, `rtC1c`), the prototype's replay rows `repRowsP` and their place at the node
  (`repB`, `repMapC`, `repRow0`, `repIRowsW`).

The theorems about them stay where they were (those modules import this one through `FRNodeRows4`).

FEL adds the `dotKF` column alias (`colEs` … `colA`, generic in the window map and the proof size so that
controls run on toy inputs), the extension `XofC`/`Xof` over it (`tplExt4A`), and `xof_dk`/`xof_ne`.
-/

namespace FR
namespace Rev4

-- from `FRNodeRows4`
section
open RecursionFast Circ TEval

/-- A form with its cells mapped. -/
def mapC (f : ℕ → ℕ) (l : Lin) : Lin := l.map fun t => (f t.1, t.2)

/-- A row with its cells mapped. -/
def rowMapC (f : ℕ → ℕ) (r : Row) : Row := ⟨mapC f r.a, mapC f r.b, mapC f r.c⟩

/-- The selector index's offset in a slot's selector cells. -/
def selIx : Kind → ℕ | .L32 => 0 | .P30 => 1 | .N30 => 2

/-- Slot `σ`'s `one` copy (M-relative). -/
def oneR (σ : ℕ) : ℕ := σ * slotM4

/-- Slot `σ`'s selector copies (M-relative). -/
def selR (σ : ℕ) (ι : Kind) : ℕ := σ * slotM4 + 1 + selIx ι

/-- Slot `σ`'s first compiled cell (M-relative). -/
def baseR (σ : ℕ) : ℕ := σ * slotM4 + 4

/-- **Slot `σ`'s selector forms** (M-relative). -/
def protoP (σ : ℕ) : Params := ⟨Lin.cell (oneR σ), fun ι => Lin.cell (selR σ ι)⟩

/-- Whether slot `σ` replays the previous node. -/
def isPrevSlot (κ : NodeKind) (σ : ℕ) : Bool := κ.hasPrev && σ == 0

/-- **Slot `σ`'s prototype**: `0` (the previous-node program) or `1` (the segment program). -/
def protoOf (κ : NodeKind) (σ : ℕ) : ℕ := if isPrevSlot κ σ then 0 else 1

/-- **Prototype `π`'s program**: INT-8's group-uniform programs (blueprint 4.3 route (A)), the
previous-node group with each kind's own public cells `N4c.cells4` (S-E12a: `c_A` from `hashA`;
INT-9: was `progNodeG (cells4 .N4)`, `N4`'s cells at every index), and the segment group. -/
def protoProg (π : ℕ) : VProg := if π = 0 then progNodeGK N4c.cells4 else progSegG

/-- **Prototype `π`'s layout**: `layOf`'s two-pass layout at S-E12b's programs, as constants
(`FRNodeRows4Hint`; S-E12c: the process start then compiles each prototype once). Any layout is
sound (`compileT_sound`); that the rows fit is `ProtoFit`, checked. -/
def protoLay (π : ℕ) : TLay := if π = 0 then hintLay0 else hintLay1

/-- **Prototype `π`'s template set** (S-E12d, revision 4.3 (a)): revision 4.1's (`keys41`: 3.x's
`shiftMask` template left out) for both prototypes; the 4.1 `shiftMask` templates (`.shiftSeg`,
`.maskN`) are in it, and the route `protoR` picks one (S-E12e). -/
def protoF (_π : ℕ) : TFilt := keys41

/-- The node kind selector index `ι` stands for in the previous-node group (`nodeGrp`). -/
def nodeOf : Kind → NodeKind
  | .L32 => .N4
  | .P30 => .N2
  | .N30 => .N8

/-- A node kind's `shiftMask` constants `(nb, chLen₀, chLen₁)` (`NI4.shiftMask4I`'s). -/
def maskQ (ν : NodeKind) : ℕ × ℕ × ℕ := (ν.m - 14, N4c.chLen ν 0, N4c.chLen ν 1)

/-- **Prototype `π`'s `shiftMask` route** (S-E12e): the node's kind-muxed `chainLk4` template over
the group's kinds in selector order (prototype 0), the segment's `shiftSegI` template (prototype 1). -/
def protoR (π : ℕ) : ShR := if π = 0 then .node (Circ.kinds.map fun ι => maskQ (nodeOf ι)) else .seg

/-- A cell or row moved from region `π` to region `σ`. -/
def mvC (π σ c : ℕ) : ℕ := c - π * slotM4 + σ * slotM4

end


end Rev4

namespace Circ

-- from `FRNodeRows4Rep`
section
open RecursionFast

/-- **A replay template**: the ops it covers, and for a compile state, an op and the op's output
slots, the rows that compute the outputs from the operands' slots. -/
structure RT where
  cov : Op → Bool
  rows : Params → CS → Op → List Slot → List Row

/-- The template that covers nothing. -/
def RT.none : RT := ⟨fun _ => false, fun _ _ _ _ => []⟩

/-- **The replay rows along the compile's trail** (the alignment and the step exactly as
`compileFromX`). -/
def repRowsX (X : Ext) (P : Params) (rt : RT) : CS → List Op → List Row
  | _, [] => []
  | cs, op :: ops =>
    let c := cs.align (alignOf op ops)
    (if rt.cov op then rt.rows P c op (stepOut X P c op).slots else []) ++
      repRowsX X P rt (c.add op (stepOut X P c op)) ops

/-- A form's cells are below `B`. -/
def linLt (B : ℕ) (l : Lin) : Bool := l.all fun t => decide (t.1 < B)

end

end Circ

namespace N4s

-- from `FRNodeRows4Rep`
section
open RecursionFast Rev4 Circ

/-! ### The `dotKF` column alias (FEL)

A `dotKF w col`'s `n` column cells are arena₁'s cells of the elements of the column's 16-byte windows
(`winE`; `PfCells` binds them to the proof's bytes), so no row is needed for them. The elements of every
`dotKF` column of a prototype are computed once (`colT0`, `colT1`, at process start); `colA` looks them up.
A column that is not a `piField`'s bytes whose windows are all elements is refused (`none`): the extension
then takes no template and the closure fails the import (`FRNodeRows4AskC.impRows`). -/

/-- Prototype `π`'s `piField` registers (FEL: moved from `FRNodeRows4AskIR`). -/
def pvP (π : ℕ) : List (ℕ × ℕ × ℕ × ℕ) := provLT 0 (protoProg π).ops

/-- **A byte field's window elements**: the element `win` gives each 16-byte window of bytes `[x, x + len)`
of a proof of `sz` bytes, if `len ≡ 0 mod 16`, the bytes are inside the proof and every window has one. -/
def colEs (win : ℕ → Option ℕ) (sz x len : ℕ) : Option (List (Option ℕ)) :=
  let es := (List.range (len / 16)).map fun t => win (x + 16 * t)
  if len % 16 = 0 ∧ x + len ≤ sz ∧ es.all Option.isSome = true then some es else none

/-- **Register `col`'s window elements**, if a `piField` (`pv`) appended it. -/
def colEW (pv : List (ℕ × ℕ × ℕ × ℕ)) (win : ℕ → Option ℕ) (col : ℕ) : Option (List (Option ℕ)) :=
  match provOf pv col with
  | some (f, o, len) => colEs win (piSizeOf seq4) (absOff f o) len
  | none => none

/-- **A column's `n` cells**: window `b`'s element `e` gives cell `base + e`; past the last window the
zero form `[]`. -/
def colCells (base n : ℕ) (es : List (Option ℕ)) : List Lin :=
  (List.range n).map fun b =>
    match es.getD b none with
    | some e => Lin.cell (base + e)
    | none => []

/-- `dotCols`'s fold (tail-recursive: a prototype has ≈ 155 k ops). -/
def dotColsAcc : List Op → List ℕ → List ℕ
  | [], acc => acc
  | .dotKF _ c :: ops, acc => dotColsAcc ops (c :: acc)
  | _ :: ops, acc => dotColsAcc ops acc

/-- The column registers of a program's `dotKF`s (reversed). -/
def dotCols (ops : List Op) : List ℕ := dotColsAcc ops []

/-- **A window-element cache**: each column's `(x, len)` (its proof bytes `[x, x + len)`, from `pv`) with
`colEs`'s elements. -/
def esCache (pv : List (ℕ × ℕ × ℕ × ℕ)) (win : ℕ → Option ℕ) (sz : ℕ) (cols : List ℕ) :
    List ((ℕ × ℕ) × Option (List (Option ℕ))) :=
  cols.filterMap fun c => (provOf pv c).map fun p => ((absOff p.1 p.2.1, p.2.2), colEs win sz (absOff p.1 p.2.1) p.2.2)

/-- **`colEW` through a cache** (`ca`: a field's elements already computed; else computed). -/
def colEWC (ca : List ((ℕ × ℕ) × Option (List (Option ℕ)))) (pv : List (ℕ × ℕ × ℕ × ℕ)) (win : ℕ → Option ℕ)
    (col : ℕ) : Option (List (Option ℕ)) :=
  match provOf pv col with
  | some (f, o, len) =>
    match ca.lookup (absOff f o, len) with
    | some r => r
    | none => colEs win (piSizeOf seq4) (absOff f o) len
  | none => none

/-- **A column table**: each column register with its window elements (through the cache `ca`). -/
def colTab (ca : List ((ℕ × ℕ) × Option (List (Option ℕ)))) (pv : List (ℕ × ℕ × ℕ × ℕ)) (win : ℕ → Option ℕ)
    (cols : List ℕ) : List (ℕ × Option (List (Option ℕ))) :=
  cols.map fun c => (c, colEWC ca pv win c)

/-- Prototype 0's columns' window elements (computed once; prototype 1's columns are the same fields). -/
def esC0 : List ((ℕ × ℕ) × Option (List (Option ℕ))) :=
  esCache (pvP 0) winE (piSizeOf seq4) (dotCols (protoProg 0).ops)

/-- Prototype 0's column table (computed once). -/
def colT0 : List (ℕ × Option (List (Option ℕ))) := colTab esC0 (pvP 0) winE (dotCols (protoProg 0).ops)

/-- Prototype 1's column table (computed once, through prototype 0's elements). -/
def colT1 : List (ℕ × Option (List (Option ℕ))) := colTab esC0 (pvP 1) winE (dotCols (protoProg 1).ops)

/-- Prototype `π`'s column table. -/
def colTP (π : ℕ) : List (ℕ × Option (List (Option ℕ))) := if π = 0 then colT0 else colT1

/-- **Prototype `π`'s column alias**: the cells of `dotKF`'s column `col`, `n` of them, on arena₁ of region
`π` (`π·2^20 + arA1 + e`); `none` where the table has no elements for `col`. -/
def colA (π col n : ℕ) : Option (List Lin) :=
  ((colTP π).lookup col).bind fun es => es.map (colCells (π * slotM4 + arA1) n)

/-- **Prototype `π`'s compiler extension at a context** (FEL: `tplExt4` with the `dotKF` arm aliased by
`colA π`). -/
def XofC (π : ℕ) (tc : Tpl.TCtx) : Ext := tplExt4A (protoF π) (protoR π) tc (colA π)

/-- Prototype `π`'s compiler extension (`protoCS π = compileX (Xof π) …`). -/
def Xof (π : ℕ) : Ext := XofC π (protoLay π).ctx

/-- At a `dotKF`, `Xof` is the aliased arm (FEL). -/
theorem xof_dk (π : ℕ) (P : Params) (cs : CS) (w col : ℕ) :
    Xof π P cs (.dotKF w col) = dkA (protoF π) (protoLay π).ctx (colA π) P cs w col := rfl

/-- At an op other than `dotKF`, `Xof` is `tplExt4`'s (FEL). -/
theorem xof_ne {π : ℕ} {P : Params} {cs : CS} {op : Op} (h : ∀ w col, op ≠ .dotKF w col) :
    Xof π P cs op = tplExt4 (protoF π) (protoR π) (protoLay π).ctx P cs op :=
  tplExt4A_ne h

/-- **Prototype `π`'s replay rows** (its frame: M-relative cells of region `π`). -/
def repRowsP (rt : RT) (π : ℕ) : List Row := repRowsX (Xof π) (protoP π) rt (CS.init (baseR π)) (protoProg π).ops

/-- **The replay rows' first row in a slot region** (`23·2^15`: after the prototypes' 730,493 rows
and a 3 % gap, `2^18` rows before the link region). -/
def repBase : ℕ := 23 * 2 ^ 15

end

-- from `FRNodeRows4RepS`
section
open RecursionFast Rev4 Circ

/-- **`one · ℓ = 0` per output cell** of an `af 8` slot; the rejecting row on any other slot. -/
def zeroRows (P : Params) : List Slot → List Row
  | [some (t, ls)] =>
    if t = .af 8 ∧ ls.length = 8 then ls.map fun l => ⟨P.one, l, []⟩ else [⟨P.one, P.one, []⟩]
  | _ => [⟨P.one, P.one, []⟩]

/-- Whether an op is `linkWAll`. -/
def isLinkW : Op → Bool
  | .linkWAll .. => true
  | _ => false

end

-- from `FRNodeRows4RepK`
section
open RecursionFast Rev4 Circ Tpl

/-- **`rt₁` where it covers, else `rt₂`.** -/
def _root_.FR.Circ.RT.orElse (rt₁ rt₂ : RT) : RT :=
  ⟨fun op => rt₁.cov op || rt₂.cov op,
   fun P cs op outs => if rt₁.cov op then rt₁.rows P cs op outs else rt₂.rows P cs op outs⟩

/-- The rejecting row `one · one = 0`. -/
def rejRow (P : Params) : Row := ⟨P.one, P.one, []⟩

/-- The output slots have the types `tys`, each with one form per component. -/
def outsOk : List Ty → List Slot → Bool
  | [], [] => true
  | t :: ts, some (t', ls) :: os => t == t' && ls.length == t.len && outsOk ts os
  | _, _ => false

/-- The output slots' forms, in order. -/
def outF (outs : List Slot) : List Lin := outs.flatMap fun s => match s with
  | some (_, ls) => ls
  | none => []

/-- **The copy rows** `one · out_c = o_c` (`o`: the instantiated template outputs). -/
def copyRows (P : Params) (outs : List Slot) (o : List Lin) : List Row :=
  (outF outs).zipIdx.map fun p => ⟨P.one, p.1, o.getD p.2 []⟩

/-- **The operands' types and forms at index `ι`** (`none` if one has no slot or the wrong number
of forms). -/
def kOps (cs : CS) (ι : Kind) : List ℕ → Option (List Ty × List Lin)
  | [] => some ([], [])
  | a :: as => match cs.slotK a ι, kOps cs ι as with
    | some (t, ls), some (ts, fs) => if ls.length = t.len then some (t :: ts, ls ++ fs) else none
    | _, _ => none

/-- **A kind-muxed op replay**: the op's operand registers at each index, its sub-template per node
kind and operand types, its output types. -/
structure KOp where
  cov : Op → Bool
  args : Op → Kind → List ℕ
  /-- The operand types the sub-templates serve (checked at every index). -/
  inOk : List Ty → Bool
  T : Op → NodeKind → List Ty → Tpl
  tys : List Ty

/-- The selector index of a kind (its position in `Circ.kinds`). -/
def kIx : Kind → ℕ
  | .L32 => 0
  | .P30 => 1
  | .N30 => 2

/-- The three indices' operand blocks, in `Circ.kinds`' order. -/
def kBlocks (K : KOp) (cs : CS) (op : Op) : Option (List (List Ty × List Lin)) :=
  match kOps cs .L32 (K.args op .L32), kOps cs .P30 (K.args op .P30), kOps cs .N30 (K.args op .N30) with
  | some a, some b, some c => some [a, b, c]
  | _, _, _ => none

/-- What sub-template `j` reads as its input `i`: block `j` (widths `ws`); `0` past it. -/
def kSig (ws : List ℕ) (j i : ℕ) : LinT := if i < ws.getD j 0 then I ((ws.take j).sum + i) else []

/-- **The op's kind-muxed template** over the blocks `bs` (inputs: the blocks, then the three
selectors). -/
def kTpl (K : KOp) (op : Op) (bs : List (List Ty × List Lin)) : Tpl :=
  let ws := bs.map fun b => b.2.length
  kmuxT (kSig ws) ws.sum (K.tys.map Ty.len).sum
    [K.T op .N4 (bs.getD 0 ([], [])).1, K.T op .N2 (bs.getD 1 ([], [])).1, K.T op .N8 (bs.getD 2 ([], [])).1]

/-- The instance's input forms: the blocks' forms, then the selectors. -/
def kIns (P : Params) (bs : List (List Ty × List Lin)) : List Lin :=
  (bs.map (·.2)).flatten ++ kinds.map P.sel

/-- `gatesAt` with an accumulator (tail-recursive, REPF): the process start builds templates of up to
150 k gates in a constant's initializer, on the 8 MB thread stack, where `gatesAt` overflows. -/
def gatesAtGo : List Gate → ℕ → List (ℕ × Gate) → List (ℕ × Gate)
  | [], _, acc => acc
  | g :: gs, k, acc => gatesAtGo gs (k + g.nloc) ((k, g) :: acc)

/-- `Tpl.rows` by `gatesAtGo` (`rowsTR_eq`). -/
def rowsTR (T : Tpl) : List RowT := (gatesAtGo T.gates 0 []).reverse.flatMap fun p => p.2.rows p.1

/-- **The replay rows of a kind-muxed op**, its locals from cell `cb`. -/
def kRows (K : KOp) (B cb : ℕ) (P : Params) (cs : CS) (op : Op) (outs : List Slot) : List Row :=
  match kBlocks K cs op with
  | some bs =>
    if outsOk K.tys outs && bs.all (fun b => K.inOk b.1) && (kIns P bs ++ outF outs).all (linLt B) then
      (rowsTR (kTpl K op bs)).map (instRow P.one (kIns P bs) cb) ++
        copyRows P outs ((kTpl K op bs).outs.map (instLin P.one (kIns P bs) cb))
    else [rejRow P]
  | none => [rejRow P]

/-- **The replay template of a kind-muxed op.** -/
def rtK (K : KOp) (B cb : ℕ) : RT := ⟨K.cov, fun P cs op outs => if K.cov op then kRows K B cb P cs op outs else []⟩

/-- A form whose coefficients are all zero (`0` at every assignment). -/
def zeroLin (l : Lin) : Bool := l.all fun t => t.2 == 0

/-- **`bnd`'s two digests are the zero forms at every index** (its first four forms). -/
def bndZ (cs : CS) (bd : ℕ) : Bool :=
  kinds.all fun ι => match cs.slotK bd ι with
    | some (.af _, ls) => (List.range 4).all fun j => zeroLin (ls.getD j [])
    | _ => false

/-- Whether an op is `shiftTarget`. -/
def isST : Op → Bool
  | .shiftTarget .. => true
  | _ => false

/-- `one · out = 0` on the import's cell, if `bnd`'s digests are zero; else the rejecting row. -/
def stOut (B : ℕ) (P : Params) (cs : CS) (bd : ℕ) : List Slot → List Row
  | [some (.f, [o])] => if bndZ cs bd && linLt B o then [⟨P.one, o, []⟩] else [rejRow P]
  | _ => [rejRow P]

/-- The rows of a `shiftTarget` (`stOut`); the rejecting row on any other op. -/
def stRows (B : ℕ) (P : Params) (cs : CS) : Op → List Slot → List Row
  | .shiftTarget _ _ bd _ => stOut B P cs bd
  | _ => fun _ => [rejRow P]

/-- **Prototype 0's `shiftTarget` replay.** -/
def rtST0 (B : ℕ) : RT := ⟨isST, fun P cs op outs => if isST op then stRows B P cs op outs else []⟩

end

-- from `FRNodeRows4RepN`
section
open RecursionFast Rev4 Circ Tpl

/-- Whether an op is `linkWAll`. -/
def isLW : Op → Bool
  | .linkWAll .. => true
  | _ => false

/-- `linkWAll`'s operands (`tt`, `rr`) at every index. -/
def lwArgs : Op → Kind → List ℕ
  | .linkWAll t p, _ => [t, p]
  | _, _ => []

/-- The operand types the template serves: two `AF`s. -/
def lwIn : List Ty → Bool
  | [.af _, .af _] => true
  | _ => false

/-- The sub-template at node kind `ν` (`tplLW` on two `AF`s; eight empty outputs otherwise, which
`lwIn` rejects). -/
def lwT : Op → Rev4.NodeKind → List Ty → Tpl
  | _, ν, [.af a, .af b] => tplLW ν a b
  | _, _, _ => ⟨[], List.replicate nLinkFam []⟩

/-- **`linkWAll`'s kind-muxed replay.** -/
def kLW : KOp := ⟨isLW, lwArgs, lwIn, lwT, [.af nLinkFam]⟩

/-- **S-E14's segment `linkWAll` replay** with its output cells checked below `B`. -/
def rtLinkSegW (B : ℕ) : RT :=
  ⟨isLinkW, fun P _ op outs =>
    if isLinkW op then (if (outF outs).all (linLt B) then zeroRows P outs else [rejRow P]) else []⟩

/-- **The replay frame's bound**: every cell of a prototype's compile is below it (its frame is two
regions, `< 2^21`); the replay templates' locals are above it (`FRNodeRows4RepW.repMapC` puts them
in the spare region). -/
@[noinline] def repB : ℕ := 2 ^ 40

/-- `linkWAll`'s locals (the first block above the frame). -/
def cbLW : ℕ := repB

/-- **Prototype 0's replay templates**: `shiftTarget` (zero) and `linkWAll`. -/
def rtN0 : RT := (rtST0 repB).orElse (rtK kLW repB cbLW)

end

-- from `FRNodeRows4RepW`
section
open RecursionFast Rev4 Circ

/-- **A segment slot's local `j` (`c = repB + j`) in its region** (SEG-R2, SEG-R0 §3's free cell bands):
the first `2^12` (`targetS`'s and `shiftTarget`'s blocks, `cbTSS`, `cbSTS`) in band 2 `[277,402, 290,816)`
(the skeleton's end to arena₁), the next 35,648 (`rsWeight`'s, from `cbRSS`) in band 1 `[405,504, 441,152)`
(the bits' end to the lowest instance), the rest in band 3 `[1,003,010, 1,015,728)` (between instance
groups). `segCap` locals fit. -/
def segCell (j : ℕ) : ℕ :=
  if j < 2 ^ 12 then 277402 + j else if j < 39744 then 405504 + (j - 2 ^ 12) else 1003010 + (j - 39744)

/-- The segment slot's locals that fit its three cell bands (`2^12 + 35,648 + 12,718`). -/
def segCap : ℕ := 52462

/-- **Where a replay cell lives** (slot `v` of a node of kind `κ`): a frame cell where the slot's
assignment reads it; a local (`c ≥ repB`) of prototype 0 in the spare region, from cell `κ.vslots·2^20`,
of prototype 1 in the slot's own region's free cell bands (`segCell`, SEG-R2). -/
def repMapC (κ : Rev4.NodeKind) (v c : ℕ) : ℕ :=
  if c < repB then mvC (protoOf κ v) v c + κ.oneCell
  else if protoOf κ v = 0 then κ.vslots * slotM4 + (c - repB) + κ.oneCell
  else v * slotM4 + segCell (c - repB) + κ.oneCell

/-- **A segment slot's replay rows' first row in its region** (band B, SEG-R2): the bits' end
`arRb + arNb` (`988,672` after SEG-R2's cut of `arR2N` to 154,368; `FRNodeRows4Fit.repConsts`), up to the
link region `2^20 − 2^15`: `segBN = 27,136` rows. -/
def repSegB : ℕ := 988672

/-- Band B's rows (`2^20 − 2^15 − repSegB`). -/
def segBN : ℕ := 27136

/-- **Band A's first row** (SEG-R2): `688,128 = 21·2^15`, `2,048` rows above prototype 1's end (686,079;
checked at process start, `RepFit`), up to the binding's first row `arR2 = 720,896`: 32,768 rows. -/
def repA : ℕ := 688128

/-- The segment's replay rows that fit bands B and A. -/
def segRN : ℕ := 59904

/-- **A segment slot's replay row `k` in its region** (SEG-R2): band B, then band A. -/
def segRow (k : ℕ) : ℕ := if k < segBN then repSegB + k else repA + (k - segBN)

/-- **Slot `v`'s replay rows' first row**: slot 0 of a node with a previous node (prototype 0) in
the spare region (`κ.vslots·2^20`, its rows consecutive from there); a segment slot at band B's start
`v·2^20 + repSegB` (SEG-R2: its rows fill band B, then continue in band A, `segRow`; `repRowI` places them). -/
def repRow0 (κ : Rev4.NodeKind) (v : ℕ) : ℕ := if protoOf κ v = 0 then κ.vslots * slotM4 else v * slotM4 + repSegB

/-- **Slot `v`'s replay row `k`**: prototype 0's at `repRow0 κ v + k`, a segment slot's at
`v·2^20 + segRow k` (SEG-R2: two bands). -/
def repRowI (κ : Rev4.NodeKind) (v k : ℕ) : ℕ := if protoOf κ v = 0 then repRow0 κ v + k else v * slotM4 + segRow k

/-- **Slot `v`'s replay rows** (absolute cells: `repMapC`). -/
def repIRowsW (rt : ℕ → RT) (κ : Rev4.NodeKind) (v : ℕ) : List (ℕ × Row) :=
  (repRowsP (rt (protoOf κ v)) (protoOf κ v)).zipIdx.map fun p =>
    (repRowI κ v p.2, rowMapC (repMapC κ v) p.1)

end

-- from `FRNodeRows4RepRsK`
section
open RecursionFast Rev4 Circ Tpl

/-- All `AK`: their sizes. -/
def akS : List Ty → Option (List ℕ)
  | [] => some []
  | .ak n :: r => (akS r).map (n :: ·)
  | _ => none

/-- The operand types `af 7, f, f, ak m, ak n₀, …`: `(m, [n₀, …])`. -/
def rsShape : List Ty → Option (ℕ × List ℕ)
  | .af 7 :: .f :: .f :: .ak m :: r => (akS r).map (m, ·)
  | _ => none

/-- `K` inputs `o, o+1, …`: `n` pairs. -/
def kIn (o n : ℕ) : List KF := (List.range n).map fun l => (I (o + 2 * l), I (o + 2 * l + 1))

/-- The claims' inputs from `o`, sizes `ns`. -/
def cIn : ℕ → List ℕ → List (List KF)
  | _, [] => []
  | o, n :: ns => kIn o n :: cIn (o + 2 * n) ns

/-- **The node kind `ν`'s `rsWeight` sub-template** (CF: as segments, `rsGS`; the rows' MLE in closed
form for the repeated patterns). -/
def rsT (ν : NodeKind) (ts : List Ty) : Tpl :=
  match rsShape ts with
  | some (m, ns) =>
    let g := rsGS ν ((List.range 7).map I) (cIn (9 + 2 * m) ns) (I 7) (I 8) (kIn 9 m) 0
    ⟨sgGates g.1 0, [g.2.1, g.2.2]⟩
  | none => ⟨[], [[], []]⟩

/-- An `rsWeight` op active at every index. -/
def isRS : Op → Bool
  | .rsWeight _ _ _ _ act _ => act .L32 && act .P30 && act .N30
  | _ => false

/-- `rsWeight`'s operands at index `ι`: `r″`, `κ`, `β`, `ρ`, then the claims. -/
def rsArgs : Op → Kind → List ℕ
  | .rsWeight r ps κ β _ ρ, ι => [r, κ, β, ρ] ++ ps ι
  | _, _ => []

/-- The operand types the template serves. -/
def rsIn (ts : List Ty) : Bool := (rsShape ts).isSome

/-- **`rsWeight`'s kind-muxed replay.** -/
def kRS : KOp := ⟨isRS, rsArgs, rsIn, fun _ ν ts => rsT ν ts, [.k]⟩

/-- `rsWeight`'s locals: after `linkWAll`'s (42,592 < `2^16`). -/
def cbRS : ℕ := repB + 2 ^ 16

/-- **`rsWeight`'s replay template** (prototype 0). -/
def rtRs : RT := rtK kRS repB cbRS

/-- **Prototype 0's replay templates with `rsWeight`**: C1's `rtN0`, then `rtRs`. -/
def rtN0R : RT := rtN0.orElse rtRs

end

-- from `FRNodeRows4RepLT`
section
open RecursionFast Rev4 Circ Tpl

def isTS : Op → Bool
  | .targetS .. => true
  | _ => false

def tsArgs : Op → Kind → List ℕ
  | .targetS r, _ => [r]
  | _, _ => []

def tsIn : List Ty → Bool
  | [.af _] => true
  | _ => false

def tsTpl : Op → Rev4.NodeKind → List Ty → Tpl
  | _, ν, [.af a] => tplTS ν a
  | _, _, _ => ⟨[], List.replicate 64 []⟩

/-- **`targetS`'s kind-muxed replay.** -/
def kTS : KOp := ⟨isTS, tsArgs, tsIn, tsTpl, [.af 64]⟩

def isEvL : Op → Bool
  | .evalL .. => true
  | _ => false

def evArgs : Op → Kind → List ℕ
  | .evalL t s, _ => [t, s]
  | _, _ => []

def evIn : List Ty → Bool
  | [.af _, .af _] => true
  | _ => false

def evTpl : Op → Rev4.NodeKind → List Ty → Tpl
  | _, ν, [.af a, .af b] => tplEvL ν a b
  | _, _, _ => ⟨[], List.replicate 3 []⟩

/-- **`evalL`'s kind-muxed replay.** -/
def kEvL : KOp := ⟨isEvL, evArgs, evIn, evTpl, [.f, .f, .f]⟩

/-- `targetS`'s locals (`kTS`'s instance): above `linkWAll`'s (from `repB`, 42,592) and `rsWeight`'s (from
`cbRS = repB + 2^16`; CF's segment template: 504,784 locals, up to `repB + 570,320`). -/

def cbTS : ℕ := repB + (2 ^ 19 + 2 ^ 16)

/-- `evalL`'s locals, above `targetS`'s (11.8 k). -/
def cbEvL : ℕ := repB + (2 ^ 19 + 2 ^ 16 + 2 ^ 14)

/-- **Prototype 0's replay templates with R3's `rsWeight`** (`rtN0R`): `shiftTarget`, `linkWAll`,
`rsWeight`, `targetS`, `evalL`. -/
def rtN0c : RT := rtN0R.orElse ((rtK kTS repB cbTS).orElse (rtK kEvL repB cbEvL))

/-- **The replay templates per prototype**, all five of prototype 0. -/
def rtC1c (π : ℕ) : RT := if π = 0 then rtN0c else if π = 1 then rtLinkSegW repB else RT.none

end

end N4s
end FR

end G6_FRNodeRows4Defs

section G6_FRNodeRows4SegD

-- New for `flock-recursive` (stage SEG-R2): prototype 1's replay templates, definitions only, below
-- `FRNodeRows4` (moved verbatim, names and namespaces kept, from `FRNodeRows4RepSegK`, `FRNodeRows4RepSeg`,
-- `FRNodeRows4RepSegT`), so that `repAllRows`, `askTG` and the plan name `rtC1d`.

/-!
# The segment program's replay templates, definitions only

`nodeIRows4` (`FRNodeRows4`) folds the replay rows of `rtC1d` (prototype 0: `rtN0c`; prototype 1: `rtSeg1`),
and `askTG` fails at a replay op `rtC1d` does not cover (`TG.repF`). Their definitions lived in modules
above `FRNodeRows4` (SEG-R1, SEG-R1b); this module holds them, moved verbatim with their names and
namespaces, as `FRNodeRows4Defs` does for REPF's:

* from `FRNodeRows4RepSegK`: the wrapper (`KOpD`, `kdG`, `cstOf`, `kdMux`, `kdPos`, `kdAll`, `kdZero`, `kdIn`,
  `kdRows`, `rtKD`) and the dead ops' zero rows (`isEvML`, `zeroF3`, `rtEvZ`);
* from `FRNodeRows4RepSeg`: `rsWeight`'s `KOpD` (`isRSS`, `rssIn`, `rssM`, `rssLay`, `rssZf`, `kRSS`), the local
  blocks (`cbRSS`, `cbTSS`, `cbSTS`), `rtSeg1`, `rtC1d`;
* from `FRNodeRows4RepSegT`: `targetS`'s and `shiftTarget`'s (`tssIn`, `tssLay`, `kTSS`, `stArgs`, `stsIn`,
  `stsLay`, `kSTS`).

The theorems about them stay where they were.
-/

namespace FR
namespace N4s
open RecursionFast Rev4 Circ Tpl

-- from `FRNodeRows4RepSegK`

/-- **A kind-muxed op replay on canonical inputs** (one template for the three indices). -/
structure KOpD where
  cov : Op → Bool
  args : Op → Kind → List ℕ
  /-- The operand types the template serves (checked at every index). -/
  inOk : List Ty → Bool
  /-- The canonical inputs. -/
  W : ℕ
  /-- Canonical input `p`'s position in the operand encoding at types `ts` (`none`: `0`). -/
  lay : List Ty → ℕ → Option ℕ
  /-- The encoding positions forced to `0`. -/
  zf : List Ty → List ℕ
  /-- The template (inputs `I p`, `p < W`), given constants it may fold; its outputs and forcing rows. -/
  T : List (Option F) → GM (List LinT × List RowT)
  tys : List Ty

/-- Its blocks as `kBlocks` reads them. -/
def KOpD.toK (K : KOpD) : KOp := ⟨K.cov, K.args, K.inOk, fun _ _ _ => ⟨[], []⟩, K.tys⟩

/-- Canonical input `p`'s form in an operand block. -/
def kdG (K : KOpD) (b : List Ty × List Lin) (p : ℕ) : Lin :=
  match K.lay b.1 p with
  | some q => b.2.getD q []
  | none => []

/-- A form `c · Σ_κ sel_κ` (a kind-free constant, `Params.kc`): its `c`. -/
def cstOf (P : Params) (l : Lin) : Option F :=
  match l.head? with
  | some t => if l = P.kc (fun _ => t.2) then some t.2 else none
  | none => none

/-- **The mux** over the kinds `ks`, its locals from cell `c`: the sum of the locals, and the rows
`sel_ι · g_ι = m`. -/
def kdMux (P : Params) (g : Kind → Lin) : List Kind → ℕ → Lin × List Row
  | [], _ => ([], [])
  | ι :: ks, c => (((c, 1) :: (kdMux P g ks (c + 1)).1), ⟨P.sel ι, g ι, Lin.cell c⟩ :: (kdMux P g ks (c + 1)).2)

/-- **One canonical input** (the three kinds' forms `g`; mux locals from `c`): its form, its constant
hint, its rows, its mux locals. -/
def kdPos (P : Params) (g : Kind → Lin) (c : ℕ) : Lin × Option F × List Row × ℕ :=
  if g .L32 = g .P30 ∧ g .P30 = g .N30 then
    (g .L32, if zeroLin (g .L32) then some 0 else cstOf P (g .L32), [], 0)
  else ((kdMux P g kinds c).1, none, (kdMux P g kinds c).2, 3)

/-- **The canonical inputs** `p₀ … p₀ + n − 1`, mux locals from `c`: forms, hints, rows, the next
free local. -/
def kdAll (P : Params) (g : ℕ → Kind → Lin) : ℕ → ℕ → ℕ → List Lin × List (Option F) × List Row × ℕ
  | 0, _, c => ([], [], [], c)
  | n + 1, p, c =>
    ((kdPos P (g p) c).1 :: (kdAll P g n (p + 1) (c + (kdPos P (g p) c).2.2.2)).1,
     (kdPos P (g p) c).2.1 :: (kdAll P g n (p + 1) (c + (kdPos P (g p) c).2.2.2)).2.1,
     (kdPos P (g p) c).2.2.1 ++ (kdAll P g n (p + 1) (c + (kdPos P (g p) c).2.2.2)).2.2.1,
     (kdAll P g n (p + 1) (c + (kdPos P (g p) c).2.2.2)).2.2.2)

/-- The zero-forcing rows `one · f = 0` on every block's forced positions. -/
def kdZero (K : KOpD) (P : Params) (bs : List (List Ty × List Lin)) : List Row :=
  bs.flatMap fun b => (K.zf b.1).map fun q => ⟨P.one, b.2.getD q [], []⟩

/-- The canonical inputs of a block list (selector index `kIx ι` reads block `kIx ι`). -/
def kdIn (K : KOpD) (P : Params) (cb : ℕ) (bs : List (List Ty × List Lin)) :
    List Lin × List (Option F) × List Row × ℕ :=
  kdAll P (fun p ι => kdG K (bs.getD (kIx ι) ([], [])) p) K.W 0 cb

/-- **The replay rows of a `KOpD` op**: the mux's locals from `cb`, the template's after them. -/
def kdRows (K : KOpD) (B cb : ℕ) (P : Params) (cs : CS) (op : Op) (outs : List Slot) : List Row :=
  match kBlocks K.toK cs op with
  | some bs =>
    if outsOk K.tys outs && bs.all (fun b => K.inOk b.1) && ((bs.flatMap (·.2)) ++ outF outs).all (linLt B) &&
        (K.T (kdIn K P cb bs).2.1 0).2.1.length == (K.tys.map Ty.len).sum then
      (kdIn K P cb bs).2.2.1 ++ kdZero K P bs ++
        (rowsTR ⟨(K.T (kdIn K P cb bs).2.1 0).1, []⟩).map (instRow P.one (kdIn K P cb bs).1 (kdIn K P cb bs).2.2.2) ++
        (K.T (kdIn K P cb bs).2.1 0).2.2.map (instRow P.one (kdIn K P cb bs).1 (kdIn K P cb bs).2.2.2) ++
        copyRows P outs ((K.T (kdIn K P cb bs).2.1 0).2.1.map (instLin P.one (kdIn K P cb bs).1 (kdIn K P cb bs).2.2.2))
    else [rejRow P]
  | none => [rejRow P]

/-- **The replay template of a `KOpD` op.** -/
def rtKD (K : KOpD) (B cb : ℕ) : RT :=
  ⟨K.cov, fun P cs op outs => if K.cov op then kdRows K B cb P cs op outs else []⟩

/-- Whether an op is `evalM` or `evalL`. -/
def isEvML : Op → Bool
  | .evalM .. => true
  | .evalL .. => true
  | _ => false

/-- `one · out = 0` on three `F` output cells (checked below `B`); the rejecting row otherwise. -/
def zeroF3 (B : ℕ) (P : Params) (outs : List Slot) : List Row :=
  if outsOk [.f, .f, .f] outs && (outF outs).all (linLt B) then (outF outs).map fun l => ⟨P.one, l, []⟩
  else [rejRow P]

/-- **Prototype 1's `evalM`/`evalL` replay**: zero (`implSeg` pins them). -/
def rtEvZ (B : ℕ) : RT := ⟨isEvML, fun P _ op outs => if isEvML op then zeroF3 B P outs else []⟩

-- from `FRNodeRows4RepSegT`

/-- The operand types the template serves: one `AF 37`. -/
def tssIn : List Ty → Bool
  | [.af 37] => true
  | _ => false

/-- Canonical input `p < 37` is encoding entry `p`. -/
def tssLay (_ : List Ty) (p : ℕ) : Option ℕ := if p < 37 then some p else none

/-- **The segment's `targetS` replay.** -/
def kTSS : KOpD := ⟨isTS, tsArgs, tssIn, 37, tssLay, fun _ => [], tsSegT, [.af 64]⟩

/-- `shiftTarget`'s operands: `τ`, `θ`, `bnd`, `κs`. -/
def stArgs : Op → Kind → List ℕ
  | .shiftTarget t h bd ks, _ => [t, h, bd, ks]
  | _, _ => []

/-- The operand types the template serves: `[af 18, af 10, af 22, f]` (a segment's). -/
def stsIn : List Ty → Bool
  | [.af 18, .af 10, .af 22, .f] => true
  | _ => false

/-- Canonical input `p < 51` is encoding entry `p`. -/
def stsLay (_ : List Ty) (p : ℕ) : Option ℕ := if p < 51 then some p else none

/-- **The segment's `shiftTarget` replay.** -/
def kSTS : KOpD := ⟨isST, stArgs, stsIn, 51, stsLay, fun _ => [], stSegT, [.f]⟩

-- from `FRNodeRows4RepSeg`

/-- An `rsWeight` with `act` false and three claims at every index. -/
def isRSS : Op → Bool
  | .rsWeight _ ps _ _ act _ => kinds.all (fun ι => !act ι) && kinds.all fun ι => (ps ι).length == 3
  | _ => false

/-- The operand types the template serves: `[af 7, f, f, ak m ×4]`, `23 ≤ m ≤ 25`. -/
def rssIn : List Ty → Bool
  | [.af 7, .f, .f, .ak m, .ak m₁, .ak m₂, .ak m₃] =>
    decide (23 ≤ m) && decide (m ≤ 25) && m₁ == m && m₂ == m && m₃ == m
  | _ => false

/-- `ρ`'s width. -/
def rssM : List Ty → ℕ
  | _ :: _ :: _ :: .ak m :: _ => m
  | _ => 0

/-- Canonical input `p`'s encoding position (`r″`, `κ`; `ρ`; the claims' `f₀`). -/
def rssLay (ts : List Ty) (p : ℕ) : Option ℕ :=
  if p < 8 then some p
  else if p < 58 then (if (p - 8) / 2 < rssM ts then some (p + 1) else none)
  else if p < 133 then
    (if (p - 58) % 25 < rssM ts then
      some (9 + 2 * rssM ts + 2 * rssM ts * ((p - 58) / 25) + 2 * ((p - 58) % 25)) else none)
  else none

/-- The claims' `f₁` positions (forced to `0`: `F`-points). -/
def rssZf (ts : List Ty) : List ℕ :=
  (List.range 3).flatMap fun j => (List.range (rssM ts)).map fun l => 10 + 2 * rssM ts + 2 * rssM ts * j + 2 * l

/-- **The segment's `rsWeight` replay.** -/
def kRSS : KOpD := ⟨isRSS, rsArgs, rssIn, 133, rssLay, rssZf, rsSegT, [.k]⟩

/-- `rsWeight`'s locals (the mux's 207, then the template's 36,923; below `repB + 2^16`). -/
def cbRSS : ℕ := repB + 2 ^ 12

/-- `targetS`'s locals (mux, then `tsSegT`'s 55; < `2^9`) and `shiftTarget`'s (mux, then `stSegT`'s 1,301;
< `2^12 − 2^9`): both in `[repB, cbRSS)`, the block below `rsWeight`'s (R2: cell band 2). -/
def cbTSS : ℕ := repB
def cbSTS : ℕ := repB + 2 ^ 9

/-- **Prototype 1's replay templates** (SEG-R1, SEG-R1b): `linkWAll` (S-E14), `evalM`/`evalL` (zero),
`rsWeight`, `targetS`, `shiftTarget`. -/
def rtSeg1 : RT :=
  (rtLinkSegW repB).orElse ((rtEvZ repB).orElse ((rtKD kRSS repB cbRSS).orElse
    ((rtKD kTSS repB cbTSS).orElse (rtKD kSTS repB cbSTS))))

/-- **The replay templates per prototype** (`rtC1c` with prototype 1's `rtSeg1`). -/
def rtC1d (π : ℕ) : RT := if π = 0 then rtN0c else if π = 1 then rtSeg1 else RT.none

/-- Prototype 0's arm is REPF's (`rtC1c 0`), unchanged. -/
theorem rtC1d_zero : rtC1d 0 = rtC1c 0 := rfl

end N4s
end FR

end G6_FRNodeRows4SegD

section G6_FRNodeRows4

-- New for `flock-recursive` (BLUEPRINT revision 4.1, B-13, §4.3, §4.4, A.7; stage S-E12b, track
-- L-circ).

/-!
# The N2/N4/N8 nodes' M rows: slots, prototypes, copies, link rows

A node of kind `κ` has `κ.vslots` verifier slots (`FRNodeLayout4`): slot 0 replays the previous
step's node when `κ.hasPrev` (`N2`, `N4`), every other slot a segment (`N8`: all eight).

**Slot regions.** M's cells are numbered from M's first cell `κ.oneCell = 3·2^logM` (`oneCell_eq`):
slot `σ` owns the M-relative cells and the rows `[σ·2^20, (σ+1)·2^20)`. Its cell `σ·2^20` is its
own `one` (slot 0's is M's `one`), `σ·2^20 + 1 … + 3` its selector copies, and its program is
compiled from `σ·2^20 + 4` with these as the selector forms (`protoP`). Rows that leave the region
are the slot's **link rows** (`linkRows4`, in the region's **link region**, its last `linkN = 2^15`
rows; S-E13a: was the last 8): `one′ = one` (σ ≥ 1), `s′_ι = s_ι` (the selector bits in L, A.7's
offset 8,516 of the slot's `2^14` L stride), the one-hot products `s′_ι s′_ι′ = 0`, the activity
row (`linkRowsB4`), then the slot's **pack rows** (`packRows4`, S-E13a: the kind tie and the
stream's pinned elements, `FRNodeRows4Pack`), then at slot 1 S-E13b's node rows (`extRowsC`: WOTS
and `aggPad`, `FRNodeRows4Ext`).

**Prototypes and copies.** There are two programs (`FRVIR4Mux`): the previous-node mux
`progNodeG` and the segment mux `progSegG`. Each is compiled **once**, as prototype `π` (`0`: the
node program at slot 0; `1`: the segment program at slot 1), and every slot of every kind is a
prototype's rows moved to its region (`mvRows π σ`: rows and cells `+ (σ − π)·2^20`). This is
sound slot by slot: rows over moved cells hold at `w` iff the prototype's hold at `w ∘ move`
(`ev_mapC`), so the prototype's `compileT_sound` applies to slot `σ`'s child. It makes the plan
one pair of prototypes for all three kinds, and `evalM` one evaluation per prototype
(`FRNodeRows4Plan`).

`nodeIRows4 κ` (absolute cells) is the node's M rows: what `evalM` evaluates, what S-G's `truthE`
is stated over, and what P2's node prover fills.
-/

namespace FR
namespace Rev4
open RecursionFast Circ TEval

/-! ## Moving forms and rows -/

theorem ev_mapC (w : Asg) (f : ℕ → ℕ) (l : Lin) : (mapC f l).ev w = l.ev (w ∘ f) := by
  simp [mapC, Lin.ev, Function.comp_def]

/-- **Moved rows hold iff the original rows hold at the moved assignment.** -/
theorem holds_rowMapC (w : Asg) (f : ℕ → ℕ) (r : Row) : (rowMapC f r).Holds w ↔ r.Holds (w ∘ f) := by
  simp only [Row.Holds, rowMapC, ev_mapC]

/-! ## The slot regions -/

/-- **Slot `σ`'s selector bits in L** (A.7: after the signature 299, the digits' 266
bit-elements, the step selectors 399, the position bits 7,552 of the slot's `2^14` stride). -/
def selCells4 (κ : NodeKind) (σ : ℕ) (ι : Kind) : ℕ := κ.lBase * 128 + σ * 2 ^ 14 + 8516 + selIx ι

theorem nodeGrp_nodeOf (ι : Kind) : nodeGrp ι = .ofNode (nodeOf ι) := by cases ι <;> rfl

/-- **Prototype `π`'s templated compile** (at its template set and route; FEL: `dotKF`'s column cells
aliased to arena₁, `Xof`). -/
def protoCS (π : ℕ) : CS :=
  compileX (N4s.Xof π) (protoP π) (baseR π) (protoProg π).ops

/-- **Prototype `π`'s indexed rows** (rows from `π·2^20`, M-relative cells). -/
def protoRows (π : ℕ) : List (ℕ × Row) := slotIRows (protoLay π) (Lin.cell (oneR π)) (π * slotM4) (protoCS π)

/-- **Rows moved from region `π` to region `σ`.** -/
def mvRows (π σ : ℕ) (rows : List (ℕ × Row)) : List (ℕ × Row) :=
  rows.map fun p => (mvC π σ p.1, rowMapC (mvC π σ) p.2)

/-- **M-relative rows to absolute** (cells `+ κ.oneCell`; rows are M's own). -/
def absRows4 (κ : NodeKind) (rows : List (ℕ × Row)) : List (ℕ × Row) :=
  rows.map fun p => (p.1, rowMapC (· + κ.oneCell) p.2)

/-- **Slot `σ`'s rows** (absolute): its prototype's, moved. -/
def slotRows4 (κ : NodeKind) (σ : ℕ) : List (ℕ × Row) :=
  absRows4 κ (mvRows (protoOf κ σ) σ (protoRows (protoOf κ σ)))

/-- **Slot `σ`'s activity** `S_σ = Σ_ι s′_ι` (its selector copies' sum; a bit, as the copies are
L bits with at most one set). -/
def selSum (κ : NodeKind) (σ : ℕ) : Lin := Circ.kinds.flatMap fun ι => Lin.cell (κ.oneCell + selR σ ι)

/-- Slot `σ`'s index among its aggregate's sub-slots (`N2`/`N4`: slots `1 …`; `N8`: `4a + i`). -/
def subIx (κ : NodeKind) (σ : ℕ) : ℕ := if κ.hasPrev then σ - 1 else σ % 4

/-- **The activity rows** (S-E12c): the previous node's slot and every aggregate's first sub-slot
are active (`S_σ = 1`: exactly one selector); a later sub-slot is active only if the one before it
is (`S_σ · (1 − S_{σ−1}) = 0`). With the selector bits, the copies and the one-hot products, an
active slot selects exactly one kind and an inactive one none (`FRNodeRows4Fit`); which sub-slots are
active is pinned by the aggregate's `k` (`ActK`, the pack map's). -/
def actRows4 (κ : NodeKind) (σ : ℕ) : List Row :=
  let one := Lin.cell κ.oneCell
  if isPrevSlot κ σ || subIx κ σ == 0 then [⟨one, (selSum κ σ).sub one, []⟩]
  else [⟨selSum κ σ, one.sub (selSum κ (σ - 1)), []⟩]

/-- **Slot `σ`'s link rows of S-E12c** (absolute cells): `one′ = one` (σ ≥ 1), `s′_ι = s_ι`, the
one-hot products, the activity row. -/
def linkRowsB4 (κ : NodeKind) (σ : ℕ) : List Row :=
  let one := Lin.cell κ.oneCell
  let s := fun ι => Lin.cell (κ.oneCell + selR σ ι)
  (if σ = 0 then [] else [⟨one, (Lin.cell (κ.oneCell + oneR σ)).sub one, []⟩]) ++
  Circ.kinds.map (fun ι => ⟨one, (s ι).sub (Lin.cell (selCells4 κ σ ι)), []⟩) ++
  [⟨s .L32, s .P30, []⟩, ⟨s .L32, s .N30, []⟩, ⟨s .P30, s .N30, []⟩] ++ actRows4 κ σ

/-- The aggregate a segment slot belongs to (`N2`/`N4`: 0; `N8`: `σ / 4`). -/
def aggSlot (κ : NodeKind) (σ : ℕ) : ℕ := if κ.hasPrev then 0 else σ / 4

/-- **Slot `σ`'s packed stream** (S-E13a; R-A′): the first block of the stream segment it reads and
its kind group: the previous node's (signed child 0, the node group) and every aggregate sub-slot
`i` (segment `i` of the aggregate's stream, the segment group). With R-A′'s spacers segment `i`
starts at `1 + i·strideB`, `strideB = 64·sBlk`, so its block is the aggregate's first plus
`i·sBlk` and its elements are segment 0's shifted (S-E13a's B1 closed). -/
def packB (κ : NodeKind) (σ : ℕ) : Option (ℕ × Grp) :=
  if isPrevSlot κ σ then some (N4c.chBase κ 0, nodeGrp)
  else some (N4c.chBase κ (N4c.aggChild κ (aggSlot κ σ)) + subIx κ σ * N4c.sBlk, segGrp)

/-- Slot `σ`'s segment index in its stream (`0` for the previous node). -/
def segIx (κ : NodeKind) (σ : ℕ) : ℕ := if isPrevSlot κ σ then 0 else subIx κ σ

/-- **Slot `σ`'s head rows**: the kind tie (stream element 5 `= Σ_ι K_ι s′_ι`,
`FRNodeRows4Pack.kindRow`), then its segment's element 0 and, for a later sub-slot, the spacer
before it (`headRows`, with the spacer's bit cells `spC` of its aggregate). -/
def packHead4 (κ : NodeKind) (σ : ℕ) : List Row :=
  match packB κ σ with
  | some (b0, G) => kindRow κ.oneCell (sCell b0 5) (fun ι => κ.oneCell + selR σ ι) G ::
      headRows κ.oneCell b0 (segIx κ σ) (spC κ (N4c.aggChild κ (aggSlot κ σ)) (segIx κ σ))
  | none => []

/-- The pinned elements of slot `σ`'s stream segment (`FRNodeRows4Pack.wfRows`). -/
def packWf4 (κ : NodeKind) (σ : ℕ) : List Row :=
  match packB κ σ with
  | some (b0, _) => wfRows κ.oneCell b0
  | none => []

/-- **Slot `σ`'s pack rows** (S-E13a; `FRNodeRows4Pack`): the kind tie and the head rows, then the
stream's pinned elements (each later item's length word and query tag). -/
def packRows4 (κ : NodeKind) (σ : ℕ) : List Row := packHead4 κ σ ++ packWf4 κ σ

/-! ### S-E13b's node rows (WOTS, `aggPad`) and B4's aggregate checks, folded in at slot 1 -/

/-- S-E13b's node rows and B4's check rows per kind (`W4.xRowsA`), closed constants (built once per process). -/
def xRowsN2 : List Row := W4.xRowsA .N2
def xRowsN4 : List Row := W4.xRowsA .N4
def xRowsN8 : List Row := W4.xRowsA .N8

/-- The node rows of kind `κ`, read off the closed constants. -/
def xRowsK : NodeKind → List Row
  | .N2 => xRowsN2
  | .N4 => xRowsN4
  | .N8 => xRowsN8

theorem xRowsK_eq (κ : NodeKind) : xRowsK κ = W4.xRowsA κ := by cases κ <;> rfl

/-- A row's cells are below `b`. -/
def rowCellsLt (b : ℕ) (r : Row) : Bool := (r.a ++ r.b ++ r.c).all fun t => decide (t.1 < b)

/-- **The node rows' cell check** (run once per process on the closed constants, like
`ProtoFit`): every cell below the end of the slots' M cells. -/
def xOkOf (κ : NodeKind) (rs : List Row) : Bool := rs.all (rowCellsLt (κ.oneCell + κ.vslots * slotM4))

def xOkN2 : Bool := xOkOf .N2 xRowsN2
def xOkN4 : Bool := xOkOf .N4 xRowsN4
def xOkN8 : Bool := xOkOf .N8 xRowsN8

/-- The check's result per kind. -/
def xOkK : NodeKind → Bool
  | .N2 => xOkN2
  | .N4 => xOkN4
  | .N8 => xOkN8

theorem xOkK_eq (κ : NodeKind) : xOkK κ = xOkOf κ (xRowsK κ) := by cases κ <;> rfl

/-- The rejecting row `one · one = 0`. -/
def rejR (κ : NodeKind) : Row := ⟨Lin.cell κ.oneCell, Lin.cell κ.oneCell, []⟩

/-- **S-E13b's node rows at slot 1** (`W4.extRows4`), if their cells check; the rejecting row
otherwise (never in practice). -/
def extRowsC (κ : NodeKind) (σ : ℕ) : List Row :=
  if σ = 1 then (if xOkK κ then xRowsK κ else [rejR κ]) else []

/-- **Slot `σ`'s link rows**: S-E12c's, the pack rows, then S-E13b's node rows (slot 1). -/
def linkRows4 (κ : NodeKind) (σ : ℕ) : List Row := linkRowsB4 κ σ ++ packRows4 κ σ ++ extRowsC κ σ

/-- **The link region**: a slot region's last `2^15` rows. -/
def linkN : ℕ := 2 ^ 15

/-- Slot `σ`'s link rows, from the start of its link region. -/
def linkIRows4 (κ : NodeKind) (σ : ℕ) : List (ℕ × Row) :=
  (linkRows4 κ σ).zipIdx.map fun p => (σ * slotM4 + slotM4 - linkN + p.2, p.1)

/-! ## The rows' fit -/

/-- A cell of region `π`. -/
def inSB (π c : ℕ) : Bool := decide (π * slotM4 ≤ c) && decide (c < π * slotM4 + slotM4)
/-- A form over region `π`'s cells. -/
def linInB (π : ℕ) (l : Lin) : Bool := l.all fun t => inSB π t.1
/-- A row index of region `π`, below its link region. -/
def idxInB (π r : ℕ) : Bool := decide (π * slotM4 ≤ r) && decide (r + linkN < π * slotM4 + slotM4)

/-- **Rows of region `π`**: indices below its link region, every cell of every matrix in it. -/
def InSlot (π : ℕ) (rows : List (ℕ × Row)) : Prop :=
  ∀ p ∈ rows, (π * slotM4 ≤ p.1 ∧ p.1 + linkN < π * slotM4 + slotM4) ∧
    ∀ s : Mat, ∀ t ∈ s.r p.2, π * slotM4 ≤ t.1 ∧ t.1 < π * slotM4 + slotM4

/-- **The prototypes fit**: each prototype's rows lie in its region, below its link region, with
distinct indices. -/
def ProtoFit : Prop := ∀ π ≤ 1, InSlot π (protoRows π) ∧ ((protoRows π).map Prod.fst).Nodup

/-! ## The arena rows (track ASK-P): arena₁, the node's template rows, the bits

Every slot region holds, above its prototype's rows and below its link region (B2″'s placement,
`FRNodeRows4ArenaPlace`): **arena₁** (`a1Rows4`: the slot's stream segment copied into M, rows
`[arR1, arR1 + arN)`), the **node's template rows** in the binding's range `[arR2, arR2 + arR2N)` (the
ask templates' rows of the slot's prototype, `askRowsT`: B3's `askIRows4` at `b = arR2`, moved like
the prototype), and the **bits** (`bitRows4`, rows `[arRb, arRb + arNb)`). They are folded if they fit
(`ArFit`, checked by the plan at process start like `ProtoFit`); otherwise the slot gets one
rejecting row instead (so `ArFit` follows from the statement's rows, `FRNodeRows4AskPosF`). -/

/-- **Prototype `π`'s template extension** (`FRNodeRows4Rep.Xof`, by definition). -/
def XofT (π : ℕ) : Ext := N4s.XofC π (protoLay π).ctx

/-- **The node's row generator of prototype `π`**: the ask templates' rows (B3's `AT` with these
fields is SRA's `FRNodeRsvLink.withRsv`'s): IMP's `input` template
(`inpTG`), SRA's reserve template (`rsvTG`), and ASK-T's ask generator (`askTGT`: every ask's query
and answer, `FRNodeRows4AskT`), IMPC's import classes (`impcTG`, `FRNodeRows4AskI`; `colTG` not yet
folded), IMPC2's bits and statement reads (`bitTGB`, `bitTGS`), the siblings (`sibTG`), a failing row at
every replay op the replay templates `rtC1d π` do not cover (`TG.repF`, SEG-R2) and the closure (`TG.close`: a
failing row at any import or foreign flag no class handles; `FRNodeRows4AskC`). -/
def askTG (π : ℕ) : TG :=
  let ops := (protoProg π).ops
  let Xa := N4s.XofC π ⟨fun _ => ⟨[], []⟩, (protoLay π).cb⟩
  let pv := provLT 0 ops
  let T := bitTab ops (if π = 0 then nodeGrp else segGrp)
  ((((askTGT (XofT π) π).add (inpTG (XofT π) π)).add (rsvTG (XofT π) π)).add
    (impcTG (XofT π) π pv) |>.addD (bitTGB Xa π T) |>.addD (bitTGS Xa π T) |>.addE (sibTG Xa π T)
    |>.repF (N4s.rtC1d π).cov).close Xa pv T (bitNxAll 0 ops)

/-- **Prototype `π`'s template rows** (its frame), along its compile's trail (`askRowsP`'s fold). -/
def askRowsT (π : ℕ) : List Row :=
  trailRows (XofT π) (protoP π) (askTG π) (CS.init (baseR π)) none 0 (protoProg π).ops

/-- **Prototype `π`'s template rows, indexed**: rows `π·2^20 + arR2 + k` (the binding's range). -/
def askPI (π : ℕ) : List (ℕ × Row) := (askRowsT π).zipIdx.map fun p => (π * slotM4 + arR2 + p.2, p.1)

/-- **The arena rows fit** (both prototypes): the prototype's rows below the binding's range, the
template rows inside it (at most `arR2N`) with their cells in the region. -/
def ArFit : Prop :=
  ∀ π ≤ 1, (∀ p ∈ protoRows π, p.1 < π * slotM4 + arR2) ∧ (askRowsT π).length ≤ arR2N ∧ InSlot π (askPI π)

/-- **Slot `σ`'s stream block** (`packB`'s: its segment's first H block). -/
def slotB0 (κ : NodeKind) (σ : ℕ) : ℕ :=
  if isPrevSlot κ σ then N4c.chBase κ 0 else N4c.chBase κ (N4c.aggChild κ (aggSlot κ σ)) + subIx κ σ * N4c.sBlk

theorem packB_b0 (κ : NodeKind) (σ : ℕ) : (packB κ σ).map Prod.fst = some (slotB0 κ σ) := by
  unfold packB slotB0; split_ifs <;> rfl

/-- The row index of slot `σ`'s rejecting arena row (its region's last row: the link rows end before it). -/
def arRej (σ : ℕ) : ℕ := σ * slotM4 + slotM4 - 1

/-- **Slot `σ`'s arena rows** (absolute cells): arena₁ of its stream, its prototype's template rows
moved (`askPI`), its bits; one rejecting row if they do not fit. -/
noncomputable def arIRows4 (κ : NodeKind) (σ : ℕ) : List (ℕ × Row) :=
  open Classical in
  if ArFit then a1Rows4 κ σ (slotB0 κ σ) ++ absRows4 κ (mvRows (protoOf κ σ) σ (askPI (protoOf κ σ))) ++
    bitRows4 κ σ
  else [(arRej σ, rejR κ)]

/-! ## The replay rows (track REPF)

The previous node's ops `shiftTarget`, `linkWAll`, `rsWeight`, `targetS`, `evalL` (prototype 0) are replayed
by C1/R3/C1b's templates `rtN0c`, the segment's `linkWAll`, `evalM`, `evalL`, `rsWeight`, `targetS`,
`shiftTarget` (prototype 1) by SEG-R1's `rtSeg1` (`rtC1d`, `FRNodeRows4SegD`): slot `v`'s rows
`repIRowsW rtC1d κ v`, slot 0's (`N2`, `N4`) in the spare region `κ.vslots` (rows and locals), a segment
slot's in its own region (SEG-R2: rows in band B `[repSegB, 2^20 − 2^15)` then band A `[repA, arR2)`,
locals in the free cell bands, `segCell`). They are folded if they fit (**`RepFit`**, checked by the plan
at process start); otherwise one rejecting row at the spare region's first row. -/

/-- A replay row's cell fits its prototype: prototype 0's frame (region 0) or its locals' block
(`[repB, repB + 2^20)`, moved to the spare region); prototype 1's frame (region 1) or its locals' block
(`[repB, repB + segCap)`, into its region's free cell bands, SEG-R2). -/
def repCellOk (π c : ℕ) : Bool :=
  if π = 0 then decide (c < slotM4) || (decide (N4s.repB ≤ c) && decide (c < N4s.repB + slotM4))
  else inSB 1 c || (decide (N4s.repB ≤ c) && decide (c < N4s.repB + N4s.segCap))

/-- Prototype `π`'s replay rows fit: at most `2^20` (prototype 0) or `segRN` (prototype 1: bands B and
A, SEG-R2) rows, every cell fits. -/
def repFitB (π : ℕ) (rows : List Row) : Bool :=
  decide (rows.length ≤ if π = 0 then slotM4 else N4s.segRN) &&
    rows.all fun r => (r.a ++ r.b ++ r.c).all fun t => repCellOk π t.1

/-- **The replay rows fit** (both prototypes), and prototype 1's rows end below band A (SEG-R2). -/
def RepFit : Prop :=
  (∀ π ≤ 1, repFitB π (N4s.repRowsP (N4s.rtC1d π) π) = true) ∧ ∀ p ∈ protoRows 1, p.1 < slotM4 + N4s.repA

/-- **The node's replay rows** (with the arenas, `ArFit`): every slot's (`repIRowsW rtC1d`) if they
fit; else one rejecting row at slot 0's `repSegB` (free when the arenas fit). Without `ArFit` the
arena's rejecting row stands for both. -/
noncomputable def repAllRows (κ : NodeKind) : List (ℕ × Row) :=
  open Classical in
  if ArFit then
    (if RepFit then (List.range κ.vslots).flatMap (N4s.repIRowsW N4s.rtC1d κ) else [(N4s.repSegB, rejR κ)])
  else []

/-- **The rejecting rows** (`one · one = 0`): the node's M rows when `ProtoFit` fails. -/
def rejectRows (κ : NodeKind) : List (ℕ × Row) := [(0, ⟨Lin.cell κ.oneCell, Lin.cell κ.oneCell, []⟩)]

/-- **The node's M rows** (absolute): per slot, its rows, its arena rows (ASK-P) and then its link
rows (indices increase along a slot), then the replay rows (REPF, `repAllRows`); the rejecting row if the prototypes do not fit (never in practice: the plan checks
`ProtoFit` on its pieces). Not compiled (a closed term of it would be evaluated at process start):
`evalM` evaluates it from the plan (`FRNodeRows4Plan.evalMT4_eq`). -/
noncomputable def nodeIRows4 (κ : NodeKind) : List (ℕ × Row) :=
  open Classical in
  if ProtoFit then (List.range κ.vslots).flatMap (fun σ => slotRows4 κ σ ++ arIRows4 κ σ ++ linkIRows4 κ σ) ++
    repAllRows κ
  else rejectRows κ

/-- **A slot's prototype rows are the node's.** -/
theorem mem_node_slot {κ : NodeKind} {σ : ℕ} {p : ℕ × Row} (hF : ProtoFit) (hσ : σ < κ.vslots)
    (hp : p ∈ slotRows4 κ σ) : p ∈ nodeIRows4 κ := by
  rw [nodeIRows4, if_pos hF]
  exact List.mem_append_left _ (List.mem_flatMap.2 ⟨σ, List.mem_range.2 hσ, List.mem_append_left _ (List.mem_append_left _ hp)⟩)

/-- **A slot's arena rows are the node's.** -/
theorem mem_node_ar {κ : NodeKind} {σ : ℕ} {p : ℕ × Row} (hF : ProtoFit) (hσ : σ < κ.vslots)
    (hp : p ∈ arIRows4 κ σ) : p ∈ nodeIRows4 κ := by
  rw [nodeIRows4, if_pos hF]
  exact List.mem_append_left _ (List.mem_flatMap.2 ⟨σ, List.mem_range.2 hσ, List.mem_append_left _ (List.mem_append_right _ hp)⟩)

/-- **A slot's link rows are the node's.** -/
theorem mem_node_link {κ : NodeKind} {σ : ℕ} {p : ℕ × Row} (hF : ProtoFit) (hσ : σ < κ.vslots)
    (hp : p ∈ linkIRows4 κ σ) : p ∈ nodeIRows4 κ := by
  rw [nodeIRows4, if_pos hF]
  exact List.mem_append_left _ (List.mem_flatMap.2 ⟨σ, List.mem_range.2 hσ, List.mem_append_right _ hp⟩)

/-- **The replay rows are the node's** (REPF). -/
theorem mem_node_rep {κ : NodeKind} {p : ℕ × Row} (hF : ProtoFit) (hp : p ∈ repAllRows κ) : p ∈ nodeIRows4 κ := by
  rw [nodeIRows4, if_pos hF]
  exact List.mem_append_right _ hp

/-! ## L's rows -/

/-- Slot `σ`'s declared bit cells in L (A.7, as 3.x's `lBitCells`, in the slot's `2^14` stride). -/
def lBitCells4 (κ : NodeKind) (σ : ℕ) : List ℕ :=
  (List.range (266 + 399 + 7552 + 3)).map fun j => κ.lBase * 128 + σ * 2 ^ 14 + 299 + j

/-- **L's rows**: `b · (1 − b) = 0` for every declared bit of every slot, with M's `one` cell. -/
def lRows4 (κ : NodeKind) : List Row :=
  ((List.range κ.vslots).flatMap (lBitCells4 κ)).map fun b =>
    ⟨Lin.cell b, (Lin.cell κ.oneCell).sub (Lin.cell b), []⟩

/-! ## Facts and controls -/

/-- M's first cell is `3·2^logM` for every kind. -/
theorem oneCell_eq (κ : NodeKind) : κ.oneCell = 3 * 2 ^ κ.dims.logM := by cases κ <;> decide

/-- (+) `N4`'s slot 0 is the previous node, slots 1–4 copies of the segment prototype; `N8`'s eight
slots are all segment copies (its slot 0 is prototype 1 moved down). -/
theorem protoOf_ctl : protoOf .N4 0 = 0 ∧ protoOf .N4 1 = 1 ∧ protoOf .N4 4 = 1 ∧ protoOf .N8 0 = 1 :=
  ⟨rfl, rfl, rfl, rfl⟩

/-- (+) Moving region 1 to region 3 adds `2·2^20`; (−) a cell is not left in place. -/
theorem mvC_ctl : mvC 1 3 (2 ^ 20 + 5) = 3 * 2 ^ 20 + 5 ∧ mvC 1 0 (2 ^ 20 + 5) = 5 ∧
    mvC 1 3 (2 ^ 20 + 5) ≠ 2 ^ 20 + 5 := by
  simp only [mvC, slotM4]; omega

/-- (+) The selector bits lie in the slot's own L stride, inside L; (−) two slots' differ. -/
theorem selCells4_fit (κ : NodeKind) (ι : Kind) :
    selCells4 κ (κ.vslots - 1) ι < κ.lBase * 128 + κ.nL ∧ selCells4 κ 0 ι ≠ selCells4 κ 1 ι := by
  have h2 := lSlots_fit κ
  have h1 : 1 ≤ κ.vslots := by cases κ <;> decide
  have : (κ.vslots - 1) * 2 ^ 14 + 2 ^ 14 = κ.vslots * 2 ^ 14 := by
    rw [← Nat.succ_mul, Nat.succ_eq_add_one, Nat.sub_add_cancel h1]
  simp only [selCells4]
  cases ι <;> simp only [selIx] <;> omega

/-- (+) The slots' regions fill at most M: `N8`'s eight end at `N_M`. -/
theorem regions4_fit (κ : NodeKind) : κ.vslots * slotM4 ≤ κ.nM := mSlots_fit κ

theorem actRows4_length (κ : NodeKind) (σ : ℕ) : (actRows4 κ σ).length = 1 := by
  unfold actRows4; split <;> rfl

/-- (+) S-E12c's link rows: 8, and 7 for slot 0 (no `one′` row). -/
theorem linkRowsB4_length (κ : NodeKind) (σ : ℕ) :
    (linkRowsB4 κ σ).length = if σ = 0 then 7 else 8 := by
  unfold linkRowsB4; split_ifs <;> simp [Circ.kinds, actRows4_length]

/-- A slot's pack rows: `1 + 1 + 8,782` for a segment 0, `1 + 136 + 8,782` for a later sub-slot. -/
theorem packRows4_length_le (κ : NodeKind) (σ : ℕ) : (packRows4 κ σ).length ≤ 8919 := by
  unfold packRows4 packHead4 packWf4
  rcases packB κ σ with _ | ⟨b0, G⟩
  · simp
  · simp only [List.length_append, List.length_cons, headRows_length, wfRows, List.length_map, wfSeg_length]
    split_ifs <;> omega

/-- S-E13b's node rows at a slot: at most 7,904. -/
theorem extRowsC_length_le (κ : NodeKind) (σ : ℕ) : (extRowsC κ σ).length ≤ 12136 := by
  unfold extRowsC
  split_ifs with h1 h2
  · subst h1; rw [xRowsK_eq]
    have := W4.extRows4_length_le κ 1
    simpa [W4.extRows4] using this
  · simp
  · simp

/-- (+) A slot's link rows fit its link region (at most `8 + 8,919 + 12,056` of `2^15`). -/
theorem linkRows4_length_le (κ : NodeKind) (σ : ℕ) : (linkRows4 κ σ).length < linkN := by
  have h1 := linkRowsB4_length κ σ
  have h2 := packRows4_length_le κ σ
  have h3 := extRowsC_length_le κ σ
  rw [linkRows4, List.length_append, List.length_append]
  simp only [linkN]
  split_ifs at h1 <;> omega

end Rev4
end FR

end G6_FRNodeRows4

section G6_FRNodeRun4CA

-- New for `flock-recursive` (track SIB): what the compile's import and foreign flags are, read off the op
-- and whether a template took it (the closure generator's checks, `FRNodeRows4AskC.closeRows`).

/-!
# Imports and foreign flags by the op

The closure generator (`FRNodeRows4AskC.closeTG`) must know, at an op, whether the compile makes it an
import or a foreign flag, without compiling it again. Both are read off the op and the template
extension's answer, which does not depend on the template bodies:

* **`opOut_imp`**: `opOut`'s import flag is `opImp` of the op; **`opOut_foreign`**: a foreign flag only
  at a `forCap` op;
* **`tplExt4_flags`**: a template's output is neither an import nor foreign;
* **`tplExt4_isNone`**: whether a template takes an op does not depend on the template bodies;
* FEL: the same for `tplExt4A` (the `dotKF` arm aliased): **`extFl_tplExt4A`**, **`tplExt4A_isNone`**;
* hence **`stepOut_imp_of`**, **`stepOut_foreign_of`**, for any extension whose outputs are neither
  (`ExtFl`; FEL: was stated at `tplExt4`).
-/

namespace FR
namespace Rev4
open RecursionFast Circ TEval Tpl

theorem opOut_imp (P : Params) (cs : CS) (op : Op) : (opOut P cs op).imp = opImp op := by
  cases op <;> simp only [opOut, opImp] <;> (try split) <;> (try split) <;> (try split) <;> (try split) <;> rfl

theorem opForeign_eq (P : Params) (cs : CS) (op : Op) : (opOut P cs op).foreign = opForeign cs op := by
  cases op
  case assertOneHot a b c =>
    simp only [opOut, opForeign]
    cases h : ((cs.slot a).isSome && (cs.slot b).isSome && (cs.slot c).isSome) <;> simp [h]
  all_goals simp only [opOut, opForeign] <;> (repeat' split) <;> first | rfl | simp_all

theorem opOut_foreign {P : Params} {cs : CS} {op : Op} (h : (opOut P cs op).foreign = true) : forCap op = true := by
  rw [opForeign_eq] at h
  cases op <;> simp_all [opForeign, forCap]

theorem tplExt_flags {tc : TCtx} {P : Params} {cs : CS} {op : Op} {o : Out} (h : tplExt tc P cs op = some o) :
    o.imp = false ∧ o.foreign = false := by
  unfold tplExt at h
  split at h <;> (repeat' split at h) <;> simp only [Option.some.injEq, reduceCtorEq] at h <;> subst h <;>
    exact ⟨rfl, rfl⟩

theorem tplExt4_flags {F : TFilt} {R : ShR} {tc : TCtx} {P : Params} {cs : CS} {op : Op} {o : Out}
    (h : tplExt4 F R tc P cs op = some o) : o.imp = false ∧ o.foreign = false := by
  simp only [tplExt4, Ext.orElse, Option.orElse] at h
  split at h
  · rename_i o' h'
    cases h
    simp only [tplExt4S] at h'
    split at h'
    · split at h' <;> (try split at h') <;> simp only [Option.some.injEq, reduceCtorEq] at h' <;> subst h' <;>
        exact ⟨rfl, rfl⟩
    · split at h' <;> (try split at h') <;> simp only [Option.some.injEq, reduceCtorEq] at h' <;> subst h' <;>
        exact ⟨rfl, rfl⟩
    · simp only [tplExtF, Option.filter] at h'
      split at h' <;> (try split at h') <;> simp only [Option.some.injEq, reduceCtorEq] at h'
      subst h'; exact tplExt_flags (by assumption)
  · split at h
    · simp only [Ext.orElse, Option.orElse] at h
      split at h
      · rename_i o' h'
        cases h
        simp only [tplExtKM] at h'
        split at h' <;> (repeat' split at h') <;> simp only [Option.some.injEq, reduceCtorEq] at h' <;> subst h' <;>
          exact ⟨rfl, rfl⟩
      · simp only [extGetK] at h
        split at h <;> (try split at h) <;> simp only [Option.some.injEq, reduceCtorEq] at h
        subst h; exact ⟨rfl, rfl⟩
    · cases h

theorem tplExt_isNone (tp tp' : TKey → Tpl) (cb : TKey → ℕ → ℕ) (P : Params) (cs : CS) (op : Op) :
    (tplExt ⟨tp, cb⟩ P cs op).map (·.tin) = (tplExt ⟨tp', cb⟩ P cs op).map (·.tin) := by
  unfold tplExt
  split <;> (repeat' split) <;> rfl

theorem tplExt4_isNone (F : TFilt) (R : ShR) (tp tp' : TKey → Tpl) (cb : TKey → ℕ → ℕ) (P : Params) (cs : CS)
    (op : Op) : (tplExt4 F R ⟨tp, cb⟩ P cs op).isNone = (tplExt4 F R ⟨tp', cb⟩ P cs op).isNone := by
  have hF : (tplExtF F ⟨tp, cb⟩ P cs op).isNone = (tplExtF F ⟨tp', cb⟩ P cs op).isNone := by
    have h := tplExt_isNone tp tp' cb P cs op
    simp only [tplExtF]
    cases h1 : tplExt ⟨tp, cb⟩ P cs op <;> cases h2 : tplExt ⟨tp', cb⟩ P cs op <;> rw [h1, h2] at h <;>
      simp only [Option.map_none, Option.map_some, reduceCtorEq, Option.some.injEq] at h <;>
      simp only [Option.filter] <;> (try split) <;> (try split) <;> simp_all
  have hS : (tplExt4S F R ⟨tp, cb⟩ P cs op).isNone = (tplExt4S F R ⟨tp', cb⟩ P cs op).isNone := by
    simp only [tplExt4S]
    split
    · split <;> (try split) <;> rfl
    · split <;> (try split) <;> rfl
    · exact hF
  have hK : (tplExtKM F ⟨tp, cb⟩ P cs op).isNone = (tplExtKM F ⟨tp', cb⟩ P cs op).isNone := by
    simp only [tplExtKM]
    split <;> (repeat' split) <;> rfl
  simp only [tplExt4, Ext.orElse]
  rcases h1 : tplExt4S F R ⟨tp, cb⟩ P cs op with _ | a <;> rcases h2 : tplExt4S F R ⟨tp', cb⟩ P cs op with _ | b <;>
    rw [h1, h2] at hS <;> simp only [Option.isNone_none, Option.isNone_some, reduceCtorEq] at hS
  · simp only [Option.orElse]
    split
    · cases h3 : tplExtKM F ⟨tp, cb⟩ P cs op <;> cases h4 : tplExtKM F ⟨tp', cb⟩ P cs op <;>
        rw [h3, h4] at hK <;> simp_all [Option.orElse]
    · rfl
  · rfl

/-- **An extension whose outputs are neither imports nor foreign** (FEL). -/
def ExtFl (X : Ext) : Prop := ∀ P cs op o, X P cs op = some o → o.imp = false ∧ o.foreign = false

theorem extFl_tplExt4 {F : TFilt} {R : ShR} {tc : TCtx} : ExtFl (tplExt4 F R tc) :=
  fun _ _ _ _ h => tplExt4_flags h

/-- `tplExt4A`'s outputs are neither imports nor foreign. -/
theorem extFl_tplExt4A {F : TFilt} {R : ShR} {tc : TCtx} {al : ℕ → ℕ → Option (List Lin)} :
    ExtFl (tplExt4A F R tc al) := by
  intro P cs op o h
  by_cases hd : ∃ w col, op = .dotKF w col
  · obtain ⟨w, col, rfl⟩ := hd
    obtain ⟨_, _, _, _, _, h1, h2⟩ := dkA_some h
    exact ⟨h1, h2⟩
  · rw [tplExt4A_ne fun w col he => hd ⟨w, col, he⟩] at h
    exact tplExt4_flags h

/-- **Whether `tplExt4A` takes an op does not depend on the template bodies.** -/
theorem tplExt4A_isNone (F : TFilt) (R : ShR) (tp tp' : TKey → Tpl) (cb : TKey → ℕ → ℕ)
    (al : ℕ → ℕ → Option (List Lin)) (P : Params) (cs : CS) (op : Op) :
    (tplExt4A F R ⟨tp, cb⟩ al P cs op).isNone = (tplExt4A F R ⟨tp', cb⟩ al P cs op).isNone := by
  by_cases hd : ∃ w col, op = .dotKF w col
  · obtain ⟨w, col, rfl⟩ := hd
    exact dkA_isNone F tp tp' cb al P cs w col
  · rw [tplExt4A_ne fun w col he => hd ⟨w, col, he⟩, tplExt4A_ne fun w col he => hd ⟨w, col, he⟩]
    exact tplExt4_isNone F R tp tp' cb P cs op

/-- **The compile's import flag**: an `opImp` op no template took. -/
theorem stepOut_imp_of {X : Ext} (hX : ExtFl X) {P : Params} {cs : CS} {op : Op}
    (h : (stepOut X P cs op).imp = true) : opImp op = true ∧ X P cs op = none := by
  simp only [stepOut] at h
  cases hx : X P cs op with
  | none => rw [hx, Option.getD_none, opOut_imp] at h; exact ⟨h, rfl⟩
  | some o => rw [hx, Option.getD_some, (hX _ _ _ _ hx).1] at h; cases h

/-- **The compile's foreign flag**: a `forCap` op no template took, foreign in `opOut`. -/
theorem stepOut_foreign_of {X : Ext} (hX : ExtFl X) {P : Params} {cs : CS} {op : Op}
    (h : (stepOut X P cs op).foreign = true) : (opOut P cs op).foreign = true ∧ X P cs op = none := by
  simp only [stepOut] at h
  cases hx : X P cs op with
  | none => rw [hx, Option.getD_none] at h; exact ⟨h, rfl⟩
  | some o => rw [hx, Option.getD_some, (hX _ _ _ _ hx).2] at h; cases h

