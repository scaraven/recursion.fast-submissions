/-- Bit `j` of `a` (`bitF` on a natural index). -/
def bitN (a : F) (j : ℕ) : Bool :=
  if j < 64 then a.c₀.val.toNat.testBit j else a.c₁.val.toNat.testBit (j - 64)

/-- `Σ_{j : bit j of a} ns[j]`, walking the list once. -/
def rowGo (a : F) : List F → ℕ → F → F
  | [], _, acc => acc
  | n :: ns, j, acc => rowGo a ns (j + 1) (if bitN a j then F.add acc n else acc)

/-- The row `a · Minv` (computed). -/
def rowMulC (a : F) : F := rowGo a pinnedInv 0 0

/-- **`M · Minv = I`**, row by row. -/
theorem pinned_cert : ∀ u : Fin 128, rowMulC (pinnedW.getD u 0) = bitBasis u := by decide +kernel

/-- The row `a · Minv` (specification). -/
def rowMul (a : F) : F := ∑ j ∈ range 128, if bitN a j then pinnedInv.getD j 0 else 0

theorem rowGo_eq (a : F) (ns : List F) (j : ℕ) (acc : F) :
    rowGo a ns j acc = acc + ∑ i ∈ range ns.length, if bitN a (j + i) then ns.getD i 0 else 0 := by
  induction ns generalizing j acc with
  | nil => simp [rowGo]
  | cons n ns ih =>
    rw [rowGo, ih, List.length_cons, Finset.sum_range_succ']
    have e : ∀ i, j + 1 + i = j + (i + 1) := fun i ↦ by omega
    have hadd : ∀ x y : F, F.add x y = x + y := fun _ _ ↦ rfl
    simp only [e, hadd, List.getD_cons_succ, List.getD_cons_zero, add_zero]
    split_ifs <;> ring

theorem rowMulC_eq (a : F) : rowMulC a = rowMul a := by
  have hl : pinnedInv.length = 128 := rfl
  rw [rowMulC, rowGo_eq, zero_add, rowMul, hl]
  simp only [zero_add]

theorem bitN_add (a b : F) (j : ℕ) : bitN (a + b) j = (bitN a j ^^ bitN b j) := by
  have h0 : (a + b).c₀.val = a.c₀.val ^^^ b.c₀.val := rfl
  have h1 : (a + b).c₁.val = a.c₁.val ^^^ b.c₁.val := rfl
  simp only [bitN, h0, h1, UInt64.toNat_xor, Nat.testBit_xor]
  split_ifs <;> rfl

theorem rowMul_add (a b : F) : rowMul (a + b) = rowMul a + rowMul b := by
  simp only [rowMul, bitN_add, ite_xor_add, Finset.sum_add_distrib]

theorem rowMul_zero : rowMul 0 = 0 := by
  have : (0 : F) = 0 + 0 := (add_zero 0).symm
  have h := rowMul_add 0 0
  rw [← this] at h
  exact (add_eq_left.mp h.symm)

/-- `rowMul` as an additive map. -/
def rowMulHom : F →+ F := ⟨⟨rowMul, rowMul_zero⟩, rowMul_add⟩

theorem eq_pinnedW (u : Fin 128) : eq pinnedRho (cube (ℓ := 7) u) = pinnedW.getD u 0 := by
  have h := congrFun (tbl_eqTable' (List.ofFn pinnedRho) (List.length_ofFn)) (u : Fin (2 ^ 7))
  have hp : ptOf 7 (List.ofFn pinnedRho) = pinnedRho := funext fun l ↦ by
    fin_cases l <;> rfl
  rw [hp] at h
  rw [← h, tbl, ← pinnedW_eq, Array.getD_eq_getD_getElem?, List.getD_eq_getElem?_getD,
    Array.getElem?_toList]

/-- **`pinned_rank`**: A.1's two-level pinned point is good. -/
theorem pinned_rank : PinnedIndep pinnedRho := fun T hT ↦ by
  have h := congrArg rowMulHom hT
  rw [map_sum, map_zero] at h
  simp only [rowMulHom, AddMonoidHom.coe_mk, ZeroHom.coe_mk, eq_pinnedW, ← rowMulC_eq] at h
  simp only [pinned_cert] at h
  exact bitBasis_indep T h

/-! ### Negative control: points of `GF(2^64)` never pass -/

private theorem c₁_mul {a b : F} (ha : a.c₁ = 0) (hb : b.c₁ = 0) : (a * b).c₁ = 0 := by
  rw [F.mul_c₁, ha, hb, add_zero, add_zero]
  exact CharTwo.add_self_eq_zero _

/-- **`not_pinnedIndep_of_base`**: 7 points of `GF(2^64) ⊂ F` are never a good pinned point (their
128 products lie in a space of dimension 64). -/
theorem not_pinnedIndep_of_base (ρ : Fin 7 → F) (h : ∀ j, (ρ j).c₁ = 0) : ¬PinnedIndep ρ := by
  intro hρ
  have hw : ∀ u : Fin 128, (eq ρ (cube (ℓ := 7) u)).c₁ = 0 := fun u ↦ by
    rw [eq_cube]
    refine Finset.prod_induction _ (fun a : F ↦ a.c₁ = 0) (fun a b ↦ c₁_mul) rfl fun j _ ↦ ?_
    split_ifs
    · exact h j
    · change (1 : F).c₁ + (ρ j).c₁ = 0
      rw [h j]; rfl
  have hs : ∀ T : Finset (Fin 128), (∑ u ∈ T, eq ρ (cube (ℓ := 7) u)).c₁ = 0 := fun T ↦
    Finset.sum_induction _ (fun a : F ↦ a.c₁ = 0)
      (fun a b ha hb ↦ by change a.c₁ + b.c₁ = 0; rw [ha, hb]; rfl) rfl fun u _ ↦ hw u
  obtain ⟨T, T', hne, heq⟩ := Fintype.exists_ne_map_eq_of_card_lt
    (fun T : Finset (Fin 128) ↦ (⟨(∑ u ∈ T, eq ρ (cube (ℓ := 7) u)).c₀.val.toNat,
      UInt64.toNat_lt _⟩ : Fin (2 ^ 64))) (by simp [Fintype.card_finset])
  refine hne (subsetSum_injective hρ ?_)
  have h₀ : (∑ u ∈ T, eq ρ (cube (ℓ := 7) u)).c₀ = (∑ u ∈ T', eq ρ (cube (ℓ := 7) u)).c₀ := by
    have := congrArg Fin.val heq
    simp only at this
    exact congrArg B64.mk (UInt64.toNat_inj.mp this)
  change ∑ u ∈ T, eq ρ (cube (ℓ := 7) u) = ∑ u ∈ T', eq ρ (cube (ℓ := 7) u)
  rcases hT : ∑ u ∈ T, eq ρ (cube (ℓ := 7) u) with ⟨a₀, a₁⟩
  rcases hT' : ∑ u ∈ T', eq ρ (cube (ℓ := 7) u) with ⟨b₀, b₁⟩
  have e₀ := h₀; rw [hT, hT'] at e₀
  have e₁ := hs T; have e₁' := hs T'; rw [hT] at e₁; rw [hT'] at e₁'
  simp only at e₀ e₁ e₁'
  rw [e₀, e₁, e₁']

/-- Revision 2's candidate `ρ_j = x^(2^(j+3))`, `j = 1 … 7` (BP-E-R2-M3 (a)). -/
def rev2Rho (j : Fin 7) : F := F.ofB64 (B64.x ^ 2 ^ (j.val + 4))

/-- **Negative control**: revision 2's candidate fails (rank ≤ 64). -/
theorem rev2Rho_not_pinned : ¬PinnedIndep rev2Rho := not_pinnedIndep_of_base _ fun _ ↦ rfl

