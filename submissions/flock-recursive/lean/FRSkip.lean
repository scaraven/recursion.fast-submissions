-- New for `flock-recursive` (BLUEPRINT rev. 3.2 §2.3 step 2, §5.2 rows Z1–Z2, A.1, §7 `FRSkip`).
-- The interpolation lemmas follow leanerVM's `LeanerVM/Protocol/ToCompPoly/Interpolation.lean`
-- (https://github.com/Verified-zkEVM/leanerVM, stack commit `921e893f`, Apache-2.0), restated on
-- functions `Fin N → K` instead of `Vector`; the literals below are generated by
-- `probe/fr-piop/gen_skip.py two` (an independent shift-and-add reference).
import FRRingSwitch
import Mathlib.LinearAlgebra.Lagrange

/-!
# The univariate skip and the pinned zerocheck point

* **Interpolation** at `N` distinct nodes (generic field): `lagrangeWeight`, `interpolateAt`
  (computable), equal to Mathlib's `Lagrange.basis`/`interpolate` (`interpolateAt_eq`);
  `interpolateAt_eval` (a polynomial of degree `< N` is its interpolant) and
  `card_interpolateAt_eq_le` (other values interpolate to a polynomial agreeing with it at
  `≤ N − 1` points).
* **The skip set** (A.1): `ζ = x^((2^64 − 1)/255)` (`zeta_eq`, `zeta_order`), `g_i = ζ^i`
  (`gW_eq`); the 128 nodes `skipNode b = Σ_{i<7} b_i g_i` (b's bits), `S` the first 64
  (`b₆ = 0`), `Λ = S + g₆` the rest; `skipNode_injective` (so `S_disjoint_Λ`), by additivity
  (`skipNode_xor`) and a 128-case kernel check that only `b = 0` maps to `0`.
* **Row Z2** (the only univariate round): `skip_pair_bad_le` for `gen`'s form (rev. 3.8: `P^z` on
  `Λ` (64), `P^{ab}` on `Λ₀…₆₂` (63), `P^{ab}|_S = P^z|_S + P^e|_S`, at most 126 bad `λ`); `lagrangeS v l`, the degree-≤127 interpolant
  through `S ∪ Λ` at `l`; **`skip_bad_le`**: values other than a degree-≤127 polynomial's give at
  most 127 agreeing `l`; `zcMsg` (zeros on `S`, the message on `Λ`, leanerVM's `skipClaim`) with
  **`zc_skip_bad_le`** (a residual nonzero at some node of `S` leaves ≤ 127 bad `λ`) and
  `zc_skip_complete`; the honest polynomial's degree comes from `skipExt` (the 64-point
  interpolant over `S`, degree ≤ 63, `skipExt_node`).
* **Row Z1, the pinned coordinates** (DT24's fixed zerocheck): `PinnedIndep ρ` (the 128 products
  `Π_{j∈T} ρ_j Π_{j∉T} (1 + ρ_j)` are `GF(2)`-independent, i.e. `eq(ρ, ·)` on the 7-cube) and
  **`pinned_sound`**: for a `GF(2)`-valued nonzero table, fixing its low 7 variables at `ρ`
  leaves a nonzero table (no bad value; the other coordinates are `zerocheck_bad_le`'s).
  The lemmas take `ρ` as a parameter. **`pinned_rank`** certifies A.1's two-level set
  (`g_i = ζ^(2^(i−1))`, `i ≤ 3`; `y^(2^(i−4))`, `i ≥ 4`; `ρ_i = g_i/(1 + g_i)`; `pinnedRho_spec`)
  by a shipped inverse bit matrix: `pinned_cert` checks `M · Minv = I` row by row (`rowMulC`),
  and `rowMul` is additive. Negative control: **`not_pinnedIndep_of_base`** — any 7 points of
  `GF(2^64) ⊂ F` fail (128 products in a 64-dimensional space; pigeonhole), e.g. revision 2's
  candidate `rev2Rho` (BP-E-R2-M3 (a)).
-/

namespace FR

open Finset Polynomial

/-! ## Interpolation at distinct nodes -/

section Interp

variable {K : Type*} [Field K] {N : ℕ}

/-- The `i`-th Lagrange weight of the nodes `x` at `z`. -/
def lagrangeWeight (x : Fin N → K) (z : K) (i : Fin N) : K :=
  (∏ j ∈ univ.erase i, (z - x j)) * (∏ j ∈ univ.erase i, (x i - x j))⁻¹

/-- The value at `z` of the polynomial of degree `< N` taking the values `v` at the nodes `x`. -/
def interpolateAt (x v : Fin N → K) (z : K) : K := ∑ i, lagrangeWeight x z i * v i

theorem lagrangeWeight_eq (x : Fin N → K) (z : K) (i : Fin N) :
    lagrangeWeight x z i = (Lagrange.basis univ x i).eval z := by
  simp only [lagrangeWeight, Lagrange.basis, Lagrange.basisDivisor, eval_prod, eval_mul, eval_C,
    eval_sub, eval_X]
  rw [Finset.prod_mul_distrib, Finset.prod_inv_distrib, mul_comm]

theorem interpolateAt_eq (x v : Fin N → K) (z : K) :
    interpolateAt x v z = (Lagrange.interpolate univ x v).eval z := by
  simp only [interpolateAt, Lagrange.interpolate_apply, eval_finsetSum, eval_mul, eval_C,
    lagrangeWeight_eq]
  exact Finset.sum_congr rfl fun i _ ↦ mul_comm _ _

/-- At distinct nodes, a polynomial of degree `< N` is its interpolant. -/
theorem interpolateAt_eval (x : Fin N → K) (hx : Function.Injective x) (P : K[X])
    (hP : P.degree < N) (z : K) : interpolateAt x (fun j ↦ P.eval (x j)) z = P.eval z := by
  rw [interpolateAt_eq]
  congr 1
  exact (Lagrange.eq_interpolate_of_eval_eq _ hx.injOn (by simpa using hP) fun _ _ ↦ rfl).symm

/-- **Few agreements.** Values other than those of `P` (degree `< N`) interpolate to a polynomial
agreeing with `P` at `≤ N − 1` points. -/
theorem card_interpolateAt_eq_le [Fintype K] [DecidableEq K] (x : Fin N → K)
    (hx : Function.Injective x) (v : Fin N → K) (P : K[X]) (hP : P.degree < N)
    (hv : v ≠ fun j ↦ P.eval (x j)) :
    (univ.filter fun z ↦ interpolateAt x v z = P.eval z).card ≤ N - 1 := by
  set Q := Lagrange.interpolate univ x v with hQ
  have hQdeg : Q.degree < N := by
    have := Lagrange.degree_interpolate_lt (r := v) (s := univ) hx.injOn
    rwa [Finset.card_univ, Fintype.card_fin] at this
  have hne : Q - P ≠ 0 := fun h ↦ hv (funext fun j ↦ by
    have := Lagrange.eval_interpolate_at_node v (s := univ) hx.injOn (Finset.mem_univ j)
    rw [← hQ, sub_eq_zero.mp h] at this
    exact this.symm)
  have hdeg : (Q - P).natDegree ≤ N - 1 := by
    have hlt : (Q - P).degree < N := (degree_sub_le Q P).trans_lt (max_lt hQdeg hP)
    have := (natDegree_lt_iff_degree_lt hne).mpr hlt
    omega
  refine (Polynomial.card_le_degree_of_subset_roots (p := Q - P) fun z hz ↦ ?_).trans hdeg
  rw [Finset.mem_val, Finset.mem_filter] at hz
  rw [Polynomial.mem_roots hne, Polynomial.IsRoot, eval_sub, hQ, ← interpolateAt_eq, hz.2,
    sub_self]

end Interp

/-! ## The skip set (A.1) -/

/-- `ζ = x^((2^64 − 1)/255)`, of order 255 in `GF(2^64)`: a generator of `GF(2^8)`. -/
def zeta : B64 := ⟨0x0069DB4862DA3CDB⟩

theorem zeta_eq : zeta = B64.x ^ ((2 ^ 64 - 1) / 255) := by decide +kernel

/-- `ζ` has order 255 (`255 = 3 · 5 · 17`). -/
theorem zeta_order : zeta ^ 255 = 1 ∧ zeta ^ 85 ≠ 1 ∧ zeta ^ 51 ≠ 1 ∧ zeta ^ 15 ≠ 1 := by
  decide +kernel

/-- `g_i = ζ^i`, `i < 8`: the `GF(2)`-basis of `GF(2^8)` the skip set is spanned by. -/
def gW : Fin 8 → B64 := ![
  ⟨0x0000000000000001⟩,
  ⟨0x0069DB4862DA3CDB⟩,
  ⟨0x14058B9868E6E785⟩,
  ⟨0xFF054C3F7CEF0CCA⟩,
  ⟨0x0EF055B992A49DD1⟩,
  ⟨0xA1E83C9E0D85CB4F⟩,
  ⟨0x155755FFB7202002⟩,
  ⟨0x5321CDA63E06FC02⟩]

theorem gW_eq : ∀ i, gW i = zeta ^ i.val := by decide +kernel

/-- The skip node of the 7-bit index `b`: `Σ_{i<7} b_i g_i`, as an element of F. -/
def skipNode (b : Fin 128) : F := ∑ i : Fin 7, if b.val.testBit i then F.ofB64 (gW i.castSucc) else 0

private theorem ite_xor_add {p q : Bool} (a : F) :
    (if (p ^^ q) = true then a else 0) = (if p then a else 0) + if q then a else 0 := by
  cases p <;> cases q <;> simp [CharTwo.add_self_eq_zero]

/-- The node map is additive over the bits. -/
theorem skipNode_xor (a b : Fin 128) :
    skipNode ⟨a.val ^^^ b.val, Nat.xor_lt_two_pow (n := 7) a.isLt b.isLt⟩ = skipNode a + skipNode b := by
  simp only [skipNode, Nat.testBit_xor, ite_xor_add, Finset.sum_add_distrib]

theorem skipNode_eq_zero : ∀ b : Fin 128, skipNode b = 0 → b = 0 := by decide +kernel

/-- **The 128 skip nodes are distinct.** -/
theorem skipNode_injective : Function.Injective skipNode := fun a b h ↦ by
  have := skipNode_eq_zero ⟨a.val ^^^ b.val, Nat.xor_lt_two_pow (n := 7) a.isLt b.isLt⟩
    (by rw [skipNode_xor, h, CharTwo.add_self_eq_zero])
  refine Fin.ext (Nat.eq_of_testBit_eq fun i ↦ ?_)
  have hi := congrArg (fun x ↦ Nat.testBit x i) (congrArg Fin.val this)
  simpa [Nat.testBit_xor] using hi

/-- `S`: the 64 nodes with `b₆ = 0`. -/
def skipS : Finset F := univ.image fun b : Fin 64 ↦ skipNode (Fin.castLE (by norm_num) b)

/-- `Λ = S + g₆`: the 64 nodes with `b₆ = 1`. -/
def skipΛ : Finset F := univ.image fun b : Fin 64 ↦ skipNode (Fin.natAdd 64 b)

theorem S_disjoint_Λ : Disjoint skipS skipΛ := by
  rw [Finset.disjoint_left]
  intro z hS hΛ
  obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp hS
  obtain ⟨c, -, hc⟩ := Finset.mem_image.mp hΛ
  have := congrArg Fin.val (skipNode_injective hc)
  simp only [Fin.val_natAdd, Fin.val_castLE] at this
  omega

/-! ## Row Z2: the interpolant through `S ∪ Λ` -/

/-- The verifier's value at `l` of the degree-≤127 interpolant of the values `v` on `S ∪ Λ`. -/
def lagrangeS (v : Fin 128 → F) (l : F) : F := interpolateAt skipNode v l

/-- The interpolant of a degree-≤127 polynomial's values is the polynomial. -/
theorem lagrangeS_eval (P : F[X]) (hP : P.natDegree ≤ 127) (l : F) :
    lagrangeS (fun b ↦ P.eval (skipNode b)) l = P.eval l :=
  interpolateAt_eval _ skipNode_injective P
    ((degree_le_natDegree).trans_lt (by exact_mod_cast Nat.lt_succ_of_le hP)) l

/-- **`skip_bad_le` (row Z2, `127/2^128`).** Values other than those of a degree-≤127 polynomial
`P` give at most 127 challenges `l` at which the interpolant agrees with `P`. -/
theorem skip_bad_le (v : Fin 128 → F) (P : F[X]) (hP : P.natDegree ≤ 127)
    (hv : v ≠ fun b ↦ P.eval (skipNode b)) :
    (univ.filter fun l ↦ lagrangeS v l = P.eval l).card ≤ 127 :=
  card_interpolateAt_eq_le _ skipNode_injective v P
    ((degree_le_natDegree).trans_lt (by exact_mod_cast Nat.lt_succ_of_le hP)) hv

/-- The zerocheck's interpolation data: zeros on `S`, the message (`P` on `Λ`) on `Λ`. -/
def zcMsg (msg : Fin 64 → F) (b : Fin 128) : F :=
  if h : b.val < 64 then 0 else msg ⟨b.val - 64, by omega⟩

/-- **Z2 soundness.** If the honest `P` (degree ≤ 127) is nonzero at some node of `S` (the
residual's extension at `r` is nonzero there), then whatever the message, at most 127 values of
`λ` make the verifier's interpolant agree with `P`. -/
theorem zc_skip_bad_le (msg : Fin 64 → F) (P : F[X]) (hP : P.natDegree ≤ 127)
    (hS : ∃ b : Fin 128, b.val < 64 ∧ P.eval (skipNode b) ≠ 0) :
    (univ.filter fun l ↦ lagrangeS (zcMsg msg) l = P.eval l).card ≤ 127 := by
  refine skip_bad_le _ P hP fun h ↦ ?_
  obtain ⟨b, hb, hne⟩ := hS
  have := congrFun h b
  simp only [zcMsg, dite_eq_left hb] at this
  exact hne this.symm

/-- **Z2 completeness.** If `P` vanishes on `S`, the verifier's interpolant of the honest message
is `P`. -/
theorem zc_skip_complete (P : F[X]) (hP : P.natDegree ≤ 127)
    (hS : ∀ b : Fin 128, b.val < 64 → P.eval (skipNode b) = 0) (l : F) :
    lagrangeS (zcMsg fun k ↦ P.eval (skipNode (Fin.natAdd 64 k))) l = P.eval l := by
  rw [← lagrangeS_eval P hP l]
  congr 1
  funext b
  simp only [zcMsg]
  split_ifs with h
  · exact (hS b h).symm
  · congr 2
    exact Fin.ext (by simp; omega)

/-- `Λ`'s nodes. -/
abbrev lNode (k : Fin 64) : F := skipNode (Fin.natAdd 64 k)

private theorem lNode_inj : Function.Injective lNode := fun a b h ↦ by
  have := congrArg Fin.val (skipNode_injective h)
  exact Fin.ext (by simpa using this)

/-- The 127 interpolation nodes of `P^{ab}`: `S` then `Λ₀ … Λ₆₂`. -/
abbrev node127 (b : Fin 127) : F := skipNode (Fin.castLE (by norm_num) b)

private theorem node127_inj : Function.Injective node127 := fun a b h ↦ by
  have := congrArg Fin.val (skipNode_injective h)
  exact Fin.ext (by simpa using this)

/-- Z2's interpolation data (rev. 3.8): on `S`, `P^z` (interpolated from its message on `Λ`) plus
the public `P^e` (`targetS`); on `Λ₀ … Λ₆₂`, the `P^{ab}` message. -/
def z2Vals (pz : Fin 64 → F) (pab : Fin 63 → F) (pe : Fin 64 → F) (b : Fin 127) : F :=
  if h : b.val < 64 then interpolateAt lNode pz (skipNode (Fin.castLE (by norm_num) b)) + pe ⟨b.val, h⟩
  else pab ⟨b.val - 64, by omega⟩

/-- **`skip_pair_bad_le` (row Z2, 126).** With `P^{ab}*` interpolated through the 127 nodes from
`z2Vals` and `P^z*` through `Λ`: if the residual is nonzero at a node of `S`
(`P^{ab} ≠ P^z + P^e` there) or the `P^z` message is wrong, at most 126 values of `λ` make both
reconstructed values agree with the truth (`P^{ab}`, degree ≤ 126; `P^z`, degree ≤ 63). -/
theorem skip_pair_bad_le (pz : Fin 64 → F) (pab : Fin 63 → F) (pe : Fin 64 → F) (Pab Pz : F[X])
    (hab : Pab.natDegree ≤ 126) (hz : Pz.natDegree ≤ 63)
    (h : (∃ b : Fin 64, Pab.eval (skipNode (Fin.castLE (by norm_num) b)) ≠
        Pz.eval (skipNode (Fin.castLE (by norm_num) b)) + pe b) ∨ pz ≠ fun k ↦ Pz.eval (lNode k)) :
    (univ.filter fun l ↦ interpolateAt node127 (z2Vals pz pab pe) l = Pab.eval l ∧
      interpolateAt lNode pz l = Pz.eval l).card ≤ 126 := by
  have hzdeg : Pz.degree < (64 : ℕ) :=
    (degree_le_natDegree).trans_lt (by exact_mod_cast Nat.lt_succ_of_le hz)
  have habdeg : Pab.degree < (127 : ℕ) :=
    (degree_le_natDegree).trans_lt (by exact_mod_cast Nat.lt_succ_of_le hab)
  by_cases hpz : pz = fun k ↦ Pz.eval (lNode k)
  · obtain ⟨b, hb⟩ := h.resolve_right (not_not.mpr hpz)
    refine (Finset.card_le_card (t := univ.filter fun l ↦
      interpolateAt node127 (z2Vals pz pab pe) l = Pab.eval l) fun l hl ↦ ?_).trans
      (card_interpolateAt_eq_le _ node127_inj _ Pab habdeg fun hv ↦ hb ?_)
    · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hl ⊢; exact hl.1
    · have := congrFun hv (Fin.castLE (by norm_num) b)
      simp only [z2Vals, node127, Fin.castLE_castLE, Fin.val_castLE, b.isLt, dite_true, hpz,
        interpolateAt_eval _ lNode_inj Pz hzdeg, Fin.eta] at this
      exact this.symm
  · refine (Finset.card_le_card (t := univ.filter fun l ↦ interpolateAt lNode pz l = Pz.eval l)
      fun l hl ↦ ?_).trans ((card_interpolateAt_eq_le _ lNode_inj pz Pz hzdeg hpz).trans (by norm_num))
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hl ⊢; exact hl.2

/-- The quirky extension over `S` of the values `h` at its 64 nodes (degree ≤ 63). -/
noncomputable def skipExt (h : Fin 64 → F) : F[X] :=
  Lagrange.interpolate univ (fun b : Fin 64 ↦ skipNode (Fin.castLE (by norm_num) b)) h

private theorem skipS_inj : Function.Injective fun b : Fin 64 ↦
    skipNode (Fin.castLE (show 64 ≤ 128 by norm_num) b) := fun a b h ↦ by
  have := congrArg Fin.val (skipNode_injective h)
  exact Fin.ext (by simpa using this)

/-- The quirky extension evaluated by the Lagrange weights of `S` (what `lagrangeS`-style
verifier code computes). -/
theorem skipExt_eval (h : Fin 64 → F) (l : F) :
    (skipExt h).eval l = ∑ b : Fin 64,
      lagrangeWeight (fun b : Fin 64 ↦ skipNode (Fin.castLE (by norm_num) b)) l b * h b := by
  rw [← interpolateAt, interpolateAt_eq]
  rfl

theorem skipExt_natDegree (h : Fin 64 → F) : (skipExt h).natDegree ≤ 63 := by
  by_cases h0 : skipExt h = 0
  · simp [h0]
  have := Lagrange.degree_interpolate_lt (r := h) (s := univ) skipS_inj.injOn
  rw [Finset.card_univ, Fintype.card_fin] at this
  have := (natDegree_lt_iff_degree_lt h0).mpr this
  omega

theorem skipExt_node (h : Fin 64 → F) (b : Fin 64) :
    (skipExt h).eval (skipNode (Fin.castLE (by norm_num) b)) = h b :=
  Lagrange.eval_interpolate_at_node h skipS_inj.injOn (Finset.mem_univ b)

/-! ## Row Z1: the pinned coordinates -/

/-- **The pinned point is good**: the 128 values `eq(ρ, u)` on the 7-cube,
`Π_{j : u_j = 1} ρ_j Π_{j : u_j = 0} (1 + ρ_j)`, are `GF(2)`-independent. -/
def PinnedIndep (ρ : Fin 7 → F) : Prop := GF2Indep fun u : Fin 128 ↦ eq ρ (cube (ℓ := 7) u)

/-- **`pinned_sound`** (row Z1, no bad value). Fixing the low 7 variables of a `GF(2)`-valued
nonzero table at a good pinned point leaves a nonzero table. -/
theorem pinned_sound {k : ℕ} {ρ : Fin 7 → F} (hρ : PinnedIndep ρ) (e : Fin (2 ^ (7 + k)) → F)
    (hbool : ∀ u, e u = 0 ∨ e u = 1) (he : e ≠ 0) : fixLow e ρ ≠ 0 := by
  classical
  obtain ⟨w, hw⟩ : ∃ w, e w ≠ 0 := by
    by_contra h; push Not at h; exact he (funext h)
  obtain ⟨⟨u₀, v⟩, rfl⟩ := (joinEquiv 7 k).surjective w
  intro h0
  have hsum : ∑ u ∈ univ.filter fun u : Fin 128 ↦ e (join (a := 7) u v) = 1,
      eq ρ (cube (ℓ := 7) u) = 0 := by
    have := congrFun h0 v
    simp only [fixLow, Pi.zero_apply] at this
    rw [← this, Finset.sum_filter]
    refine Finset.sum_congr rfl fun u _ ↦ ?_
    rcases hbool (join u v) with h | h <;> simp [h]
  have hmem : (u₀ : Fin 128) ∈ univ.filter fun u : Fin 128 ↦ e (join (a := 7) u v) = 1 := by
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact (hbool _).resolve_left hw
  rw [hρ _ hsum] at hmem
  simp at hmem

/-! ### The certificate for A.1's two-level set -/

/-- A.1's `g₁ … g₇`: `ζ, ζ², ζ⁴` (in `GF(2^8)`), then `y, y², y⁴, y⁸`. -/
def pinnedG : Fin 7 → F := ![
  ⟨⟨0x0069DB4862DA3CDB⟩, ⟨0x0000000000000000⟩⟩,
  ⟨⟨0x14058B9868E6E785⟩, ⟨0x0000000000000000⟩⟩,
  ⟨⟨0x0EF055B992A49DD1⟩, ⟨0x0000000000000000⟩⟩,
  ⟨⟨0x0000000000000000⟩, ⟨0x0000000000000001⟩⟩,
  ⟨⟨0x8000000000000000⟩, ⟨0x0000000000000001⟩⟩,
  ⟨⟨0x400000000000005A⟩, ⟨0x0000000000000001⟩⟩,
  ⟨⟨0x300000000000115F⟩, ⟨0x0000000000000001⟩⟩]

theorem pinnedG_spec : ∀ i : Fin 7, pinnedG i =
    if i.val < 3 then F.ofB64 (zeta ^ 2 ^ i.val) else F.y ^ 2 ^ (i.val - 3) := by decide +kernel

/-- A.1's pinned coordinates `ρ_i = g_i / (1 + g_i)`. -/
def pinnedRho : Fin 7 → F := ![
  ⟨⟨0x1750B86ED7F47D09⟩, ⟨0x0000000000000000⟩⟩,
  ⟨⟨0x4BD3FE16A490DB5D⟩, ⟨0x0000000000000000⟩⟩,
  ⟨⟨0xF2A02A7051590B96⟩, ⟨0x0000000000000000⟩⟩,
  ⟨⟨0x0000000000000001⟩, ⟨0xE38E38E38E38E386⟩⟩,
  ⟨⟨0xE38E38E38E38E387⟩, ⟨0x5C25C25C25C25C22⟩⟩,
  ⟨⟨0xC2F97AC2F97AC2F3⟩, ⟨0xA8613DA8613DA86F⟩⟩,
  ⟨⟨0x498F0E08CE4F4988⟩, ⟨0xBEC0D94A342DBECF⟩⟩]

theorem pinnedRho_spec : ∀ i, pinnedRho i * (1 + pinnedG i) = pinnedG i := by decide +kernel

/-- The 128 products `eq(ρ, u)` (rows of the bit matrix `M`). -/
def pinnedW : List F := [
  ⟨⟨0xE489871698EA6E94⟩, ⟨0xD396B1518A4CB292⟩⟩,
  ⟨⟨0x40BEBF949534CC3A⟩, ⟨0x400684C7B6FB47E1⟩⟩,
  ⟨⟨0x644CEB1495FB5881⟩, ⟨0x94FF43DEF1ECE1AF⟩⟩,
  ⟨⟨0x7296B9EEF9078859⟩, ⟨0xFD380F0A8198EF98⟩⟩,
  ⟨⟨0xB0EB658BE2A9B3B3⟩, ⟨0x3913A5D830ED7400⟩⟩,
  ⟨⟨0x208CD92A3F07DBF8⟩, ⟨0xDEC9C5E86A1E12A9⟩⟩,
  ⟨⟨0x4D4604315C54BF38⟩, ⟨0xC3E67FCDDC557715⟩⟩,
